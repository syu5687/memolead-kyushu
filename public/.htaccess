# ディレクトリ一覧表示を禁止(セキュリティ対策)
Options -Indexes

# サーバー名の自動補完を無効化(Cloud Run のリダイレクトループ防止)
UseCanonicalName Off
ServerSignature Off

# ─────────────────────────────────────────
# URLリライト設定
# Cloud Run では Apache が内部で http:8080 で動いているため
# 絶対URLでリダイレクトすると http://...:8080 が返されてしまう。
# そのため、相対パスでリダイレクトする必要がある。
# ─────────────────────────────────────────
RewriteEngine On
RewriteBase /

# ① 物理ファイル(.html, .css, .js, 画像等)が存在する場合はそのまま返す
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ② ディレクトリで末尾スラッシュなしの場合、末尾スラッシュ付きへ301リダイレクト
#    Cloud Run 用に %{HTTP_HOST} を使わず、相対パスのみで指定する
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteRule ^(.+)$ /$1/ [R=301,L]

# ③ ディレクトリで末尾スラッシュありの場合、index.html を内部的に返す
#    例: /services/junk/ → /services/junk/index.html(URLは変わらない)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*)$ /$1index.html [L]

# ─────────────────────────────────────────
# 404エラーページの指定
# ─────────────────────────────────────────
ErrorDocument 404 /404.html

# ─────────────────────────────────────────
# ブラウザキャッシュ設定(表示速度向上)
# ─────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/javascript        "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# ─────────────────────────────────────────
# セキュリティヘッダ
# ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options        "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy        "strict-origin-when-cross-origin"
</IfModule>

# ─────────────────────────────────────────
# gzip圧縮(転送量削減・表示速度向上)
# ─────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>
