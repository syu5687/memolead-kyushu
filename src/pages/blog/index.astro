---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import FixedCta from '../../components/FixedCta.astro';
import { Image } from 'astro:assets';
import { posts } from '../../data/posts';

import imgOcean from '../../_assets/img/blog/blog-ocean-sky.jpg';
import imgEstate from '../../_assets/img/blog/blog-estate-water.jpg';
import imgGrave from '../../_assets/img/blog/blog-grave-leaves.jpg';

const imageMap: Record<string, ImageMetadata> = {
  'blog-ocean-sky.jpg': imgOcean,
  'blog-estate-water.jpg': imgEstate,
  'blog-grave-leaves.jpg': imgGrave,
};

// カテゴリ一覧を抽出(順序を固定)
const categoryOrder = ['すべて', '現場レポート', '豆知識', 'お知らせ'];
const allCategories = categoryOrder.filter(
  cat => cat === 'すべて' || posts.some(p => p.category === cat)
);
---

<BaseLayout
  title="ブログ・お知らせ | エンゼルセンター 仏光堂"
  description="現場レポート・豆知識・お知らせなど、葬儀後の供養に関する情報をお届けしています。遺品整理・海洋散骨・墓じまいなど、実際の現場の様子もご紹介。"
>
  <Header />
  <main>

    <div class="breadcrumb">
      <a href="/">ホーム</a><span>›</span>
      <span>ブログ・お知らせ</span>
    </div>

    <!-- PAGE HEAD -->
    <section class="page-head">
      <div class="page-head-inner fi">
        <p class="page-label">BLOG &amp; NEWS</p>
        <h1 class="page-title">ブログ・お知らせ</h1>
        <p class="page-desc">
          現場の様子やお客様の声、知って得する供養の豆知識、<br>
          お休みのお知らせなど、ぶっこうどうの最新情報をお届けします。
        </p>
      </div>
    </section>

    <!-- CATEGORY FILTER -->
    <div class="filter-wrap">
      <div class="filter-inner">
        {allCategories.map(cat => (
          <button
            class="filter-btn"
            data-filter={cat}
            data-active={cat === 'すべて' ? 'true' : 'false'}
          >{cat}</button>
        ))}
      </div>
    </div>

    <!-- POST LIST -->
    <section class="list-sec">
      <div class="list-inner">
        {posts.map(post => (
          <a
            href={`/blog/${post.slug}/`}
            class="post-row"
            data-category={post.category}
          >
            <div class="post-img">
              <Image
                src={imageMap[post.image]}
                alt={post.imageAlt}
                widths={[300, 400, 600]}
                sizes="(max-width:768px) 100vw, 280px"
                loading="lazy"
              />
            </div>
            <div class="post-body">
              <div class="post-meta">
                <span class="post-tag">{post.category}</span>
                <span class="post-date">{post.date}</span>
              </div>
              <h2 class="post-title">{post.title}</h2>
              <p class="post-excerpt">{post.excerpt}</p>
              <span class="post-link">続きを読む<span class="arrow">›</span></span>
            </div>
          </a>
        ))}
      </div>

      <p class="no-result" hidden>該当する記事はありません。</p>
    </section>

    <!-- CTA -->
    <section class="cta-sec">
      <h2 class="cta-title">お悩みがありましたら、お気軽にご相談ください</h2>
      <p class="cta-desc">記事に関するご質問や、サービス内容のご相談など、どんな小さなことでもお問い合わせください。</p>
      <p class="cta-hours">受付時間 10:00〜17:00（店休日無し）</p>
      <div class="cta-btns">
        <a href="tel:0958654400" class="cta-tel-btn"><Icon name="phone" size={18} />今すぐ電話する</a>
        <a href="/#contact" class="cta-web-btn"><Icon name="mail" size={18} />Webで相談する</a>
      </div>
    </section>

  </main>
  <Footer />

  <!-- モバイル固定CTAバー(共通コンポーネント) -->
  <FixedCta />
</BaseLayout>

<style>
  .breadcrumb{background:var(--clight);padding:.65rem 1.5rem;font-size:.78rem;color:var(--light);display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
  .breadcrumb a{color:var(--mid)}
  .breadcrumb a:hover{color:var(--gd)}

  /* PAGE HEAD */
  .page-head{padding:4rem 1.5rem 3rem;text-align:center;background:var(--white)}
  .page-head-inner{max-width:780px;margin:0 auto}
  .page-label{font-family:var(--roman);font-size:.78rem;letter-spacing:0;color:var(--gd);margin-bottom:.6rem}
  .page-title{font-family:var(--serif);font-size:clamp(1.6rem,3.5vw,2.1rem);font-weight:400;letter-spacing:.1em;margin-bottom:1.1rem}
  .page-desc{font-size:.9rem;color:var(--mid);line-height:2.05}

  /* CATEGORY FILTER */
  .filter-wrap{background:var(--clight);padding:1.25rem 1.5rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:50;backdrop-filter:blur(8px);background:rgba(250,247,243,.95)}
  .filter-inner{max-width:880px;margin:0 auto;display:flex;justify-content:center;gap:.55rem;flex-wrap:wrap}
  .filter-btn{appearance:none;border:1px solid var(--border);background:var(--white);color:var(--mid);padding:.5rem 1.25rem;font-size:.85rem;font-family:inherit;cursor:pointer;transition:.2s;border-radius:var(--corner);letter-spacing:0}
  .filter-btn:hover{border-color:var(--gd);color:var(--gd)}
  .filter-btn[data-active="true"]{background:var(--gd);border-color:var(--gd);color:#fff}

  /* POST LIST(リスト型) */
  .list-sec{padding:3.5rem 1.5rem;background:var(--white)}
  .list-inner{max-width:880px;margin:0 auto;display:flex;flex-direction:column;gap:1.85rem}

  .post-row{display:grid;grid-template-columns:280px 1fr;gap:1.75rem;padding:1.5rem;background:var(--white);border:1px solid var(--border);border-radius:var(--corner);transition:.2s;text-align:left;align-items:center}
  .post-row:hover{border-color:var(--gd);transform:translateY(-2px)}

  .post-img{width:100%;aspect-ratio:4/3;overflow:hidden;background:var(--gl);border-radius:var(--corner)}
  .post-img :global(img){width:100%;height:100%;object-fit:cover;display:block}

  .post-body{display:flex;flex-direction:column;gap:.6rem;min-width:0}
  .post-meta{display:flex;align-items:center;gap:.85rem;flex-wrap:wrap}
  .post-tag{display:inline-block;border:1px solid var(--gd);color:var(--gd);font-size:.72rem;padding:.18rem .6rem;border-radius:var(--corner);letter-spacing:0}
  .post-date{font-family:var(--roman);font-size:.78rem;color:var(--light);letter-spacing:0}
  .post-title{font-family:var(--serif);font-size:1.1rem;font-weight:400;color:var(--text);line-height:1.65;letter-spacing:.02em}
  .post-excerpt{font-size:.875rem;color:var(--mid);line-height:1.95;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .post-link{font-family:var(--roman);font-size:.85rem;color:var(--gd);letter-spacing:0;margin-top:.25rem;align-self:flex-start;font-weight:500}
  .post-link .arrow{margin-left:.35rem;display:inline-block;transition:transform .2s}
  .post-row:hover .post-link .arrow{transform:translateX(3px)}

  /* hidden 用 */
  .post-row[hidden]{display:none}
  .no-result{text-align:center;padding:3rem 1rem;color:var(--light);font-size:.9rem;max-width:880px;margin:0 auto}

  /* CTA */
  .cta-sec{background:var(--gd);color:#fff;padding:5rem 1.5rem;text-align:center}
  .cta-title{font-family:var(--serif);font-size:clamp(1.4rem,3vw,1.85rem);font-weight:400;letter-spacing:.1em;margin-bottom:1.25rem}
  .cta-desc{font-size:.9rem;opacity:.85;margin-bottom:.75rem;line-height:2}
  .cta-hours{font-size:.78rem;opacity:.7;margin-bottom:2.25rem}
  .cta-btns{display:flex;justify-content:center;gap:1rem;flex-wrap:wrap}
  .cta-tel-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;background:#fff;color:var(--gd);padding:.95rem 2.5rem;font-size:.95rem;font-family:var(--roman);letter-spacing:0;transition:.2s;border-radius:var(--corner)}
  .cta-tel-btn:hover{background:var(--gl)}
  .cta-web-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;border:1px solid rgba(255,255,255,.5);color:#fff;padding:.95rem 2.5rem;font-size:.9rem;letter-spacing:0;transition:.2s;border-radius:var(--corner)}
  .cta-web-btn:hover{background:rgba(255,255,255,.1)}


  @media(max-width:768px){
    .page-head{padding:2.75rem 1rem 2.25rem}
    .filter-inner{justify-content:flex-start;overflow-x:auto;flex-wrap:nowrap;padding-bottom:.25rem}
    .filter-btn{flex-shrink:0}
    .list-sec{padding:2.5rem 1rem}
    .post-row{grid-template-columns:1fr;gap:1.25rem;padding:1.25rem}
    .post-img{aspect-ratio:16/9}
    .cta-sec{padding:3.5rem 1rem}
    .cta-btns{flex-direction:column;align-items:stretch;max-width:320px;margin:0 auto}
  }
</style>

<script>
  // カテゴリフィルタの動作
  // ボタンをクリックすると、data-category が一致する記事だけを表示
  const buttons = document.querySelectorAll('.filter-btn');
  const rows = document.querySelectorAll('.post-row');
  const noResult = document.querySelector('.no-result') as HTMLElement | null;

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      if (!filter) return;

      // ボタンのアクティブ状態を切り替え
      buttons.forEach(b => b.setAttribute('data-active', 'false'));
      btn.setAttribute('data-active', 'true');

      // 記事の表示/非表示
      let visibleCount = 0;
      rows.forEach(row => {
        const cat = row.getAttribute('data-category');
        const show = filter === 'すべて' || cat === filter;
        if (show) {
          row.removeAttribute('hidden');
          visibleCount++;
        } else {
          row.setAttribute('hidden', '');
        }
      });

      // 結果0件メッセージの表示制御
      if (noResult) {
        if (visibleCount === 0) noResult.removeAttribute('hidden');
        else noResult.setAttribute('hidden', '');
      }
    });
  });

  // フェードインアニメーション
  const obs = new IntersectionObserver(e => {
    e.forEach(x => { if(x.isIntersecting){ x.target.classList.add('fade-in'); obs.unobserve(x.target); }});
  }, { threshold: 0.1 });
  document.querySelectorAll('.fi').forEach(el => { el.classList.add('fade-init'); obs.observe(el); });
</script>
