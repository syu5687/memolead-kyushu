---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="お探しのページが見つかりません | エンゼルセンター 仏光堂"
  description="お探しのページは移動または削除された可能性があります。"
>
  <!-- 404ページはGoogle登録不要のためnoindex指定 -->
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <Header />
  <main>
    <section class="error-section">
      <div class="error-inner">
        <p class="error-code">404</p>
        <p class="error-label">Page Not Found</p>

        <h1 class="error-title">お探しのページが<br class="sp-only">見つかりません</h1>

        <p class="error-desc">
          アクセスいただいたページは移動または削除されたか、<br>
          URLが正しくない可能性がございます。<br>
          お手数ですが、以下のリンクからお進みください。
        </p>

        <div class="error-links">
          <a href="/" class="error-btn primary">
            <span class="btn-icon"><Icon name="home" size={18} /></span>
            <span class="btn-text">トップページへ戻る</span>
          </a>
          <a href="/#services" class="error-btn">
            <span class="btn-icon"><Icon name="document" size={18} /></span>
            <span class="btn-text">サービス一覧を見る</span>
          </a>
          <a href="tel:0958654400" class="error-btn">
            <span class="btn-icon"><Icon name="phone" size={18} /></span>
            <span class="btn-text">電話で相談する</span>
          </a>
        </div>

        <div class="error-help">
          <p class="help-title">お困りの方は</p>
          <p class="help-text">
            お電話でも丁寧にご案内いたします。<br>
            お気軽にご相談ください。
          </p>
          <a href="tel:0958654400" class="help-tel">095-865-4400</a>
          <p class="help-hours">受付時間 10:00〜17:00（店休日無し）</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
.error-section{
  background:var(--clight);
  min-height:70vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:5rem 1.5rem;
  position:relative;
  overflow:hidden;
}

/* 装飾の円(背景に薄く配置) */
.error-section::before{
  content:'';
  position:absolute;
  top:-100px;
  right:-100px;
  width:400px;
  height:400px;
  border:1px solid rgba(45,90,61,.06);
  border-radius:50%;
  pointer-events:none;
}
.error-section::after{
  content:'';
  position:absolute;
  bottom:-80px;
  left:-80px;
  width:300px;
  height:300px;
  border:1px solid rgba(45,90,61,.05);
  border-radius:50%;
  pointer-events:none;
}

.error-inner{
  max-width:600px;
  margin:0 auto;
  text-align:center;
  position:relative;
  z-index:1;
}

/* 大きな404数字 */
.error-code{
  font-family:var(--num);
  font-size:clamp(5rem, 14vw, 9rem);
  font-weight:300;
  color:var(--gd);
  line-height:1;
  letter-spacing:.05em;
  opacity:.85;
}

.error-label{
  font-family:var(--roman);
  font-size:.875rem;
  letter-spacing:.3em;
  color:var(--light);
  margin-top:.25rem;
  margin-bottom:2.5rem;
}

.error-title{
  font-family:var(--serif);
  font-size:clamp(1.4rem, 3.5vw, 1.9rem);
  font-weight:400;
  letter-spacing:.1em;
  color:var(--text);
  margin-bottom:1.5rem;
  line-height:1.6;
}

.error-desc{
  font-size:.9rem;
  line-height:2.1;
  color:var(--mid);
  margin-bottom:2.75rem;
}

/* リンクボタン群 */
.error-links{
  display:flex;
  flex-direction:column;
  gap:.75rem;
  max-width:320px;
  margin:0 auto 3rem;
}

.error-btn{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:.65rem;
  padding:.95rem 1.5rem;
  background:var(--white);
  border:1px solid var(--border);
  font-size:.9rem;
  letter-spacing:.05em;
  color:var(--text);
  transition:.2s;
}

.error-btn:hover{
  border-color:var(--gd);
  background:var(--gl);
  transform:translateY(-1px);
}

.error-btn.primary{
  background:var(--gd);
  border-color:var(--gd);
  color:#fff;
}

.error-btn.primary:hover{
  background:var(--gm);
  border-color:var(--gm);
  color:#fff;
}

.btn-icon{font-size:1rem}

/* 下部の電話案内ブロック */
.error-help{
  padding-top:2.5rem;
  border-top:1px solid var(--border);
}

.help-title{
  font-family:var(--roman);
  font-size:.78rem;
  letter-spacing:.25em;
  color:var(--gd);
  margin-bottom:.85rem;
}

.help-text{
  font-size:.875rem;
  line-height:1.95;
  color:var(--mid);
  margin-bottom:1rem;
}

.help-tel{
  font-family:var(--num);
  font-size:clamp(1.5rem, 3.5vw, 2rem);
  letter-spacing:.1em;
  color:var(--gd);
  display:inline-block;
  margin-bottom:.35rem;
}

.help-hours{
  font-size:.78rem;
  color:var(--light);
  letter-spacing:.05em;
}

/* スマホ用改行制御 */
.sp-only{display:none}

@media(max-width:768px){
  .error-section{
    min-height:60vh;
    padding:3rem 1rem;
  }
  .sp-only{display:inline}
  .error-desc br{display:none}
}
</style>
