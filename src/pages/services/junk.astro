---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import FixedCta from '../../components/FixedCta.astro';
import CtaSection from '../../components/CtaSection.astro';
import { Image } from 'astro:assets';
import heroImage from '../../_assets/img/junk/hero-image.jpg';
import { getServicePricing } from '../../data/pricing';
import { SITE } from '../../data/site';
// 料金データを一元管理(src/data/pricing.ts)から取得
const junkPricing = getServicePricing('junk');
const priceRows = junkPricing?.plans ?? [];
const priceNotes = junkPricing?.notes ?? [];
// ヒーローバッジ用:最低価格(エンゼル号1台などの基本料金)
const minPrice = priceRows.length > 0 ? Math.min(...priceRows.map(p => p.price)) : 0;

const features = [
  { icon: 'lotus',    title: '供養してから処分', desc: '大切な遺品や思い出の品を、ただ捨てるのではなく、お寺様による御供養を経てから責任を持って処分いたします。' },
  { icon: 'document', title: '供養証明書を発行', desc: 'ご希望のご遺族に「供養証明書」を郵送いたします。大切な品が丁寧に処分されたという証明になります。' },
  { icon: 'tag',      title: '明確な料金体系',   desc: 'エンゼル号1台11,000円〜と明確な料金体系。少量の場合も金額等ご相談に応じます。まずはお気軽にご連絡ください。' },
  { icon: 'home',     title: '家屋の解体まで対応', desc: '不用品回収だけでなく、ハウスクリーニングや家屋の解体・整地まで幅広く対応。窓口をひとつにまとめられます。' },
];

const steps = [
  { num: 1, title: 'ご遺族のお手元に',   desc: '御葬儀代精算時、葬儀社担当者が速やかに御供養遺品収納ケースをお持参します。' },
  { num: 2, title: '名札の記入',         desc: 'ご遺族様に、名札の記入をお願いいたします。供養証明書の発行に必要です。' },
  { num: 3, title: 'パッケージ',         desc: 'ご遺族様に、ご供養したい品物を御供養袋にお入れいただきます（実用新案登録 第3154655号）。' },
  { num: 4, title: '回収・保管',         desc: 'エンゼルセンター担当者がお預かりして、所定の場所に保管いたします。' },
  { num: 5, title: '御供養（合同供養）', desc: '当社指定の寺院の僧侶により、読経・御供養をしていただきます。' },
  { num: 6, title: '輸送',               desc: '御供養終了後、都道府県知事許可の運搬作業車にて輸送いたします。' },
  { num: 7, title: '焼却（完全焼却）',   desc: '都道府県知事許可の焼却炉に委託し完全焼却します。一部位牌・人形などは当社の焼却炉にて焼却いたします。' },
  { num: 8, title: '供養証明書の発行',   desc: 'ご希望のご遺族に「供養証明書」を郵送いたします。' },
];

const items = [
  { icon: 'bag',       title: '衣類・着物・バッグ',  desc: '故人が愛用された着物・衣類・背広などを衣類供養袋にお入れいただき、専用供養祭壇にてお寺様に御供養していただきます。' },
  { icon: 'altar',     title: '仏壇・神棚',          desc: '大切にされてきた仏壇・神棚を、閉眼供養（魂抜き）のうえ、責任を持ってお焚き上げいたします。' },
  { icon: 'doll',      title: '人形・ぬいぐるみ',    desc: '魂が宿るとされる人形・ぬいぐるみ・節句人形などを丁寧に供養します。供養証明書の発行も可能です。' },
  { icon: 'furniture', title: '家具・家電',          desc: 'タンス・ソファ・テーブルなど大型家具から、テレビ・冷蔵庫・洗濯機・空調機などの家電まで回収します（リサイクル料別途）。' },
  { icon: 'photo',     title: '写真・思い出の品',    desc: '故人が大切にしていた写真・位牌・置物・剥製なども丁寧に御供養したうえで処分いたします。' },
  { icon: 'home',      title: 'その他不用品全般',    desc: '日用品・雑貨・書籍など、処分に困っているものはなんでもご相談ください。お布団の引き取りも可能です（有料1枚550円）。' },
];

const angelSet = [
  { badge: '標準セット', name: '衣類供養袋',     size: '大きさ：350 × 650 × 240 mm',  desc: '故人が愛用された着物・衣類・背広などをお入れください。専用供養祭壇にてお寺様に御供養していただきます。ご希望があれば、御供養終了後に供養証明書を発行・郵送いたします。' },
  { badge: '大型用',     name: '予備供養袋',     size: '大きさ：900 × 450 × 450 mm',  desc: '「衣類供養袋」に入りきれない品をお入れください。燃やせるもの・燃やせないもの混在可。リサイクル家電・生物を入れるのはご遠慮ください。' },
  { badge: '必須',       name: '供養袋名札 2枚', size: '各供養袋に取り付けてください', desc: '各供養袋にお名前等をご記入の上、取り付けてください。供養証明書が必要な方は名札の最後の列の「供養証明書の要」に忘れずに○印をお付けください。' },
];


const areas = [
  { name: '長崎市', permit: '一般廃棄物収集運搬許可<br>長崎市 第471号' },
  { name: '時津町', permit: '一般廃棄物収集運搬許可<br>時津 指令第15号' },
  { name: '長与町', permit: '一般廃棄物収集運搬許可<br>長与 一廃許可65号' },
];
---

<BaseLayout
  title={`不用品回収 | ${SITE.fullName}`}
  description="遺品・不用品の回収、仏壇・神棚・人形などのお焚き上げ、ハウスクリーニング、家屋の解体まで。エンゼル号1台11,000円〜。長崎市・時津町・長与町対応。"
>
  <Header />
  <main>

    <section class="page-hero">
      <div class="hero-bg">
        <Image
          src={heroImage}
          alt={`不用品回収 - ${SITE.fullName}`}
          widths={[800, 1200, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          class="hero-img"
        />
      </div>
      <div class="hero-overlay"></div>
      <div class="breadcrumb">
        <a href="/">ホーム</a><span>›</span>
        <a href="/#services">サービス一覧</a><span>›</span>
        <span>不用品回収</span>
      </div>
      <div class="page-hero-inner">
        <p class="page-hero-label">SERVICE 02 — Unwanted Items Removal</p>
        <h1 class="page-hero-title">不用品回収</h1>
        <p class="page-hero-desc">
          遺品の整理から日常の片付けまで、家具・家電・衣類・仏壇など<br>
          処分に困っているものをまとめて回収します。<br>
          仏壇・神棚・人形などは心を込めてお焚き上げいたします。
        </p>
        <div class="page-hero-badge">
          <Icon name="tag" size={16} />
          <span>エンゼル号 1台 <strong style="font-family:var(--num);font-size:1.1rem">{minPrice.toLocaleString('ja-JP')}円〜</strong>（税込）</span>
        </div>
      </div>
    </section>

    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">FEATURES</p>
          <h2 class="sec-title">選ばれる4つの理由</h2>
        </div>
        <div class="features fi">
          {features.map(f => (
            <div class="feature">
              <div class="feature-icon"><Icon name={f.icon} size={28} /></div>
              <h3 class="feature-title">{f.title}</h3>
              <p class="feature-desc">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="price-hero fi">
      <div class="price-hero-inner">
        <p class="price-hero-label">ANGEL 号（エンゼル号）</p>
        <p class="price-hero-name">遺品・不用品回収車</p>
        <div class="price-big">¥11,000<span class="price-unit">〜（税込）</span></div>
        <p style="font-size:.875rem;opacity:.85">トラックがご自宅横付けの場合 / 1台あたり</p>
        <ul class="price-notes">
          <li>停車場所からご自宅まで距離がある場合、人件費をいただく場合があります</li>
          <li>リサイクル料金・人件費等の別途料金が発生する場合があります</li>
          <li>少量の回収品においては、金額等ご相談に応じます</li>
          <li>生ゴミについてはご遠慮ください</li>
          <li>「不要品」については【当日処分】となります</li>
        </ul>
      </div>
    </div>

    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">PROCESS</p>
          <h2 class="sec-title">遺品御供養サービスの流れ</h2>
          <p class="sec-desc">ご葬儀終了後から供養証明書の発行まで、8つのステップで丁寧に対応いたします。</p>
        </div>
        <div class="steps-grid fi">
          {steps.map(s => (
            <div class="step">
              <div class="step-num">{s.num}</div>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-desc">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">ITEMS</p>
          <h2 class="sec-title">回収・お焚き上げ対応品目</h2>
          <p class="sec-desc">大切なものだから、ただ処分するのではなく、心を込めた御供養のあとに処分いたします。</p>
        </div>
        <div class="items-grid fi">
          {items.map(it => (
            <div class="item-card">
              <div class="item-icon"><Icon name={it.icon} size={24} /></div>
              <div>
                <h3 class="item-title">{it.title}</h3>
                <p class="item-desc">{it.desc}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="note-block" style="margin-top:1.5rem">
          ※お焚き上げ品によっては、燃納出来ない場合がございます。その場合はご供養後、法条例などに基づいた処理をさせていただきます。<br>
          ※リサイクル家電（テレビ・冷蔵庫・洗濯機・空調機）を入れるのはご遠慮ください。
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">ANGEL SET</p>
          <h2 class="sec-title">エンゼルセットのご利用について</h2>
          <p class="sec-desc">御葬儀の際にお渡しする専用の供養袋セットです。ご供養したい品物をお入れください。</p>
        </div>
        <div class="angel-set fi">
          {angelSet.map(set => (
            <div class="set-card">
              <span class="set-badge">{set.badge}</span>
              <h3 class="set-name">{set.name}</h3>
              <p class="set-size">{set.size}</p>
              <p class="set-desc">{set.desc}</p>
            </div>
          ))}
        </div>
        <div class="note-block">
          上記の衣類・予備供養袋に関しましては無料で回収に伺いますので、お気軽にエンゼルセンターまでご連絡ください。<br>
          ※供養袋回収後、遺品返還の希望がありましたら、1週間以内にご連絡ください。1・3・5・7・9・11月の10日前後に執り行われる供養祭終了後は供養品のご返却は出来かねますのでご了承ください。
        </div>
      </div>
    </section>

    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">PRICE</p>
          <h2 class="sec-title">料金表</h2>
          <p class="sec-desc">明確な料金体系で、いきなり高額な請求はありません。まず仮見積りをご利用ください。</p>
        </div>
        <div class="fi" style="overflow-x:auto">
          <table class="price-table">
            <thead>
              <tr>
                <th style="width:40%">サービス内容</th>
                <th style="width:20%">内容</th>
                <th style="width:30%">料金（税込）</th>
                <th style="width:10%">人気</th>
              </tr>
            </thead>
            <tbody>
              {priceRows.map(row => (
                <tr class={row.popular ? 'row-popular' : ''}>
                  <td>{row.label}</td>
                  <td class="note-cell">{row.size}</td>
                  <td class="price-cell"><strong>{row.price.toLocaleString('ja-JP')}円</strong></td>
                  <td>{row.popular && <span class="popular-badge">人気</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:.78rem;color:var(--light);margin-top:.85rem;line-height:1.9">
          {priceNotes.map((note, i) => (
            <>※{note}{i < priceNotes.length - 1 && <br />}</>
          ))}
        </p>
      </div>
    </section>

    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">SERVICE AREA</p>
          <h2 class="sec-title">回収対応エリア</h2>
          <p class="sec-desc">下記エリアにて回収のお伺いが可能です。エリア外の方もまずはご相談ください。</p>
        </div>
        <div class="area-cards fi">
          {areas.map(a => (
            <div class="area-card">
              <h3 class="area-name">{a.name}</h3>
              <p class="area-permit" set:html={a.permit}></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CtaSection
      title="まずはお気軽にご相談ください"
      desc="お見積りは無料です。「エンゼル号の件で…」とお伝えください。<br>電話一本でお取りに伺います。"
      tel="0958654400"
      hours="受付時間 10:00〜17:00（店休日無し）"
      estimateHref="/estimate/?service=junk"
      contactHref="/#contact"
    />


  </main>

  <Footer />

  <!-- モバイル固定CTAバー(共通コンポーネント) -->
  <FixedCta />
</BaseLayout>

<style>
  :root{--gold:#c8a84b}

  .breadcrumb{position:absolute;top:1.25rem;left:0;right:0;z-index:4;max-width:1100px;margin:0 auto;padding:.5rem 1.5rem;font-size:.78rem;color:rgba(255,255,255,0.7);display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
  .breadcrumb a{color:rgba(255,255,255,0.8)}
  .breadcrumb a:hover{color:#fff}
  .breadcrumb > span:last-child{color:rgba(255,255,255,0.95)}
  .breadcrumb span{opacity:.5}

  .page-hero{position:relative;min-height:480px;color:#fff;padding:5rem 1.5rem;overflow:hidden;display:flex;align-items:center;background:linear-gradient(135deg, var(--gd), var(--gm))}
  .hero-bg{position:absolute;inset:0;z-index:1}
  .hero-bg :global(.hero-img){width:100%;height:100%;object-fit:cover;object-position:center 35%;filter:saturate(0.9) sepia(0.05) brightness(0.95)}
  .hero-overlay{position:absolute;inset:0;z-index:2;background:linear-gradient(100deg,rgba(45,90,61,0.85) 0%,rgba(45,90,61,0.75) 35%,rgba(45,90,61,0.65) 60%,rgba(45,90,61,0.45) 100%)}
  .page-hero-inner{max-width:680px;width:100%;margin:0 auto 0 max(1.5rem,calc((100% - 1100px)/2));position:relative;z-index:3}
  .page-hero-label{font-family:var(--roman);font-size:.78rem;letter-spacing:0;opacity:.65;margin-bottom:.6rem}
  .page-hero-title{font-family:var(--serif);font-size:clamp(1.75rem,4vw,2.5rem);font-weight:400;letter-spacing:.1em;margin-bottom:1rem}
  .page-hero-desc{font-size:.95rem;line-height:2;opacity:.88;max-width:600px}
  .page-hero-badge{display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);padding:.5rem 1rem;font-size:.85rem;margin-top:1.25rem;backdrop-filter:blur(4px)}

  .sec{padding:5rem 1.5rem}
  .sec.bg-cream{background:var(--clight)}
  .sec.bg-gl{background:var(--gl)}
  .sec.bg-dark{background:#1e3d2a;color:#fff}
  .sec-inner{max-width:1100px;margin:0 auto}
  .sec-head{text-align:center;margin-bottom:3rem}
  .sec-label{font-family:var(--roman);font-size:.78rem;letter-spacing:0;color:var(--gd);margin-bottom:.55rem}
  .sec-label.white{color:rgba(255,255,255,.6)}
  .sec-title{font-family:var(--serif);font-size:clamp(1.4rem,3vw,1.85rem);font-weight:400;letter-spacing:.1em;margin-bottom:.8rem}
  .sec-desc{font-size:.9rem;color:var(--mid);line-height:2}
  .sec-desc.white{color:rgba(255,255,255,.75)}

  .features{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem;margin-bottom:3rem}
  .feature{background:var(--white);border:1px solid var(--border);padding:1.75rem 1.25rem;text-align:center;transition:.2s}
  .feature-icon{width:52px;height:52px;background:var(--gl);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;color:var(--gd)}
  .feature-title{font-family:var(--serif);font-size:1rem;font-weight:400;color:var(--gd);margin-bottom:.6rem}
  .feature-desc{font-size:.875rem;line-height:1.9;color:var(--mid)}

  .price-hero{background:var(--gd);padding:3rem 1.5rem;text-align:center;color:#fff}
  .price-hero-inner{max-width:800px;margin:0 auto}
  .price-hero-label{font-size:.875rem;opacity:.7;margin-bottom:.5rem;letter-spacing:0}
  .price-hero-name{font-family:var(--serif);font-size:1.5rem;font-weight:400;margin-bottom:.5rem;letter-spacing:0}
  .price-big{font-family:var(--num);font-size:clamp(3rem,8vw,5rem);font-weight:300;color:#f5c842;line-height:1;margin:.5rem 0}
  .price-unit{font-size:1rem;opacity:.85}
  .price-note{font-size:.875rem;opacity:.7;margin-top:.65rem;line-height:1.8}
  .price-notes{display:flex;flex-direction:column;gap:.35rem;margin-top:1.25rem;background:rgba(0,0,0,.2);padding:1rem 1.5rem;text-align:left}
  .price-notes li{font-size:.875rem;opacity:.85;list-style:none;padding-left:1em;position:relative}
  .price-notes li::before{content:'※';position:absolute;left:0;opacity:.6}

  .steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;counter-reset:step}
  .step{background:var(--white);border:1px solid var(--border);padding:1.5rem 1.25rem;position:relative;text-align:center}
  .step:nth-child(n+5){border-top:none}
  .steps-grid .step:nth-child(2),
  .steps-grid .step:nth-child(3),
  .steps-grid .step:nth-child(4),
  .steps-grid .step:nth-child(6),
  .steps-grid .step:nth-child(7),
  .steps-grid .step:nth-child(8){border-left:none}
  .step-num{font-family:var(--num);font-size:2.5rem;font-weight:300;color:var(--gl);line-height:1;margin-bottom:.5rem}
  .step-title{font-family:var(--serif);font-size:1rem;font-weight:400;color:var(--gd);margin-bottom:.65rem}
  .step-desc{font-size:.875rem;line-height:1.85;color:var(--mid)}
  .step-icon{font-size:1.75rem;margin-bottom:.6rem}

  .items-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}
  .item-card{background:var(--white);border:1px solid var(--border);padding:1.5rem;display:flex;gap:1rem;align-items:flex-start;transition:.2s}
  .item-icon{flex-shrink:0;width:44px;height:44px;background:var(--gl);display:flex;align-items:center;justify-content:center;color:var(--gd)}
  .item-title{font-family:var(--serif);font-size:1rem;font-weight:400;color:var(--gd);margin-bottom:.4rem}
  .item-desc{font-size:.875rem;line-height:1.85;color:var(--mid)}

  .price-table{width:100%;border-collapse:collapse;font-size:.9rem}
  .price-table th{background:var(--gd);color:#fff;padding:.75rem 1.25rem;text-align:left;font-weight:400;font-size:.875rem;letter-spacing:0}
  .price-table td{padding:.85rem 1.25rem;border-bottom:1px solid var(--border)}
  .price-table tr:last-child td{border-bottom:none}
  .price-table tr:nth-child(even) td{background:#f8f8f6}
  .price-table .price-cell{font-family:var(--num);font-size:1.1rem;font-weight:400;color:var(--gd);white-space:nowrap}
  .price-table .note-cell{font-size:.78rem;color:var(--light)}

  .area-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}
  .area-card{background:var(--white);border:1px solid var(--border);padding:1.5rem;text-align:center}
  .area-name{font-family:var(--serif);font-size:1.05rem;font-weight:400;color:var(--gd);margin-bottom:.5rem}
  .area-permit{font-size:.78rem;color:var(--light);line-height:1.8}

  .angel-set{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1.25rem;margin-bottom:1.75rem}
  .set-card{background:var(--white);border:1px solid var(--border);padding:1.5rem}
  .set-badge{display:inline-block;background:var(--gd);color:#fff;font-size:.72rem;padding:.22rem .7rem;margin-bottom:.75rem;letter-spacing:.05em}
  .set-name{font-family:var(--serif);font-size:1rem;font-weight:400;color:var(--gd);margin-bottom:.5rem}
  .set-size{font-size:.85rem;color:var(--light);margin-bottom:.6rem}
  .set-desc{font-size:.875rem;line-height:1.9;color:var(--mid)}

  .cta-sec{background:var(--gd);padding:4rem 1.5rem;text-align:center;color:#fff}
  .cta-title{font-family:var(--serif);font-size:clamp(1.3rem,3vw,1.75rem);font-weight:400;letter-spacing:.1em;margin-bottom:.75rem}
  .cta-desc{font-size:.9rem;opacity:.85;margin-bottom:2.25rem;line-height:2}
  .cta-btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
  .cta-tel-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;background:#fff;color:var(--gd);padding:.95rem 2.5rem;font-size:.95rem;font-family:var(--roman);letter-spacing:0;transition:.2s}
  .cta-tel-btn:hover{background:var(--gl)}
  .cta-web-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;border:1px solid rgba(255,255,255,.5);color:#fff;padding:.95rem 2.5rem;font-size:.9rem;letter-spacing:0;transition:.2s}
  .cta-web-btn:hover{background:rgba(255,255,255,.1)}
  .cta-tel-num{font-family:var(--num);font-size:clamp(1.75rem,4vw,2.5rem);display:block;margin-bottom:.25rem;letter-spacing:.1em}
  .cta-hours{font-size:.78rem;opacity:.7;margin-bottom:1.5rem}

  .note-block{background:#fffbf0;border-left:3px solid var(--gold);padding:1rem 1.25rem;font-size:.875rem;line-height:1.9;color:var(--mid)}
  .note-block.red{background:#fff5f5;border-left-color:#e74c3c;color:#c0392b;font-weight:500}


  @media(max-width:1024px){
    .features{grid-template-columns:repeat(2,1fr)}
    .items-grid{grid-template-columns:repeat(2,1fr)}
    .angel-set{grid-template-columns:1fr 1fr}
  }

  @media(max-width:768px){
    .breadcrumb{padding:.55rem 1rem}
    .page-hero{padding:2.25rem 1rem}
    .sec{padding:3.5rem 1rem}
    .features{grid-template-columns:1fr 1fr;gap:1rem}
    .steps-grid{grid-template-columns:1fr 1fr}
    .steps-grid .step:nth-child(2n){border-left:none}
    .steps-grid .step:nth-child(2n-1):not(:first-child){border-top:none}
    .steps-grid .step:nth-child(n+3){border-top:none}
    .items-grid{grid-template-columns:1fr}
    .area-cards{grid-template-columns:1fr}
    .angel-set{grid-template-columns:1fr}
    .price-table{font-size:.85rem}
    .price-table th,.price-table td{padding:.65rem .85rem}
    .cta-sec{padding:3rem 1rem}
    .cta-btns{flex-direction:column;align-items:center}
    .cta-tel-btn,.cta-web-btn{width:100%;max-width:320px;text-align:center}

    .fixed-cta    .fixed-cta  }

  @media(max-width:480px){
    .features{grid-template-columns:1fr}
    .steps-grid{grid-template-columns:1fr}
    .steps-grid .step{border-left:1px solid var(--border)!important;border-top:none!important}
    .steps-grid .step:first-child{border-top:1px solid var(--border)!important}
  }

  :global(body) {
    padding-bottom: 0;
  }
  @media(max-width:768px){
    :global(body) {
      padding-bottom: 52px;
    }
  }

  .fi{opacity:0;transform:translateY(16px);transition:opacity .5s,transform .5s}
  .fi.show{opacity:1;transform:none}
</style>

<script>
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('show');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: .1 });
  document.querySelectorAll('.fi').forEach(el => obs.observe(el));
</script>
