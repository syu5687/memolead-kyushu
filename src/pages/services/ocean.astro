---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import FixedCta from '../../components/FixedCta.astro';
import CtaSection from '../../components/CtaSection.astro';
import { Image } from 'astro:assets';
import heroImage from '../../_assets/img/ocean/hero-image.jpg';
import pearlImg from '../../_assets/img/ocean/pearl-memory.jpg';
import pearlFeat1 from '../../_assets/img/ocean/pearl-feature-1.jpg';
import pearlFeat2 from '../../_assets/img/ocean/pearl-feature-2.jpg';
import pearlFeat3 from '../../_assets/img/ocean/pearl-feature-3.jpg';
import ServicePageStyles from '../../components/ServicePageStyles.astro';
import { SITE,companyOf } from '../../data/site';
const company = companyOf('ocean'); 

// FEATURES: 海洋散骨が選ばれる理由（3項目）
const features = [
  { icon: 'home',     title: '本人とご家族の想いに寄り添う', desc: '「海が好きだった」「自然に還りたい」という故人様の想い、それを叶えたいというご家族の願い。宗教や形式にとらわれず、その人らしいお見送りを大切にできる供養です。' },
  { icon: 'tree',     title: 'どこにいても故人を偲べる',     desc: '特定の場所に縛られず、広い海そのものが故人様の眠る場所に。旅行先や近くの海辺など、どこにいても手を合わせられます。遠方でお墓参りが難しい方にも選ばれています。' },
  { icon: 'document', title: '承継や管理の負担を軽くする',   desc: '「お墓を継ぐ人がいない」「管理の負担を残したくない」。海洋散骨は維持管理が不要で、墓石の建立費や年間管理費もかかりません。心と費用の両面で負担を抑えられます。' },
];

// PLANS: 選べる4つのプラン
const plans = [
  { icon: 'home',  title: 'チャーター散骨プラン',            desc: 'ご家族・ご親族だけで船を貸し切り、周囲を気にせずゆっくりとお見送りいただけます。日時・乗船人数を自由に設定可能（1〜8名様乗船／追加乗船料あり）。費用264,000円〜（税込）。' },
  { icon: 'tree',  title: '合同散骨プラン',                  desc: '指定日に他のご家族と乗り合いで行う合同プラン。費用を抑えつつ、丁寧なセレモニーでお見送りいただけます（1〜2名様乗船／最大4名まで追加可）。費用187,000円〜（税込）。' },
  { icon: 'box',   title: '代行散骨プラン',                  desc: 'ご乗船されず、当社スタッフが心を込めて代行して散骨いたします。後日、散骨証明書とお写真をお届け。粉骨も含みます。費用77,000円〜（税込・ご遺骨1柱につき）。' },
  { icon: 'lotus', title: '真珠散骨プラン（Pearl Memory）',  desc: '代行散骨と、ご遺骨から真珠をつくる手元供養「Pearl Memory」を組み合わせた特別プラン。海へ還しつつ、お手元にも故人様を残せます。費用440,000円〜（税込・ご遺骨1柱につき）。' },
];

// PEARL MEMORY （文言は自社向けリライト）
const pearlFeatures = [
  {
    img: pearlFeat1,
    imgAlt: 'ご遺骨から生まれた真珠のペンダント',
    title: 'たった1gのご遺骨から、その人だけの真珠を',
    desc: 'Pearl Memory づくりに必要なご遺骨は、わずか約1g。分骨の一部など、お手元に残る少量のご遺骨からでも安全におつくりできます。お預かりしたご遺骨を母貝に託し、豊かな海でじっくりと育てることで、約1年後には8mm以上の美しい輝きをもつ真珠が生まれます。',
  },
  {
    img: pearlFeat2,
    imgAlt: '真珠を育てる海の養殖いかだ',
    title: 'すべての工程を国内で、安心してお預けいただけます',
    desc: '真珠が生まれるまでの工程は、すべて日本国内で行います。ご遺骨を納める真珠核にはICチップを内蔵し、トレーサビリティ（追跡管理）を徹底。かけがえのないご遺骨が、確実にご家族のもとへ戻るよう、一つひとつ丁寧に管理しています。',
  },
  {
    img: pearlFeat3,
    imgAlt: 'ご自宅へ届いた真珠を手にする様子',
    title: '郵送だけで受付。全国どこからでもお申し込みいただけます',
    desc: '大切な方を亡くされたあとは、心も体も大きな負担を抱えています。Pearl Memory はお申し込みからお受け取りまで郵送で完結し、ご自宅で穏やかにお待ちいただけます。お申し込み前のご不安は、お電話やオンラインで何度でもご相談いただけます。',
  },
];

// PROCESS: ご利用までの流れ（8ステップ）
const steps = [
  { num: 1, title: 'お問い合わせ',           desc: 'まずはお問い合わせフォーム、またはお電話にてお気軽にご連絡ください。' },
  { num: 2, title: 'ご相談・お見積もり',     desc: 'ご希望のエリアやご要望をお伺いし、最適なプランとお見積もりをご提案します。ご不安な点も何なりとご相談ください。' },
  { num: 3, title: 'ご予約・ご契約',         desc: 'プランが決まりましたらお申込みを承ります。あわせて火葬許可証・死亡届など、必要書類の写しをお預かりします。' },
  { num: 4, title: 'お支払い・ご遺骨の発送', desc: '請求書をお送りします。お支払い後、当社指定の方法でご遺骨をお送りください。' },
  { num: 5, title: 'ご遺骨の粉末化',         desc: 'ご遺骨から混入物を取り除き、法令に基づいて粉末化します。必要に応じて洗浄・乾燥などの処置も行います。（別途立会料金が発生いたします）。' },
  { num: 6, title: '前日までのご準備',       desc: '乗船プランは出航場所・時間をご連絡します。献花・献酒などもご用意いただけます。天候により延期する場合があります。出航可否は散骨予定日の数日前～前日にご連絡いたします。（※代行散骨は、延期の場合のみご連絡いたします）' },
  { num: 7, title: '散骨当日',               desc: '乗船プランはセレモニーで丁寧にお見送り。代行プランはスタッフが心を込めて代行いたします。乗船プランの場合には、当日時間までに指定場所にお集まりください。' },
  { num: 8, title: '散骨終了後',             desc: '後日、散骨日時・海域を記した散骨証明書と、当日のお写真をお送りいたします。' },
];
---

<BaseLayout
  title={`海洋散骨 | ${SITE.fullName}`}
  description="長崎の海へ、故人を自然に還す海洋散骨。チャーター・合同・代行・真珠散骨の4プランをご用意。ご予算・ご希望に合わせて選べます。"
>
  <ServicePageStyles />
  <Header />
  <main>

    <section class="page-hero">
      <div class="hero-bg">
        <Image
          src={heroImage}
          alt={`海洋散骨 - ${SITE.fullName}`}
          widths={[800, 1200, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          class="hero-img"
        />
      </div>
      <div class="hero-overlay"></div>
      <div class="breadcrumb">
      <a href="/">ホーム</a><span>›</span>
      <a href="/#services">サービス一覧</a><span>›</span>
      <span>海洋散骨</span>
    </div>
      <div class="page-hero-inner">
        <p class="page-hero-label">SERVICE 10 — Ocean Scattering</p>
        <h1 class="page-hero-title">海洋散骨</h1>
        <p class="page-hero-catch">広い海原へ。新しいお見送りのかたち。</p>
        <p class="page-hero-desc">
          長崎の海へ、故人を自然に還す供養のかたち。<br>
          チャーター・合同・代行・真珠散骨と、<br>
          ご家族のご希望に合わせた4つのプランをご用意しています。
        </p>
        <div class="page-hero-badge">
          <Icon name="tree" size={16} />
          <span>代行散骨プラン<strong style="font-family:var(--num);font-size:1.1rem">77,000円〜</strong>（税込）</span>
        </div>
      </div>
    </section>

    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi"><p class="sec-label">FEATURES</p><h2 class="sec-title">海洋散骨の特徴</h2></div>
        <div class="features cols-3 fi">
          {features.map(f => (
            <div class="feature">
              <div class="feature-icon"><Icon name={f.icon} size={28} /></div>
              <h3 class="feature-title">{f.title}</h3>
              <p class="feature-desc">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi"><p class="sec-label">PLANS</p><h2 class="sec-title">4つのプラン</h2><p class="sec-desc">ご家族のご希望・ご予算に合わせて、4つのプランからお選びいただけます。</p></div>
        <div class="items-grid fi">
          {plans.map(p => (
            <div class="item-card">
              <div class="item-icon"><Icon name={p.icon} size={24} /></div>
              <div>
                <h3 class="item-title">{p.title}</h3>
                <p class="item-desc">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PEARL MEMORY: 真珠散骨（Pearl Memory）詳細紹介＋特長 -->
    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">PEARL MEMORY</p>
          <h2 class="sec-title">真珠散骨（Pearl Memory）とは</h2>
        </div>
        <div class="pearl-block fi">
        <div class="pearl-photo">
          <Image src={pearlImg} alt={`真珠散骨 Pearl Memory - ${SITE.fullName}`} widths={[400, 600, 800]} sizes="(max-width:768px) 100vw, 320px" loading="lazy" class="pearl-img" />
        </div>
        <div class="pearl-body">
            <p class="pearl-desc">
              大切な方のご遺骨から真珠を生み出す「Pearl Memory（パールメモリー）」。海へお還しするだけでなく、故人様の面影を真珠という形に託し、いつもおそばで偲んでいただける供養のかたちです。
            </p>
            <p class="pearl-desc">
              真珠は身につけたり、お手元で保管したり、暮らしのなかで自然に故人様を感じていただけます。海洋散骨とあわせて、「還す」と「遺す」の両方を叶える選択肢としてお選びいただけます。
            </p>
            <!-- 外部リンク。target=_blank で別タブ、rel=noopener noreferrer は別タブから元ページを操作されない/参照元を渡さないための安全対策 -->
            <a href="https://wataselica.co.jp/service/pearl-memory" class="pearl-more" target="_blank" rel="noopener noreferrer">
                  Pearl Memory の詳細はこちら（外部サイト ワタセリカへ移動します）
                </a>
              </div>
            </div>
            
            <h3 class="pearl-feat-head fi">Pearl Memory の特長</h3>
            <div class="pearl-feat-list">
          {pearlFeatures.map(f => (
            <div class="pearl-feat fi">
              <div class="pearl-feat-photo">
                <Image src={f.img} alt={f.imgAlt} widths={[400, 600, 800]} sizes="(max-width:768px) 100vw, 440px" loading="lazy" class="pearl-feat-img" />
              </div>
              <div class="pearl-feat-body">
                <h3 class="pearl-feat-title">{f.title}</h3>
                <p class="pearl-feat-desc">{f.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi"><p class="sec-label">PROCESS</p><h2 class="sec-title">散骨までの流れ</h2><p class="sec-desc">ご相談から散骨完了まで、8つのステップで丁寧に対応いたします。</p></div>
        <div class="steps-grid fi">
          {steps.map(s => (
            <div class="step">
              <div class="step-num">{s.num}</div>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-desc">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="sec-inner" style="max-width:780px">
        <div class="note-block fi">
          <strong>海洋散骨は、近年注目されている新しい供養のかたちです。</strong>
          「海が好きだった」「子や孫に負担をかけたくない」「お墓を持たない選択をしたい」など、選ばれる理由は様々。法律やガイドラインに基づいた適切な手続きで、ご家族の想いに寄り添ったお見送りをお手伝いいたします。「全部を海に還すのは抵抗がある」という方には、部分散骨もおすすめです。
        </div>
      </div>
    </section>
    <CtaSection
      title="まずはお気軽にご相談ください"
      desc="ご相談・お見積もりは無料です。「海洋散骨の件で…」とお伝えください。"
      tel={company?.tel}
      hours={`受付時間 ${company?.hours}`}
      estimateHref="/estimate/?service=ocean"
      contactHref="/#contact"
    />
  </main>
  <Footer />
  <!-- モバイル固定CTAバー(共通コンポーネント) -->
  <FixedCta />
</BaseLayout>

<style>
.pearl-block { display: flex; gap: 2rem; align-items: center; max-width: 820px; margin: 0 auto; background: var(--white); border-radius: var(--corner); padding: 2rem; }
.pearl-photo { flex: 0 0 320px; }
.pearl-img { width: 100%; height: auto; display: block; border-radius: var(--corner);aspect-ratio: 1 / 1;object-fit:cover;object-position: 70% center;}
.pearl-body { flex: 1 1 0; }
.pearl-desc { margin: 0 0 1rem; line-height: 1.9; color: var(--text); }
.pearl-more { display: inline-block; margin-top: .5rem; color: var(--gd); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
@media (max-width: 768px) {
  .pearl-block { flex-direction: column; padding: 1.25rem; }
  .pearl-photo { flex: none; width: 100%; }
}
.pearl-feat-head { max-width: 820px; margin: 3rem auto 1.5rem; text-align: center; font-size: 1.5rem; color: var(--gd); }
.pearl-feat-list { display: flex; flex-direction: column; gap: 2.5rem; }
.pearl-feat { display: flex; gap: 2rem; align-items: center; }
.pearl-feat-photo { flex: 0 0 300px; }
.pearl-feat-img { width: 100%; height: auto; display: block; border-radius: var(--corner);aspect-ratio: 1 / 1;object-fit:cover;}
.pearl-feat-body { flex: 1 1 0; }
.pearl-feat-title { margin: 0 0 1rem; font-size: 1.25rem; line-height: 1.6; color: var(--gd); }
.pearl-feat-desc { margin: 0; line-height: 1.9; color: var(--text); }
@media (max-width: 768px) {
  .pearl-feat { flex-direction: column; gap: 1rem; }
  .pearl-feat-photo { flex: none; width: 100%; }
}
</style>

<script>
const obs = new IntersectionObserver(e => { e.forEach(x => { if(x.isIntersecting){ x.target.classList.add('fade-in'); obs.unobserve(x.target); }}); }, { threshold: 0.1 });
document.querySelectorAll('.fi').forEach(el => { el.classList.add('fade-init'); obs.observe(el); });
</script>
