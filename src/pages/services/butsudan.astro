---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import FixedCta from '../../components/FixedCta.astro';
import CtaSection from '../../components/CtaSection.astro';
import { Image, getImage } from 'astro:assets';
import heroImage from '../../_assets/img/butsudan/hero-image.jpg';
import type { ImageMetadata } from 'astro'; // 画像の型（Imageに渡すため）

// 商品写真をまとめて読み込む。置き場所: src/_assets/img/butsudan/products/
// ファイルが無い商品は自動でアイコン表示に戻るので、用意できた分から差し替え可能
const productPhotos = import.meta.glob(
  '../../_assets/img/butsudan/products/**/*.{jpg,jpeg,png,webp}',
  { eager: true, import: 'default' }
) as Record<string, ImageMetadata>;

// 拡大表示（lightbox）用に、各写真の大きめWebPを事前生成しておく
// 元画像より大きくしないよう width をクランプ（「width is greater than original」エラー防止）
const fullByMetaSrc: Record<string, string> = {};
for (const img of Object.values(productPhotos)) {
  const w = Math.min(1600, img.width); // 最大1600px。元がそれより小さければ元の幅のまま
  const big = await getImage({ src: img, width: w, format: 'webp' });
  fullByMetaSrc[img.src] = big.src; // 元画像をキーに、拡大用URLを引けるようにする
}

// 指定したフォルダの中から、img（ファイル名）で写真を探す。未指定/無ければ null（=アイコン表示）
function findPhoto(folder: string, img?: string) {
  if (!img) return null;
  const key = Object.keys(productPhotos).find(p => p.endsWith(`/${folder}/${img}`));
  return key ? productPhotos[key] : null;
}
// alt用に商品名の<br>をスペースに直す（読み上げ・SEO向けの代替テキスト）
function plainName(name: string) {
  return name.replace(/<br>/g, ' ');
}

const altarTypes = [
  { banner: 'small',  icon: 'altar',    name: '小型仏壇',              desc: '省スペースでも祈りの心を。コンパクトで機能的な小型仏壇は、現代の暮らしに寄り添います。家具調タイプで部屋に自然に溶け込みます。' },
  { banner: 'modern', icon: 'box',      name: '近代仏壇',              desc: '現代の住空間に調和する、シンプルで洗練されたデザインの近代仏壇。心静かに祈る場を美しく演出します。' },
  { banner: 'karaki', icon: 'tree',     name: '近代唐木仏壇 / 唐木仏壇', desc: '銘木の風合いが美しい唐木仏壇。心安らいだお参りの空間を演出します。伝統の趣と現代の感性を融合した近代唐木仏壇も人気です。' },
  { banner: 'kinbut', icon: 'lotus',    name: '金仏壇',                desc: '伝統技法がひかる金仏壇。荘厳な輝きが、ご先祖への感謝と敬意をより深く伝えます。浄土真宗をはじめ各宗派に対応。' },
];

const compactAltars = [
  { name: 'ミラー × タモ',img: 'mi_t.png' },
  { name: 'タモ × ホワイト',img: 'tam_w.png' },
  { name: '家具調上置<br>タタン ナラ',img: 'ttn_n.png' },
  { name: '家具調上置<br>アルファ ナチュラル',img: 'alf_n.png' },
  { name: '家具調上置<br>アルファ ブラウン',img: 'alf_b.png' },
  { name: 'ティサージュ 18',img: 'tys.png' },
  { name: 'ティサージュ 18_wa',img: 'tys_wa.png' },
  { name: 'クイント 桜 18号',img: 'qu_b.png' },
  { name: 'クイント<br>ウォールナット 18号',img: 'qu_w.png' },
  { name: 'プレシャス<br>ライトダーク',img: 'pre_d.png' },
  { name: 'プレシャス ホワイト',img: 'pre_w.png' },
  { name: 'クーペ 桜',img: 'cuup.png' },
  { name: 'タタン<br>ウォールナット',img: 'ttn_w.png' },
  { name: 'サンサ14 桜',img: 'san_b.png' },
  { name: 'サンサ14<br>ウォールナット',img: 'san_w.png' },
];

const modernAltars = [
  { name: 'レクサス',img: 'lexu.png' },
  { name: 'ルメール 桜',img: 'lu_s.png' },
  { name: 'ルメール<br>ウォールナット',img: 'lu_w.png' },
  { name: 'シンシア40<br>ダークレッド',img: 'sin_dr.png' },
  { name: 'ヴィエント48 タモ',img: 'vi_t.png' },
  { name: 'ヴィエント48<br>ウォールナット',img: 'vi_w.png' },
  { name: '家具調 ソナタ 桜',img: 'sonata_sakura.png' },
  { name: '家具調 ソナタ<br>ウォールナット',img: 'sonata.png' },
];

const ihaiList = [
  { num: '① 仏光堂オリジナル', name: '紫檀 吹蓮華位牌<br>漆仕上げ',     tag: 'ORIGINAL',img: 'purple_fukirenge.png' },
  { num: '②',                   name: '蒔絵位牌<br>紫檀（透漆塗）桜',   tag: null,img: 'maki_purple.png' },
  { num: '③',                   name: '蒔絵位牌<br>紫檀 桜',           tag: null,img: 'maki_purple_sakura.png' },
  { num: '④',                   name: 'ウォールナット',                tag: null,img: 'wallnut.png' },
  { num: '⑤',                   name: 'モダン 呂色',                  tag: null,img: 'modan.png' },
  { num: '⑥',                   name: '漆仕上<br>黒檀',                tag: null,img: 'black.png' },
  { num: '⑦',                   name: '黒檀 高級位牌<br>漆仕上げ',     tag: '高級',img: 'black_high.png' },
  { num: '⑧',                   name: '上京中ワラビ足<br>吹蓮華',      tag: null,img: 'warabi.png' },
  { num: '⑨',                   name: '唐木 雲三重回<br>黒檀・紫檀',   tag: null,img: 'karaki.png' },
  { num: '⑩',                   name: '純三方金<br>雲三重回',          tag: null,img: 'sanpo.png' },
  { num: '⑪',                   name: '上塗春日',                     tag: null,img: 'kasuga.png' },
  { num: '⑫',                   name: '上塗勝美',                     tag: null,img: 'katsumi.png' },
  { num: '⑬',                   name: '紫檀 春日',                    tag: null,img: 'purple_kasuga.png' },
  { num: '⑭',                   name: '紫檀 蓮付春日',                tag: null,img: 'purple_renhasuga.png' },
  { num: '⑮',                   name: '紫檀 葵角切',                  tag: null,img: 'purple_aoi.png' },
];

const miscItems = [
  { icon: 'document', title: '過去帳',         desc: '故人の名前や命日を記す過去帳は、先祖代々のご供養に欠かせない大切な記録です。蘭・ウォールナット・鳥の子など豊富なデザインをご用意。',img: 'note.png' },
  { icon: 'altar',    title: '白木位牌',       desc: '白木の位牌はもともと野位牌といって野辺送りに必要なもので、仮の位牌です。忌明け法要には本位牌もしくは過去帳が必要となりますので、早めのご準備をお勧めします。',img: 'ihai_w.png' },
  { icon: 'lotus',    title: 'キリスト教位牌', desc: 'ご希望の位牌でキリスト教の位牌をつくることができます。オリジナル「祈念碑」（総高19.5cm）もございます。各宗派に対応いたします。',img: 'kyl.png' },
];

const tamotoItems = [
  { icon: 'lotus',  name: 'ソウルジュエリー',           desc: '遺骨・遺灰を活用したペンダントや指輪など。故人をいつも傍に感じられるジュエリーとして特別なかたちに仕上げます。' },
  { icon: 'box',    name: 'ミニ骨壺',                   desc: '小さくてかわいらしいデザインのミニ骨壺。手のひらに収まるサイズで、インテリアとしても自然に飾れます。' },
  { icon: 'photo',  name: 'メモリアルフォトフレーム',  desc: '遺骨の一部を収納できるフォトフレーム。故人の写真と共に手元で供養できる、新しいかたちの位牌です。' },
];
---

<BaseLayout
  title="仏壇・位牌・仏具販売 | メモリード 仏光堂"
  description="小型仏壇・近代仏壇・唐木仏壇・金仏壇・位牌・過去帳・手元供養品まで。大切な想いを、そっと暮らしの中に。メモリード仏光堂（長崎市幸町）"
>
  <Header />
  <main>

    <section class="page-hero">
      <div class="hero-bg">
        <Image
          src={heroImage}
          alt="仏壇・仏具販売 - エンジェルセンター ぶっこうどう"
          widths={[800, 1200, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          class="hero-img"
        />
      </div>
      <div class="hero-overlay"></div>
      <div class="breadcrumb">
        <a href="/">ホーム</a><span>›</span>
        <a href="/#services">サービス一覧</a><span>›</span>
        <span>仏壇・仏具販売</span>
      </div>
      <div class="hero-inner">
        <p class="hero-label">SERVICE 04 — Buddhist Altar & Items</p>
        <h1 class="hero-title">仏壇・位牌・仏具のご案内</h1>
        <p class="hero-catch">大切な想いを、そっと暮らしの中に。</p>
        <p class="hero-desc">小型仏壇から金仏壇・唐木仏壇まで幅広くご用意。位牌の字彫りサービスや過去帳・手元供養品なども取り揃えています。ご予算やお部屋のスタイルに合わせて、専門スタッフがご提案いたします。</p>
        <div class="hero-shop">
          <Icon name="map-pin" size={16} />
          <span>メモリード <strong>仏光堂</strong>　長崎市幸町4-13　駐車場完備</span>
        </div>
      </div>
    </section>

    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">COLLECTION</p>
          <h2 class="sec-title">仏壇の種類</h2>
          <p class="sec-desc">現代の住まいに合わせたコンパクトな小型仏壇から、伝統工芸の金仏壇・唐木仏壇まで。ご自宅のインテリアやご予算に合わせてお選びいただけます。</p>
        </div>
        <div class="type-grid fi">
          {altarTypes.map(t => (
            <div class="type-card">
              <div class={`type-banner ${t.banner}`}></div>
              <div class="type-body">
                <div class="type-icon"><Icon name={t.icon} size={28} /></div>
                <h3 class="type-name">{t.name}</h3>
                <p class="type-desc">{t.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">COMPACT ALTAR</p>
          <h2 class="sec-title">小型仏壇 ラインナップ</h2>
          <p class="sec-desc">家具調上置タイプを中心に、豊富なカラーとデザインからお選びいただけます。</p>
        </div>
        <div class="lineup-grid fi">
          {compactAltars.map(a => {
            const photo = findPhoto('compact', a.img);
            const full = photo ? fullByMetaSrc[photo.src] : null; // 拡大用URL（写真がある時だけ）
            return (
              <div class="product-card">
                <div class:list={["product-img", { "js-zoom": photo }]} data-full={full} data-title={plainName(a.name)}>
                  {photo
                    ? <Image src={photo} alt={plainName(a.name)} widths={[240, 480]} sizes="(max-width:768px) 33vw, 200px" format="webp" class="product-photo" />
                    : <Icon name="altar" size={36} />}
                </div>
                <p class="product-name" set:html={a.name}></p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">MODERN ALTAR</p>
          <h2 class="sec-title">近代仏壇 ラインナップ</h2>
          <p class="sec-desc">すっきりとした縦長デザインから家具調タイプまで、現代の住空間に馴染むラインナップ。</p>
        </div>
        <div class="lineup-grid fi" style="grid-template-columns:repeat(4,1fr)">
          {modernAltars.map(a => {
            const photo = findPhoto('modern', a.img);
            const full = photo ? fullByMetaSrc[photo.src] : null;
            return (
            <div class="product-card">
            <div class:list={["product-img", { "js-zoom": photo }]} style="background:linear-gradient(135deg,#ede0d8,#d4c4ba)" data-full={full} data-title={plainName(a.name)}>
                  {photo
                    ? <Image src={photo} alt={plainName(a.name)} widths={[240, 480]} sizes="(max-width:768px) 33vw, 220px" format="webp" class="product-photo" />
                    : <Icon name="tree" size={32} />}
                </div>
                <p class="product-name" set:html={a.name}></p>
              </div>
            );
          })}
        </div>
        <p style="text-align:center;font-size:.78rem;color:var(--light);margin-top:1.25rem">※上記のほか、近代唐木仏壇・金仏壇・唐木仏壇も取り揃えております。店頭にてご確認ください。</p>
      </div>
    </section>

    <section class="sec bg-gold">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label gold">MEMORIAL TABLET</p>
          <h2 class="sec-title">位 牌</h2>
          <p class="sec-desc">故人の魂の依り代となる位牌。豊富なラインナップからお選びいただけます。</p>
        </div>
        <div class="ihai-notice fi">
          <p>お位牌ご購入時の字彫り <strong>1名様分をサービス</strong>致します</p>
          <span>※字彫りはご注文頂いてから10日〜14日ほど必要です（お急ぎの場合はご相談に応じます）<br>
          ご来店の際は中陰表もしくは白木位牌の表裏の画像をお持ちください。</span>
        </div>
        <div class="ihai-grid fi">
          {ihaiList.map(item => {
           const photo = findPhoto('ihai', item.img);
           const full = photo ? fullByMetaSrc[photo.src] : null;
            return (
            <div class="ihai-card">
            <p class="ihai-num">{item.num}</p>
            <div class:list={["ihai-img", { "js-zoom": photo }]} data-full={full} data-title={plainName(item.name)}>
                  {photo
                    ? <Image src={photo} alt={plainName(item.name)} widths={[240, 480]} sizes="(max-width:768px) 33vw, 200px" format="webp" class="ihai-photo" />
                    : <Icon name="altar" size={32} />}
                </div>
                <p class="ihai-name" set:html={item.name}></p>
                {item.tag && <span class="ihai-tag">{item.tag}</span>}
              </div>
            );
          })}
        </div>
        <div class="note-block fi" style="margin-top:1.5rem">
          ※表示寸法と実際の寸法は手づくりの木製品のため誤差が生じる場合がございます。また、印刷の性質上実際の色とは異なる場合がございます。
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">RELATED ITEMS</p>
          <h2 class="sec-title">過去帳・その他位牌</h2>
        </div>
        <div class="misc-grid fi">
          {miscItems.map(it => {
            const photo = findPhoto('other', it.img); 
            const full = photo ? fullByMetaSrc[photo.src] : null;
            return (
            <div class="misc-card">
            <div class:list={["misc-img", { "js-zoom": photo }]} data-full={full} data-title={it.title}>
                  {photo
                    ? <Image src={photo} alt={it.title} widths={[400, 800]} sizes="(max-width:768px) 100vw, 350px" format="webp" class="misc-photo" />
                    : <Icon name={it.icon} size={32} />}
                </div>
                <div class="misc-body">
                  <h3 class="misc-title">{it.title}</h3>
                  <p class="misc-desc">{it.desc}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">MEMORIAL KEEPSAKES</p>
          <h2 class="sec-title">手元供養品</h2>
          <p class="sec-desc">手元供養は、大切な故人を身近に感じながら祈る新しい供養のかたち。暮らしの中にやさしく寄り添います。</p>
        </div>
        <div class="tamoto-grid fi">
          {tamotoItems.map(t => (
            <div class="tamoto-card">
              <div class="tamoto-icon"><Icon name={t.icon} size={28} /></div>
              <h3 class="tamoto-name">{t.name}</h3>
              <p class="tamoto-desc">{t.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">SHOP INFORMATION</p>
          <h2 class="sec-title">店舗情報</h2>
        </div>
        <div class="shop-block fi">
          <div class="shop-info">
            <span class="shop-badge">メモリードグループ</span>
            <h3 class="shop-name">仏 光 堂</h3>
            <p class="shop-name-sub">仏壇・仏具・神具専門店</p>
            <div class="shop-row">
              <span class="shop-row-label">所在地</span>
              <span class="shop-row-val">〒850-0046<br>長崎県長崎市幸町4-13</span>
            </div>
            <div class="shop-row">
              <span class="shop-row-label">TEL</span>
              <a href="tel:0958256386" class="shop-tel-big">095-825-6386</a>
            </div>
            <div class="shop-row">
              <span class="shop-row-label">FAX</span>
              <span class="shop-row-val">095-825-6395</span>
            </div>
            <div class="shop-row">
              <span class="shop-row-label">営業時間</span>
              <span class="shop-row-val">10:00〜17:00<br><small style="color:var(--gd)">店休日無し</small></span>
            </div>
            <div class="shop-row">
              <span class="shop-row-label">メール</span>
              <span class="shop-row-val" style="word-break:break-all;font-size:.78rem">bukkoudou@memolead.co.jp</span>
            </div>
            <div style="margin-top:1.25rem">
              <span style="display:inline-flex;align-items:center;gap:.4rem;background:var(--gl);color:var(--gd);font-size:.78rem;padding:.32rem .78rem;border:1px solid var(--gd)"><Icon name="parking" size={14} />駐車場完備（無料）</span>
            </div>
          </div>
          <div class="shop-map">
            <span class="shop-parking">駐車場完備</span>
            <div style="background:var(--white);border:1px solid var(--border);padding:1.5rem;width:100%;text-align:center">
              <p style="font-family:var(--serif);font-size:1rem;margin-bottom:.5rem">メモリード 仏光堂</p>
              <p style="font-size:.875rem;color:var(--mid)">長崎市幸町4-13</p>
              <p style="font-size:.78rem;color:var(--light);margin-top:.5rem">長崎スタジアムシティ近く<br>NBC長崎放送 向かい付近</p>
              <a href="https://maps.google.com/?q=長崎市幸町4-13+仏光堂" target="_blank"
                 style="display:inline-block;margin-top:1rem;background:var(--gd);color:#fff;padding:.6rem 1.3rem;font-size:.875rem;letter-spacing:.06em">
                Google マップで見る →
              </a>
            </div>
            <p style="font-size:.78rem;color:var(--mid);margin-top:.65rem;text-align:center;line-height:1.8">
              駐車場をご利用の際は弊社指定の駐車場を<br>ご利用ください。駐車券を店内でご提示いただければ無料。
            </p>
          </div>
        </div>
      </div>
    </section>

    <CtaSection
      title="店頭でゆっくりとご覧ください"
      desc="実物を見て、触れて、専門スタッフにご相談いただけます。<br>仏壇の選び方から位牌の字彫りまで、丁寧にご対応いたします。"
      sub="ご来店の際は中陰表もしくは白木位牌の表裏の画像をお持ちください"
      tel="095-825-6386"
      hours="営業時間 10:00〜17:00（店休日無し）"
      contactHref="/#contact"
    />

  </main>

  <Footer />

  <!-- モバイル固定CTAバー(共通コンポーネント) -->
  <FixedCta />
  <!-- 写真の拡大表示（lightbox） -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" aria-label="閉じる">×</button>
    <div class="lightbox-inner">
      <img class="lightbox-img" alt="">
      <p class="lightbox-title"></p>
    </div>
  </div>
</BaseLayout>

<style>
  :root{
    --brown:#6b3a2a;--brown-light:#f5ede8;
