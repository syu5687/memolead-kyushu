---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const burialTypes = [
  { icon: 'altar', title: '一般墓', desc: '従来型の墓石を建てる供養方法。先祖代々のお墓として、家族の絆を継承していくかたちです。建立費用 000,000円〜。' },
  { icon: 'box',   title: '納骨堂', desc: '屋内型の納骨施設。天候に左右されず、いつでもお参りができます。永代供養付きのものが多く、後継ぎ不要のプランも。年間費 00,000円〜。' },
  { icon: 'tree',  title: '樹木葬', desc: '墓石の代わりに樹木をシンボルとする自然葬。後継者を必要としない永代供養型が一般的です。費用 000,000円〜。' },
  { icon: 'lotus', title: '永代供養墓', desc: '霊園が責任を持って永代に供養する合祀型のお墓。お墓の継承を心配する必要がありません。費用 000,000円〜。' },
];

const features = [
  { icon: 'map-pin', title: '地元に密着したご提案',   desc: '長崎県内の主要霊園・寺院との提携により、ご希望のエリア・宗派に合った墓地をご紹介いたします。' },
  { icon: 'document', title: '見学同行サービス',      desc: '気になる霊園には、当社スタッフが同行いたします。質問・確認事項もその場で解消できます。' },
  { icon: 'tag',     title: '相見積もりサポート',     desc: '複数の霊園・石材店から見積もりを取り、比較検討のお手伝いをいたします。料金透明性を重視。' },
  { icon: 'lotus',   title: '宗派対応',               desc: '仏教各宗派・神道・無宗教まで、それぞれのご希望に合った供養のかたちをご提案いたします。' },
];

const steps = [
  { num: 1, title: 'ご希望のヒアリング', desc: 'ご予算・エリア・宗派・継承の有無など、ご希望条件を詳しくお伺いいたします。' },
  { num: 2, title: '候補のご提案',       desc: 'ご希望に合った霊園・納骨堂を複数候補としてご提案いたします。資料もお渡しいたします。' },
  { num: 3, title: '見学同行',           desc: 'ご希望の霊園に同行し、現地でご説明・質問対応をいたします。複数回の見学も可能です。' },
  { num: 4, title: 'お見積り取得',       desc: '霊園・石材店から正式お見積もりを取得。ご家族でじっくりご検討いただけます。' },
  { num: 5, title: 'ご契約・建立',       desc: 'ご契約後、墓石建立・納骨堂のご利用開始まで、当社が窓口としてサポートいたします。' },
];

const priceRows = [
  { type: '一般墓(墓石建立)',         price: '000,000円〜', note: '永代使用料含む' },
  { type: '納骨堂(個別/家族用)',     price: '000,000円〜', note: '永代供養付' },
  { type: '納骨堂(年間管理費)',      price: '00,000円〜',  note: '年額' },
  { type: '樹木葬(個別タイプ)',      price: '000,000円〜', note: '永代供養付' },
  { type: '樹木葬(合祀タイプ)',      price: '00,000円〜',  note: '一括費用のみ' },
  { type: '永代供養墓(合祀)',        price: '000,000円〜', note: '年間管理費不要' },
];
---

<BaseLayout
  title="墓地・霊園ご紹介 | エンジェルセンター ぶっこうどう"
  description="一般墓・納骨堂・樹木葬・永代供養墓まで、ご希望に合った供養のかたちをご提案いたします。長崎県内の主要霊園と提携。見学同行・相見積もりサポート。"
>
  <Header />
  <main>

    <div class="breadcrumb">
      <a href="/">ホーム</a><span>›</span>
      <a href="/#services">サービス一覧</a><span>›</span>
      <span>墓地・霊園ご紹介</span>
    </div>

    <section class="page-hero">
      <div class="hero-overlay"></div>
      <div class="page-hero-inner">
        <p class="page-hero-label">SERVICE 05 — Cemetery &amp; Garden Burial</p>
        <h1 class="page-hero-title">墓地・霊園ご紹介</h1>
        <p class="page-hero-catch">故人にふさわしい、安らぎの場所を。</p>
        <p class="page-hero-desc">
          一般墓・納骨堂・樹木葬・永代供養墓まで、<br>
          ご希望に合った供養のかたちをご提案いたします。<br>
          長崎県内の主要霊園と提携し、見学同行・相見積もりまでサポートいたします。
        </p>
        <div class="page-hero-badge">
          <Icon name="map-pin" size={16} />
          <span>長崎県内の<strong style="font-family:var(--num);font-size:1.1rem">主要霊園と提携</strong></span>
        </div>
      </div>
    </section>

    <!-- BURIAL TYPES -->
    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">BURIAL TYPES</p>
          <h2 class="sec-title">供養のかたち</h2>
          <p class="sec-desc">それぞれの想いに寄り添う、4つの供養のかたちをご紹介します。</p>
        </div>
        <div class="items-grid fi">
          {burialTypes.map(t => (
            <div class="item-card">
              <div class="item-icon"><Icon name={t.icon} size={24} /></div>
              <div>
                <h3 class="item-title">{t.title}</h3>
                <p class="item-desc">{t.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">FEATURES</p>
          <h2 class="sec-title">ご紹介サービスの特徴</h2>
        </div>
        <div class="features fi">
          {features.map(f => (
            <div class="feature">
              <div class="feature-icon"><Icon name={f.icon} size={28} /></div>
              <h3 class="feature-title">{f.title}</h3>
              <p class="feature-desc">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">PROCESS</p>
          <h2 class="sec-title">ご紹介の流れ</h2>
          <p class="sec-desc">ヒアリングから建立・ご利用開始まで、専門スタッフが伴走いたします。</p>
        </div>
        <div class="steps-grid fi">
          {steps.map(s => (
            <div class="step">
              <div class="step-num">{s.num}</div>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-desc">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRICE TABLE -->
    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">PRICE GUIDE</p>
          <h2 class="sec-title">費用の目安</h2>
          <p class="sec-desc">下記は一般的な費用の目安です。霊園・墓地により金額は異なります。</p>
        </div>
        <div class="price-table-wrap fi">
          <table class="price-table">
            <thead>
              <tr>
                <th>供養のかたち</th>
                <th>費用の目安</th>
                <th>備考</th>
              </tr>
            </thead>
            <tbody>
              {priceRows.map(row => (
                <tr>
                  <td>{row.type}</td>
                  <td><strong>{row.price}</strong></td>
                  <td class="note-cell">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p style="font-size:.78rem;color:var(--light);margin-top:.85rem;line-height:1.9">
            ※上記は目安です。霊園・地域・宗派により金額は変動いたします。<br>
            ※墓石建立費用は石種・デザインにより大きく異なります。<br>
            ※詳細はお見積もり時にご確認ください。
          </p>
        </div>
      </div>
    </section>

    <section class="sec bg-cream">
      <div class="sec-inner" style="max-width:780px">
        <div class="note-block fi">
          <strong>「お墓の継承を心配している」「遠方なので維持が難しい」というお声を多くいただきます。</strong>
          近年は、後継ぎを必要としない永代供養型のお墓を選ぶ方が増えています。樹木葬・納骨堂・永代供養墓など、ご家族の状況や想いに合わせた選択肢がございます。「どれを選べばいいかわからない」という方も、まずはお気軽にご相談ください。
        </div>
      </div>
    </section>

    <section class="cta-sec fi">
      <h2 class="cta-title">まずはお気軽にご相談ください</h2>
      <p class="cta-desc">ご相談・資料請求は無料です。「お墓の件で…」とお伝えください。<br>専門スタッフが丁寧にご案内いたします。</p>
      <p class="cta-hours">受付時間 10:00〜17:00（店休日無し）</p>
      <div class="cta-btns">
        <a href="tel:0958654400" class="cta-tel-btn"><Icon name="phone" size={18} />今すぐ電話する</a>
        <a href="/#contact" class="cta-web-btn"><Icon name="mail" size={18} />Webで相談する</a>
      </div>
    </section>

  </main>

  <Footer />

  <div class="fixed-cta">
    <a href="tel:0958654400" class="tel-f"><Icon name="phone" size={18} />電話で相談</a>
    <a href="/#contact" class="web-f"><Icon name="mail" size={18} />Webで相談</a>
  </div>
</BaseLayout>

<style>
  :root{--gold:#c8a84b}
  .breadcrumb{background:var(--clight);padding:.65rem 1.5rem;font-size:.78rem;color:var(--light);display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
  .breadcrumb a{color:var(--mid)}
  .breadcrumb a:hover{color:var(--gd)}
  .page-hero{position:relative;min-height:480px;overflow:hidden;background:linear-gradient(135deg, var(--gd), var(--gm));color:#fff;display:flex;align-items:center;padding:5rem 1.5rem}
  .hero-overlay{position:absolute;inset:0;z-index:2;background:linear-gradient(100deg,rgba(45,90,61,0.6) 0%,rgba(45,90,61,0.3) 60%,rgba(45,90,61,0) 100%)}
  .page-hero-inner{position:relative;z-index:3;max-width:680px;width:100%;margin:0 auto 0 max(1.5rem,calc((100% - 1100px)/2));text-align:left}
  .page-hero-label{font-family:var(--roman);font-size:.78rem;letter-spacing:0;opacity:.8;margin-bottom:.6rem}
  .page-hero-title{font-family:var(--serif);font-size:clamp(1.75rem,4vw,2.5rem);font-weight:400;letter-spacing:.1em;margin-bottom:1rem}
  .page-hero-catch{font-family:var(--serif);font-size:clamp(1rem,2vw,1.25rem);font-weight:300;letter-spacing:.08em;color:rgba(255,255,255,.92);margin-bottom:1.25rem;line-height:1.7}
  .page-hero-desc{font-size:.95rem;line-height:2;opacity:.88;max-width:600px}
  .page-hero-badge{display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);padding:.5rem 1rem;font-size:.85rem;margin-top:1.25rem;backdrop-filter:blur(4px);border-radius:var(--corner)}
  .sec{padding:5rem 1.5rem}
  .sec-inner{max-width:1100px;margin:0 auto}
  .sec.bg-cream{background:var(--clight)}
  .sec-head{text-align:center;margin-bottom:2.75rem}
  .sec-label{font-family:var(--roman);font-size:.78rem;letter-spacing:0;color:var(--gd);margin-bottom:.55rem}
  .sec-title{font-family:var(--serif);font-size:clamp(1.4rem,3vw,1.85rem);font-weight:400;letter-spacing:.1em;margin-bottom:.8rem}
  .sec-desc{font-size:.9rem;color:var(--mid);line-height:2}
  .features{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}
  .feature{background:var(--white);border:1px solid var(--border);padding:1.85rem 1.35rem;text-align:left;border-radius:var(--corner)}
  .feature-icon{color:var(--gd);margin-bottom:.85rem;width:48px;height:48px;background:var(--gl);display:flex;align-items:center;justify-content:center;border-radius:var(--corner)}
  .feature-title{font-family:var(--serif);font-size:1rem;font-weight:400;color:var(--gd);margin-bottom:.6rem;line-height:1.6}
  .feature-desc{font-size:.875rem;line-height:1.9;color:var(--mid)}
  .steps-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;max-width:1100px;margin:0 auto}
  .step{background:var(--white);border:1px solid var(--border);padding:1.5rem 1.15rem 1.35rem;position:relative;border-radius:var(--corner)}
  .step-num{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;background:var(--gd);color:#fff;font-family:var(--num);font-size:1.1rem;margin-bottom:.95rem;border-radius:50%}
  .step-title{font-family:var(--serif);font-size:.95rem;font-weight:400;color:var(--gd);margin-bottom:.65rem;line-height:1.6;padding-bottom:.5rem;border-bottom:1px solid var(--gm)}
  .step-desc{font-size:.85rem;line-height:1.85;color:var(--mid)}
  .items-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem;max-width:1000px;margin:0 auto}
  .item-card{background:var(--white);border:1px solid var(--border);padding:1.5rem;display:flex;gap:1rem;align-items:flex-start;border-radius:var(--corner)}
  .item-icon{color:var(--gd);background:var(--gl);width:48px;height:48px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:var(--corner)}
  .item-title{font-family:var(--serif);font-size:1rem;font-weight:400;color:var(--gd);margin-bottom:.4rem}
  .item-desc{font-size:.875rem;line-height:1.85;color:var(--mid)}
  .price-table-wrap{max-width:780px;margin:0 auto}
  .price-table{width:100%;border-collapse:collapse;font-size:.9rem;background:var(--white);border:1px solid var(--border);border-radius:var(--corner);overflow:hidden}
  .price-table th{background:var(--gd);color:#fff;padding:.85rem 1.25rem;text-align:left;font-weight:400;font-size:.875rem;letter-spacing:0}
  .price-table td{padding:.85rem 1.25rem;border-bottom:1px solid var(--border)}
  .price-table tbody tr:last-child td{border-bottom:none}
  .price-table .note-cell{font-size:.78rem;color:var(--light)}
  .price-table strong{font-family:var(--num);font-size:1rem;color:var(--gd)}
  .note-block{background:#fffbf0;border-left:3px solid var(--gold);padding:1.5rem 1.75rem;font-size:.9rem;line-height:1.95;color:var(--mid);border-radius:var(--corner)}
  .note-block strong{color:var(--gd);display:block;margin-bottom:.5rem;font-family:var(--serif);font-size:1rem}
  .cta-sec{background:var(--gd);color:#fff;padding:5rem 1.5rem;text-align:center}
  .cta-title{font-family:var(--serif);font-size:clamp(1.4rem,3vw,1.85rem);font-weight:400;letter-spacing:.1em;margin-bottom:1.25rem}
  .cta-desc{font-size:.9rem;opacity:.85;margin-bottom:.75rem;line-height:2}
  .cta-hours{font-size:.78rem;opacity:.7;margin-bottom:2.25rem}
  .cta-btns{display:flex;justify-content:center;gap:1rem;flex-wrap:wrap}
  .cta-tel-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;background:#fff;color:var(--gd);padding:.95rem 2.5rem;font-size:.95rem;font-family:var(--roman);letter-spacing:0;transition:.2s;border-radius:var(--corner)}
  .cta-tel-btn:hover{background:var(--gl)}
  .cta-web-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;border:1px solid rgba(255,255,255,.5);color:#fff;padding:.95rem 2.5rem;font-size:.9rem;letter-spacing:0;transition:.2s;border-radius:var(--corner)}
  .cta-web-btn:hover{background:rgba(255,255,255,.1)}
  .fixed-cta{display:none}
  @media(max-width:1024px){.features{grid-template-columns:repeat(2,1fr)}.steps-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:768px){.page-hero{padding:3.5rem 1.25rem;min-height:auto}.page-hero-inner{margin:0 auto;text-align:left}.features,.steps-grid,.items-grid{grid-template-columns:1fr}.sec{padding:3.5rem 1rem}.price-table{font-size:.85rem}.price-table th,.price-table td{padding:.7rem .8rem}.cta-btns{flex-direction:column;align-items:stretch;max-width:320px;margin:0 auto}.fixed-cta{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:150}.fixed-cta a{flex:1;display:flex;align-items:center;justify-content:center;padding:1rem;font-size:.92rem;gap:.4rem;font-weight:500}.tel-f{background:var(--gd);color:#fff}.web-f{background:#333;color:#fff}body{padding-bottom:52px}}
</style>

<script>
const obs = new IntersectionObserver(e => { e.forEach(x => { if(x.isIntersecting){ x.target.classList.add('fade-in'); obs.unobserve(x.target); }}); }, { threshold: 0.1 });
document.querySelectorAll('.fi').forEach(el => { el.classList.add('fade-init'); obs.observe(el); });
</script>
