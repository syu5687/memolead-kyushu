---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import FixedCta from '../../components/FixedCta.astro';
import CtaSection from '../../components/CtaSection.astro';
import { Image } from 'astro:assets';
import heroImage from '../../_assets/img/estate/hero-image.jpg';
import { getServicePricing, formatYen } from '../../data/pricing';
import { SITE, companyOf, ESTATE_PERMITS } from '../../data/site';
const company = companyOf('estate');

// 変更後：料金データを junk から取得（不用品回収＝エンゼル号の料金）
// pricing.ts の 'junk' はシミュレーターでも使うため残し、参照キーだけ変更
const junkPricing = getServicePricing('junk');
const priceRows = junkPricing?.plans ?? [];
const priceNotes = junkPricing?.notes ?? [];
// ヒーローバッジ・price-hero に出す最低価格（エンゼル号1台の基本料金＝11,000円）
const minPrice = priceRows.length > 0 ? Math.min(...priceRows.map(p => p.price)) : 0;

// 4つの特徴(features) - estate独自の信頼訴求
const features = [
  { icon: 'document', title: '経験豊富なスタッフが対応　', desc: '一般社団法人遺品整理士認定協会の認定資格を持つスタッフが、故人様の品を一品一品丁寧に扱います。経験豊富な専門家にお任せください。' },
  { icon: 'lotus',    title: '故人を想う、丁寧な仕分け', desc: '貴重品・思い出の品・買取可能な品・処分品に分類。ご家族のご意向を伺いながら、慎重に進めます。大切な品が紛れないよう、複数人で確認します。' },
  { icon: 'home',     title: '仕分けから処分まで一括対応', desc: '買取査定・不用品回収・お焚き上げ・ハウスクリーニングまで、窓口をひとつにまとめて対応。複数業者への連絡は不要です。' },
  { icon: 'tag',      title: '安心の事前見積もり',       desc: '現地調査のうえ、明確なお見積りをご提示いたします。作業当日の追加料金は一切いただきません。ご納得いただいてからの作業開始です。' },
];

// エンゼルセット（供養袋セット）- PDF「エンゼルセットのご利用について」より
const angelSet = [
  { badge: '標準セット', name: '衣類供養袋',     size: '大きさ：350 × 650 × 240 mm',  desc: '故人が愛用された着物・衣類・背広などをお入れください。専用供養祭壇にてお寺様に御供養していただきます。ご希望があれば、御供養終了後に供養証明書を発行・郵送いたします。' },
  { badge: '大型用',     name: '予備供養袋',     size: '大きさ：900 × 450 × 450 mm',  desc: '「衣類供養袋」に入りきれない品をお入れください。燃やせるもの・燃やせないもの混在可。リサイクル家電・生物を入れるのはご遠慮ください。' },
  { badge: '必須',       name: '供養袋名札 2枚', size: '各供養袋に取り付けてください', desc: '各供養袋にお名前等をご記入の上、取り付けてください。供養証明書が必要な方は名札の最後の列の「供養証明書の要」に忘れずに○印をお付けください。' },
];

const steps = [
  { num: 1, title: 'ご遺族のお手元に',   desc: '御葬儀代精算時、葬儀社担当者が速やかに御供養遺品収納ケースをお持参します。' },
  { num: 2, title: '名札の記入',         desc: 'ご遺族様に、名札の記入をお願いいたします。供養証明書の発行に必要です。' },
  { num: 3, title: 'パッケージ',         desc: 'ご遺族様に、ご供養したい品物を御供養袋にお入れいただきます（実用新案登録 第3154655号）。' },
  { num: 4, title: '回収・保管',         desc: 'エンゼルセンター担当者がお預かりして、所定の場所に保管いたします。' },
  { num: 5, title: '御供養（合同供養）', desc: '当社指定の寺院の僧侶により、読経・御供養をしていただきます。' },
  { num: 6, title: '輸送',               desc: '御供養終了後、都道府県知事許可の運搬作業車にて輸送いたします。' },
  { num: 7, title: '焼却（完全焼却）',   desc: '都道府県知事許可の焼却炉に委託し完全焼却します。一部位牌・人形などは当社の焼却炉にて焼却いたします。' },
  { num: 8, title: '供養証明書の発行',   desc: 'ご希望のご遺族に「供養証明書」を郵送いたします。' },
];

// 変更後：対応品目 - PDF「お焚き上げ品の一例」の内容に準拠
const items = [
  { icon: 'doll',      title: '人形・ぬいぐるみ',      desc: '魂が宿るとされる人形・ぬいぐるみ・節句人形などを、お寺様の御供養のうえ丁寧にお焚き上げいたします。供養証明書の発行も可能です。' },
  { icon: 'altar',     title: '仏壇・神棚',            desc: '大切にされてきた仏壇・神棚を、閉眼供養（魂抜き）のうえ、責任を持ってお焚き上げいたします。' },
  { icon: 'photo',     title: '写真・置物・剥製',      desc: '故人が大切にされていた写真・位牌・置物・剥製など、思い出の品を丁寧に御供養したうえで処分いたします。' },
  { icon: 'lotus',     title: '神事に関する物',        desc: '神札・御守・神棚・松飾・結納品など、神事に関する品を粗末にすることなくお焚き上げいたします。' },
  { icon: 'bag',       title: '衣類・着物・バッグ',    desc: '故人が愛用された着物・衣類・背広などを衣類供養袋にお入れいただき、専用供養祭壇にてお寺様に御供養していただきます。' },
  { icon: 'home',      title: '故人が大切にした物',    desc: '故人が大切にしていた品や、処分に困っている日用品・雑貨などもお気軽にご相談ください。お布団の引き取りも可能です（有料1枚550円）。' },
];
const areas = ESTATE_PERMITS;
---

<BaseLayout
 title={`遺品整理・不用品回収 | ${SITE.fullName}`}
  description="遺品整理士の有資格者が、故人様のお部屋を丁寧に整理いたします。仕分け・買取・処分・清掃までワンストップ。1K〜一軒家まで、明朗な料金プランをご用意。長崎市・時津町・長与町対応。"
>
  <Header />
  <main>

    <!-- HERO(背景画像+ダークグリーンオーバーレイ) -->
    <section class="page-hero">
      <div class="hero-bg">
        <Image
          src={heroImage}
          alt={`遺品整理・不用品回収 - ${SITE.fullName}`}
          widths={[800, 1200, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
        />
      </div>
      <div class="hero-overlay"></div>
      <div class="breadcrumb">
      <a href="/">ホーム</a><span>›</span>
      <a href="/#services">サービス一覧</a><span>›</span>
      <span>遺品整理・不用品回収</span>
    </div>

      <div class="page-hero-inner">
        <p class="page-hero-label">SERVICE 01 — Estate Clearance</p>
        <h1 class="page-hero-title">遺品整理・不用品回収</h1>
        <p class="page-hero-catch">故人が大切にされていた品を、ご家族の歩幅で。</p>
        <p class="page-hero-desc">
          遺品整理士の資格を持つスタッフが、ご遺族のお気持ちに寄り添いながら、<br>
          故人様のお部屋を丁寧に整理いたします。<br>
          仕分け・買取・処分・清掃まで、ワンストップで対応します。
        </p>
        <div class="page-hero-badge">
          <Icon name="tag" size={16} />
          <span>エンゼル号 1台 <strong style="font-family:var(--num);font-size:1.1rem">{minPrice.toLocaleString('ja-JP')}円〜</strong>（税込）</span>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">FEATURES</p>
          <h2 class="sec-title">選ばれる4つの理由</h2>
        </div>
        <div class="features fi">
          {features.map(f => (
            <div class="feature">
              <div class="feature-icon"><Icon name={f.icon} size={28} /></div>
              <h3 class="feature-title">{f.title}</h3>
              <p class="feature-desc">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRICE HERO -->
    <div class="price-hero fi">
      <div class="price-hero-inner">
        <p class="price-hero-label">ANGEL 号（エンゼル号）</p>
        <p class="price-hero-name">遺品・不用品回収車</p>
        <div class="price-big">{minPrice.toLocaleString('ja-JP')}円<span class="price-unit">〜（税込）</span></div>
        <p style="font-size:.875rem;opacity:.85">トラックがご自宅横付けの場合 / 1台あたり</p>
        <ul class="price-notes">
          <li>停車場所からご自宅まで距離がある場合、人件費をいただく場合があります</li>
          <li>リサイクル料金・人件費等の別途料金が発生する場合があります</li>
          <li>少量の回収品においては、金額等ご相談に応じます</li>
          <li>生ゴミについてはご遠慮ください</li>
          <li>「不要品」については【当日処分】となります</li>
        </ul>
      </div>
    </div>

    <!-- PROCESS -->
    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">PROCESS</p>
          <h2 class="sec-title">遺品御供養サービスの流れ</h2>
          <p class="sec-desc">ご葬儀終了後から供養証明書の発行まで、8つのステップで丁寧に対応いたします。</p>
        </div>
        <div class="steps-grid fi">
          {steps.map(s => (
            <div class="step">
              <div class="step-num">{s.num}</div>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-desc">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ITEMS -->
    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">ITEMS</p>
          <h2 class="sec-title">回収・お焚き上げ対応品目</h2>
          <p class="sec-desc">大切なものだから、ただ処分するのではなく、心を込めた御供養のあとに処分いたします。</p>
        </div>
        <div class="items-grid fi">
          {items.map(it => (
            <div class="item-card">
              <div class="item-icon"><Icon name={it.icon} size={24} /></div>
              <div>
                <h3 class="item-title">{it.title}</h3>
                <p class="item-desc">{it.desc}</p>
              </div>
            </div>
          ))}
        </div>
        <!-- ↓ ここから追加：コラム「お焚き上げとは」 -->
        <div class="otakiage-column fi">
          <p class="otakiage-column-label">COLUMN</p>
          <h3 class="otakiage-column-title">お焚き上げとは</h3>
          <p>思いが込められたもの、魂が宿るとされているものに、これまでの礼を尽くし、浄火によって天界へ還す…その行いを「お焚き上げ」といいます。</p>
          <p>日本では古代から、神仏化した品物や擬人化した品物などを丁重に扱う風習がありました。とくに神棚や仏壇、人形などを粗末にしてはいけないと伝えられており、お焚き上げの儀式は神社や寺院に依頼するのが一般的でした。</p>
          <p>当センターでは、<strong>お寺様の御供養後、当社が責任を持ってお焚き上げ</strong>をさせていただきます。九州初のお焚き上げ専用焼却炉を完備しております。</p>
        </div>
        
        <!-- 注意書き（お焚き上げ品の条件） -->
        <div class="note-block fi" style="margin-top:1.5rem">
          ※お焚き上げ品によっては、燃納出来ない場合がございます。その場合はご供養後、法条例などに基づいた処理をさせていただきます。<br>
          ※リサイクル家電（テレビ・冷蔵庫・洗濯機・空調機）を入れるのはご遠慮ください。
        </div>
        <!-- ↑ ここまで追加 -->
      </div>
    </section>
    
    <!-- OTAKIAGE(お焚き上げとは) -->
    <section class="sec">
      <div class="sec-inner" style="max-width:820px">
        <div class="sec-head fi">
          <p class="sec-label">OTAKIAGE</p>
          <h2 class="sec-title">お焚き上げとは</h2>
        </div>
        <div class="okiage-lead fi">
          <p>思いが込められたもの、魂が宿るとされているものに、これまでの礼を尽くし、浄火によって天界へ還す…その行いを「お焚き上げ」といいます。</p>
          <p>日本では古代から、神仏化した品物や擬人化した品物などを丁重に扱う風習がありました。とくに神棚や仏壇、人形などを粗末にしてはいけないと伝えられており、お焚き上げの儀式は神社や寺院に依頼するのが一般的でした。</p>
          <p>当センターでは、<strong>お寺様の御供養後、当社が責任を持ってお焚き上げ</strong>をさせていただきます。九州初のお焚き上げ専用焼却炉を完備しております。</p>
        </div>
        <div class="note-block fi" style="margin-top:1.75rem">
          ※お焚き上げ品によっては、燃納出来ない場合がございます。その場合はご供養後、法条例などに基づいた処理をさせていただきます。<br>
          ※リサイクル家電（テレビ・冷蔵庫・洗濯機・空調機）を入れるのはご遠慮ください。
        </div>
      </div>
    </section>
    
    <!-- ANGEL SET(エンゼルセット) -->
    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">ANGEL SET</p>
          <h2 class="sec-title">エンゼルセットのご利用について</h2>
          <p class="sec-desc">御葬儀の際にお渡しする専用の供養袋セットです。ご供養したい品物をお入れください。</p>
        </div>
        <div class="angel-set fi">
          {angelSet.map(set => (
            <div class="set-card">
              <span class="set-badge">{set.badge}</span>
              <h3 class="set-name">{set.name}</h3>
              <p class="set-size">{set.size}</p>
              <p class="set-desc">{set.desc}</p>
            </div>
          ))}
        </div>
        <div class="note-block fi" style="margin-top:1.5rem">
          上記の衣類・予備供養袋に関しましては無料で回収に伺いますので、お気軽にエンゼルセンターまでご連絡ください。<br>
          ※お布団の引取りも可能です。御用命ください。（有料1枚550円［税込］）<br>
          ※供養袋回収後、遺品返還の希望がありましたら、1週間以内にご連絡ください。1・3・5・7・9・11月の10日前後に執り行われる供養祭終了後は供養品のご返却は出来かねますのでご了承ください。
        </div>
      </div>
    </section>

    <!-- PRICE TABLE(詳細料金) -->
    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">PRICE TABLE</p>
          <h2 class="sec-title">料金表</h2>
          <p class="sec-desc">明確な料金体系で、いきなり高額な請求はありません。詳細は現地お見積り・仮見積りにてご確認ください。</p>
        </div>
<div class="price-table-wrap fi">
          <table class="price-table">
            <thead>
              <tr>
                <th style="width:40%">サービス内容</th>
                <th style="width:20%">内容</th>
                <th style="width:30%">料金（税込）</th>
                <th style="width:10%">人気</th>
              </tr>
            </thead>
            <tbody>
              {priceRows.map(row => (
                <tr class={row.popular ? 'row-popular' : ''}>
                  <td>{row.label}</td>
                  <td class="note-cell">{row.size}</td>
                  <td><strong>{formatYen(row.price)}</strong></td>
                  <td>{row.popular && <span class="popular-badge">人気</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p style="font-size:.78rem;color:var(--light);margin-top:.85rem;line-height:1.9">
            {priceNotes.map((note, i) => (
              <>※{note}{i < priceNotes.length - 1 && <br />}</>
            ))}
          </p>
        </div>
      </div>
    </section>

    <!-- AREA -->
    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">AREA</p>
          <h2 class="sec-title">対応エリア</h2>
          <p class="sec-desc">下記エリアにて遺品整理のお伺いが可能です。エリア外の方もまずはご相談ください。</p>
        </div>
        <div class="area-cards fi">
          {areas.map(a => (
            <div class="area-card">
              <h3 class="area-name">{a.name}</h3>
              <p class="area-permit" set:html={a.permit}></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- NOTE -->
    <section class="sec">
      <div class="sec-inner" style="max-width:780px">
        <div class="note-block fi">
          <strong>遺品整理は、ご家族のためのお時間でもあります。</strong><br>
          故人が遺された品々の中には、大切な思い出やご家族の絆を感じる品も含まれます。私たちは、ただ「処分」するのではなく、ご家族のお気持ちに寄り添いながら、一つひとつ丁寧に整理してまいります。お困りごとがありましたら、どんな些細なことでもお気軽にご相談ください。
        </div>
      </div>
    </section>

    <!-- CTA -->
    <CtaSection
      title="まずはお気軽にご相談ください"
      desc="現地お見積り・ご相談は無料です。「遺品整理の件で…」とお伝えください。<br>遺品整理士が丁寧にご案内いたします。"
      tel={company?.tel}
      hours=`受付時間 ${company?.hours}`
      estimateHref="/estimate/?service=junk"
      contactHref="/#contact"
    />

  </main>

  <Footer />

  <!-- モバイル固定CTAバー(共通コンポーネント) -->
  <FixedCta />
</BaseLayout>

<style>
  :root{--gold:#c8a84b}

  .breadcrumb{position:absolute;top:1.25rem;left:0;right:0;z-index:4;max-width:1100px;margin:0 auto;padding:.5rem 1.5rem;font-size:.78rem;color:rgba(255,255,255,0.7);display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
  .breadcrumb a{color:rgba(255,255,255,0.8)}
  .breadcrumb a:hover{color:#fff}
  .breadcrumb > span:last-child{color:rgba(255,255,255,0.95)}

  /* ─────────────────────────────────────────
     PAGE HERO(背景画像+ダークグリーンオーバーレイ)
     ───────────────────────────────────────── */
  .page-hero{
    position:relative;
    min-height:480px;
    overflow:hidden;
    background:var(--gd);
    color:#fff;
    display:flex;
    align-items:center;
    padding:5rem 1.5rem;
  }
  .hero-bg{position:absolute;inset:0;z-index:1}
  .hero-bg :global(.hero-img){
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center 35%;
    filter:saturate(0.9) sepia(0.05) brightness(0.95);
  }
  .hero-overlay{
    position:absolute;
    inset:0;
    z-index:2;
    background:linear-gradient(
      100deg,
      rgba(45,90,61,0.85) 0%,
      rgba(45,90,61,0.75) 35%,
      rgba(45,90,61,0.65) 60%,
      rgba(45,90,61,0.45) 100%
    );
  }
  .page-hero-inner{
    position:relative;
    z-index:3;
    max-width:680px;
    width:100%;
    margin:0 auto 0 max(1.5rem,calc((100% - 1100px)/2));
    text-align:left;
  }
  .page-hero-label{font-family:var(--roman);font-size:.78rem;letter-spacing:0;opacity:.8;margin-bottom:.6rem}
  .page-hero-title{font-family:var(--serif);font-size:clamp(1.75rem,4vw,2.5rem);font-weight:400;letter-spacing:.1em;margin-bottom:1rem}
