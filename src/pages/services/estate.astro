---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import heroImage from '../../_assets/img/estate/estate-organize.jpg';
import { getServicePricing, formatYen } from '../../data/pricing';

// 料金データを一元管理(src/data/pricing.ts)から取得
// このファイルを変更すると、サービスページと仮見積りシミュレーション両方に反映されます
const estatePricing = getServicePricing('estate');
const priceRows = estatePricing?.plans ?? [];
const priceNotes = estatePricing?.notes ?? [];
// 最低価格をヒーローバッジに表示する用(全プランの中の最安値)
const minPrice = priceRows.length > 0 ? Math.min(...priceRows.map(p => p.price)) : 0;

// 4つの特徴(features) - estate独自の信頼訴求
const features = [
  { icon: 'document', title: '遺品整理士の有資格者が対応', desc: '一般社団法人遺品整理士認定協会の認定資格を持つスタッフが、故人様の品を一品一品丁寧に扱います。経験豊富な専門家にお任せください。' },
  { icon: 'lotus',    title: '故人を想う、丁寧な仕分け', desc: '貴重品・思い出の品・買取可能な品・処分品に分類。ご家族のご意向を伺いながら、慎重に進めます。大切な品が紛れないよう、複数人で確認します。' },
  { icon: 'home',     title: '仕分けから処分まで一括対応', desc: '買取査定・不用品回収・お焚き上げ・ハウスクリーニングまで、窓口をひとつにまとめて対応。複数業者への連絡は不要です。' },
  { icon: 'tag',      title: '安心の事前見積もり',       desc: '現地調査のうえ、明確なお見積りをご提示いたします。作業当日の追加料金は一切いただきません。ご納得いただいてからの作業開始です。' },
];

// 8つのSTEP - 遺品整理の流れ
const steps = [
  { num: 1, title: 'お電話・Webでお問合せ', desc: 'お電話・Webフォームでお気軽にご相談ください。ご状況を簡単にお伺いします。' },
  { num: 2, title: '現地お見積り(無料)',    desc: '専門スタッフがお部屋を拝見し、お見積りをご提示いたします。出張費・見積り費用は一切いただきません。' },
  { num: 3, title: 'お見積りのご確認',       desc: 'お見積り内容をご確認いただき、ご不明な点はその場で解消いたします。' },
  { num: 4, title: 'ご契約・作業日決定',    desc: 'ご納得いただきましたらご契約。ご都合のよい作業日をお決めいただきます。' },
  { num: 5, title: 'ご親族立ち会いで作業開始', desc: '作業当日はご親族のお立ち会いをおすすめします。貴重品の確認をご一緒に行います。' },
  { num: 6, title: '仕分け・梱包・搬出',    desc: 'スタッフ複数名で丁寧に仕分け。貴重品は必ずご家族にお渡しいたします。' },
  { num: 7, title: '清掃・お焚き上げ',       desc: '搬出後の簡易清掃まで対応。仏壇・人形などは閉眼供養のうえお焚き上げいたします。' },
  { num: 8, title: '完了報告・お引渡し',     desc: '作業完了後、お部屋の状態をご確認いただき、お引渡しとなります。' },
];

// 対応品目
const items = [
  { icon: 'bag',       title: '衣類・着物・布団',      desc: '故人が愛用されたお着物・衣類は買取・寄付・供養のいずれかをご相談のうえ対応いたします。' },
  { icon: 'furniture', title: '家具・家電',            desc: 'タンス・ソファ・ベッドなど大型家具から、テレビ・冷蔵庫・洗濯機などの家電まで一括搬出。' },
  { icon: 'box',       title: '食器・調理器具',        desc: '価値のある陶磁器・茶器は買取査定。普段使いの食器は丁寧に処分いたします。' },
  { icon: 'document',  title: '書籍・書類',            desc: '重要書類(契約書・保険証券など)は必ずお渡しいたします。古書・専門書は買取査定可能です。' },
  { icon: 'photo',     title: '写真・思い出の品',      desc: 'アルバム・写真・手紙などはご家族でご確認いただける形で整理いたします。' },
  { icon: 'altar',     title: '仏壇・神棚・人形',     desc: '閉眼供養のうえ、お焚き上げいたします。供養証明書の発行も承ります(別途料金)。' },
  { icon: 'lotus',     title: '貴重品の捜索',          desc: '通帳・印鑑・宝飾品・現金など、見逃しがないよう複数人で確認のうえ必ずご家族にお渡しします。' },
  { icon: 'tag',       title: '不動産関連書類',        desc: '権利証・登記書類・契約書など、相続手続きに必要な書類を整理してお渡しいたします。' },
];

// 対応エリア
const areas = [
  { name: '長崎市', permit: '一般廃棄物収集運搬許可<br>長崎市 第471号' },
  { name: '時津町', permit: '一般廃棄物収集運搬許可<br>時津 指令第15号' },
  { name: '長与町', permit: '一般廃棄物収集運搬許可<br>長与 一廃許可65号' },
];
---

<BaseLayout
  title="遺品整理 | エンジェルセンター ぶっこうどう"
  description="遺品整理士の有資格者が、故人様のお部屋を丁寧に整理いたします。仕分け・買取・処分・清掃までワンストップ。1K〜一軒家まで、明朗な料金プランをご用意。長崎市・時津町・長与町対応。"
>
  <Header />
  <main>

    <div class="breadcrumb">
      <a href="/">ホーム</a><span>›</span>
      <a href="/#services">サービス一覧</a><span>›</span>
      <span>遺品整理</span>
    </div>

    <!-- HERO(背景画像+ダークグリーンオーバーレイ) -->
    <section class="page-hero">
      <div class="hero-bg">
        <Image
          src={heroImage}
          alt="遺品整理 - 故人様のお部屋を丁寧に整える"
          widths={[800, 1200, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
        />
      </div>
      <div class="hero-overlay"></div>

      <div class="page-hero-inner">
        <p class="page-hero-label">SERVICE 01 — Estate Clearance</p>
        <h1 class="page-hero-title">遺品整理</h1>
        <p class="page-hero-catch">故人が大切にされていた品を、ご家族の歩幅で。</p>
        <p class="page-hero-desc">
          遺品整理士の資格を持つスタッフが、ご遺族のお気持ちに寄り添いながら、<br>
          故人様のお部屋を丁寧に整理いたします。<br>
          仕分け・買取・処分・清掃まで、ワンストップで対応します。
        </p>
        <div class="page-hero-badge">
          <Icon name="tag" size={16} />
          <span>1K〜一軒家 <strong style="font-family:var(--num);font-size:1.1rem">{minPrice.toLocaleString('ja-JP')}円〜</strong>（税込）</span>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">FEATURES</p>
          <h2 class="sec-title">選ばれる4つの理由</h2>
        </div>
        <div class="features fi">
          {features.map(f => (
            <div class="feature">
              <div class="feature-icon"><Icon name={f.icon} size={28} /></div>
              <h3 class="feature-title">{f.title}</h3>
              <p class="feature-desc">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRICE HERO -->
    <div class="price-hero fi">
      <div class="price-hero-inner">
        <p class="price-hero-label">PRICE PLAN — 間取り別の料金プラン</p>
        <p class="price-hero-name">明朗な料金体系</p>
        <div class="price-big">{minPrice.toLocaleString('ja-JP')}円<span class="price-unit">〜（税込）</span></div>
        <p style="font-size:.875rem;opacity:.85">1K(15㎡)〜 / 遺品整理士が在籍</p>
        <ul class="price-notes">
          <li>お部屋の状態・残置物の量により料金が変動する場合があります</li>
          <li>仏壇・人形などのお焚き上げ供養は別途料金を申し受けます</li>
          <li>買取可能な品がある場合は料金から差し引きいたします</li>
          <li>出張費・現地見積もり費用は無料です</li>
          <li>追加料金が発生する場合は事前にご相談・ご承諾の上で進めます</li>
        </ul>
      </div>
    </div>

    <!-- PROCESS -->
    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">PROCESS</p>
          <h2 class="sec-title">遺品整理の流れ</h2>
          <p class="sec-desc">お問合せから作業完了まで、8つのステップで丁寧に対応いたします。</p>
        </div>
        <div class="steps-grid fi">
          {steps.map(s => (
            <div class="step">
              <div class="step-num">{s.num}</div>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-desc">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ITEMS -->
    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">ITEMS</p>
          <h2 class="sec-title">対応品目</h2>
          <p class="sec-desc">日用品から貴重品・思い出の品まで、すべてのお品に対して心を込めて対応いたします。</p>
        </div>
        <div class="items-grid fi">
          {items.map(it => (
            <div class="item-card">
              <div class="item-icon"><Icon name={it.icon} size={24} /></div>
              <div>
                <h3 class="item-title">{it.title}</h3>
                <p class="item-desc">{it.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRICE TABLE(間取り別の詳細料金) -->
    <section class="sec">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">PRICE TABLE</p>
          <h2 class="sec-title">間取り別 料金表</h2>
          <p class="sec-desc">お部屋の広さ別に料金の目安をご案内いたします。詳細は現地お見積りにてご確認ください。</p>
        </div>
        <div class="price-table-wrap fi">
          <table class="price-table">
            <thead>
              <tr>
                <th>間取り</th>
                <th>広さ</th>
                <th>料金(税込)</th>
                <th>作業時間</th>
              </tr>
            </thead>
            <tbody>
              {priceRows.map(row => (
                <tr class={row.popular ? 'row-popular' : ''}>
                  <td>
                    {row.label}
                    {row.popular && <span class="popular-badge">人気</span>}
                  </td>
                  <td class="note-cell">{row.size}</td>
                  <td><strong>{formatYen(row.price)}</strong></td>
                  <td class="note-cell">{row.time}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p style="font-size:.78rem;color:var(--light);margin-top:.85rem;line-height:1.9">
            {priceNotes.map((note, i) => (
              <>※{note}{i < priceNotes.length - 1 && <br />}</>
            ))}
          </p>
        </div>
      </div>
    </section>

    <!-- AREA -->
    <section class="sec bg-cream">
      <div class="sec-inner">
        <div class="sec-head fi">
          <p class="sec-label">AREA</p>
          <h2 class="sec-title">対応エリア</h2>
          <p class="sec-desc">下記エリアにて遺品整理のお伺いが可能です。エリア外の方もまずはご相談ください。</p>
        </div>
        <div class="area-cards fi">
          {areas.map(a => (
            <div class="area-card">
              <h3 class="area-name">{a.name}</h3>
              <p class="area-permit" set:html={a.permit}></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- NOTE -->
    <section class="sec">
      <div class="sec-inner" style="max-width:780px">
        <div class="note-block fi">
          <strong>遺品整理は、ご家族のためのお時間でもあります。</strong><br>
          故人が遺された品々の中には、大切な思い出やご家族の絆を感じる品も含まれます。私たちは、ただ「処分」するのではなく、ご家族のお気持ちに寄り添いながら、一つひとつ丁寧に整理してまいります。お困りごとがありましたら、どんな些細なことでもお気軽にご相談ください。
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-sec fi">
      <h2 class="cta-title">まずはお気軽にご相談ください</h2>
      <p class="cta-desc">現地お見積り・ご相談は無料です。「遺品整理の件で…」とお伝えください。<br>遺品整理士が丁寧にご案内いたします。</p>
      <p class="cta-hours">受付時間 10:00〜17:00（店休日無し）</p>
      <div class="cta-btns">
        <a href="tel:0958654400" class="cta-tel-btn"><Icon name="phone" size={18} />今すぐ電話する</a>
        <a href="/#contact" class="cta-web-btn"><Icon name="mail" size={18} />Webで相談する</a>
        <a href="/estimate/?service=estate" class="cta-web-btn"><Icon name="document" size={18} />仮見積りを依頼する</a>
      </div>
    </section>

  </main>

  <Footer />

  <div class="fixed-cta">
    <a href="tel:0958654400" class="tel-f"><Icon name="phone" size={18} />電話で相談</a>
    <a href="/#contact" class="web-f"><Icon name="mail" size={18} />Webで相談</a>
  </div>
</BaseLayout>

<style>
  :root{--gold:#c8a84b}

  .breadcrumb{background:var(--clight);padding:.65rem 1.5rem;font-size:.78rem;color:var(--light);display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
  .breadcrumb a{color:var(--mid)}
  .breadcrumb a:hover{color:var(--gd)}

  /* ─────────────────────────────────────────
     PAGE HERO(背景画像+ダークグリーンオーバーレイ)
     ───────────────────────────────────────── */
  .page-hero{
    position:relative;
    min-height:480px;
    overflow:hidden;
    background:var(--gd);
    color:#fff;
    display:flex;
    align-items:center;
    padding:5rem 1.5rem;
  }
  .hero-bg{position:absolute;inset:0;z-index:1}
  .hero-bg :global(.hero-img){
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center 35%;
    filter:saturate(0.9) sepia(0.05) brightness(0.95);
  }
  .hero-overlay{
    position:absolute;
    inset:0;
    z-index:2;
    background:linear-gradient(
      100deg,
      rgba(45,90,61,0.85) 0%,
      rgba(45,90,61,0.75) 35%,
      rgba(45,90,61,0.65) 60%,
      rgba(45,90,61,0.45) 100%
    );
  }
  .page-hero-inner{
    position:relative;
    z-index:3;
    max-width:680px;
    width:100%;
    margin:0 auto 0 max(1.5rem,calc((100% - 1100px)/2));
    text-align:left;
  }
  .page-hero-label{font-family:var(--roman);font-size:.78rem;letter-spacing:.25em;opacity:.8;margin-bottom:.6rem}
  .page-hero-title{font-family:var(--serif);font-size:clamp(1.75rem,4vw,2.5rem);font-weight:400;letter-spacing:.1em;margin-bottom:1rem}
  .page-hero-catch{font-family:var(--serif);font-size:clamp(1rem,2vw,1.25rem);font-weight:300;letter-spacing:.08em;color:rgba(255,255,255,.92);margin-bottom:1.25rem;line-height:1.7}
  .page-hero-desc{font-size:.95rem;line-height:2;opacity:.88;max-width:600px}
  .page-hero-badge{
    display:inline-flex;align-items:center;gap:.5rem;
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.25);
    padding:.5rem 1rem;
    font-size:.85rem;margin-top:1.25rem;
    backdrop-filter:blur(4px);
    border-radius:var(--corner);
  }

  /* SEC共通 */
  .sec{padding:5rem 1.5rem}
  .sec-inner{max-width:1100px;margin:0 auto}
  .sec.bg-cream{background:var(--clight)}
  .sec-head{text-align:center;margin-bottom:2.75rem}
  .sec-label{font-family:var(--roman);font-size:.78rem;letter-spacing:.26em;color:var(--gd);margin-bottom:.55rem}
  .sec-title{font-family:var(--serif);font-size:clamp(1.4rem,3vw,1.85rem);font-weight:400;letter-spacing:.1em;margin-bottom:.8rem}
  .sec-desc{font-size:.9rem;color:var(--mid);line-height:2}

  /* FEATURES */
  .features{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}
  .feature{
    background:var(--white);
    border:1px solid var(--border);
    padding:1.85rem 1.35rem;
    text-align:left;
    border-radius:var(--corner);
  }
  .feature-icon{
    color:var(--gd);
    margin-bottom:.85rem;
    width:48px;height:48px;
    background:var(--gl);
    display:flex;align-items:center;justify-content:center;
    border-radius:var(--corner);
  }
  .feature-title{font-family:var(--serif);font-size:1rem;font-weight:400;color:var(--gd);margin-bottom:.6rem;line-height:1.6}
  .feature-desc{font-size:.875rem;line-height:1.9;color:var(--mid)}

  /* PRICE HERO */
  .price-hero{background:linear-gradient(135deg,#2d5a3d,#1e3d2a);color:#fff;padding:4.5rem 1.5rem;text-align:center}
  .price-hero-inner{max-width:720px;margin:0 auto}
  .price-hero-label{font-family:var(--roman);font-size:.875rem;opacity:.7;margin-bottom:.5rem;letter-spacing:.1em}
  .price-hero-name{font-family:var(--serif);font-size:1.5rem;font-weight:400;margin-bottom:.5rem;letter-spacing:.1em}
  .price-big{font-family:var(--num);font-size:clamp(3rem,8vw,5rem);font-weight:300;color:var(--yellow);line-height:1;margin:.5rem 0}
  .price-unit{font-size:1rem;opacity:.85}
  .price-notes{text-align:left;max-width:560px;margin:1.5rem auto 0;padding-left:0}
  .price-notes li{font-size:.875rem;opacity:.85;list-style:none;padding-left:1em;position:relative;margin-bottom:.4rem;line-height:1.85}
  .price-notes li::before{content:'·';position:absolute;left:.2em;opacity:.5}

  /* PROCESS STEPS(横並びグリッド + 角丸カード) */
  .steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem;max-width:1100px;margin:0 auto}
  .step{
    background:var(--white);
    border:1px solid var(--border);
    padding:1.85rem 1.35rem 1.5rem;
    position:relative;
    border-radius:var(--corner);
  }
  .step-num{
    display:inline-flex;align-items:center;justify-content:center;
    width:42px;height:42px;
    background:var(--gd);color:#fff;
    font-family:var(--num);font-size:1.1rem;
    margin-bottom:.95rem;
    border-radius:50%;
  }
  .step-title{
    font-family:var(--serif);font-size:1rem;font-weight:400;color:var(--gd);
    margin-bottom:.65rem;line-height:1.6;
    padding-bottom:.5rem;
    border-bottom:1px solid var(--gm);
  }
  .step-desc{font-size:.875rem;line-height:1.85;color:var(--mid)}

  /* ITEMS */
  .items-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem;max-width:1000px;margin:0 auto}
  .item-card{
    background:var(--white);
    border:1px solid var(--border);
    padding:1.5rem;
    display:flex;gap:1rem;align-items:flex-start;
    border-radius:var(--corner);
  }
  .item-icon{
    color:var(--gd);
    background:var(--gl);
    width:48px;height:48px;
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
    border-radius:var(--corner);
  }
  .item-title{font-family:var(--serif);font-size:1rem;font-weight:400;color:var(--gd);margin-bottom:.4rem}
  .item-desc{font-size:.875rem;line-height:1.85;color:var(--mid)}

  /* PRICE TABLE */
  .price-table-wrap{max-width:780px;margin:0 auto}
  .price-table{
    width:100%;border-collapse:collapse;font-size:.9rem;
    background:var(--white);
    border:1px solid var(--border);
    border-radius:var(--corner);
    overflow:hidden;
  }
  .price-table th{background:var(--gd);color:#fff;padding:.85rem 1.25rem;text-align:left;font-weight:400;font-size:.875rem;letter-spacing:.06em}
  .price-table td{padding:.85rem 1.25rem;border-bottom:1px solid var(--border)}
  .price-table tbody tr:last-child td{border-bottom:none}
