---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCards from '../components/BlogCards.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import heroImage from '../_assets/img/index/hero-family.jpg';
import estimateImage from '../_assets/img/index/estimate-flowers.jpg';

const services = [
  { num:'01', en:'Estate Clearance',         ja:'遺品整理',         desc:'...', tags:['仮見積り対応'], link:'/services/estate/', estimate:true },
  { num:'02', en:'Unwanted Items Removal',   ja:'不用品回収',       desc:'...', tags:['仮見積り対応'], link:'/services/junk/', estimate:true },
  { num:'03', en:'Antique Purchase',         ja:'古物買取',         desc:'...', tags:[], link:'/services/antique/', estimate:false },
  { num:'04', en:'Buddhist Altar & Items',   ja:'仏壇・仏具販売',   desc:'...', tags:['仮見積り対応'], link:'/services/butsudan/', estimate:true },
  { num:'05', en:'Cemetery & Garden Burial', ja:'墓地・霊園ご紹介', desc:'...', tags:[], link:'/services/cemetery/', estimate:false },
  { num:'06', en:'Altar Closing Ceremony',   ja:'仏壇（神棚）じまい', desc:'...', tags:['仮見積り対応'], link:'/services/altar-closing/', estimate:true },
  { num:'07', en:'Altar Remake',             ja:'仏壇リメイク',     desc:'...', tags:['人気サービス','仮見積り対応'], link:'/services/altar-remake/', estimate:true },
  { num:'08', en:'Grave Closure',            ja:'墓じまい',         desc:'...', tags:['仮見積り対応'], link:'/services/grave-closure/', estimate:true },
  { num:'09', en:'Grave Keeping Agency',     ja:'墓守代行サービス', desc:'...', tags:['仮見積り対応'], link:'/services/grave-keeping/', estimate:true },
  { num:'10', en:'Ocean Scattering',         ja:'海洋散骨',         desc:'...', tags:['仮見積り対応'], link:'/services/ocean/', estimate:true },
  { num:'11', en:'Memento Items',            ja:'手元供養品販売',   desc:'...', tags:[], link:'/services/memento/', estimate:false },
  { num:'12', en:'Inheritance Consultation', ja:'相続（不動産）相談', desc:'...', tags:[], link:'/services/inheritance/', estimate:false },
];
---
<BaseLayout>
  <Header />
  <main>

    <!-- HERO -->
    <section class="hero">
      <!-- 背景画像(全画面) -->
      <div class="hero-bg">
        <Image
          src={heroImage}
          alt="家族の温かい時間を大切にする ぶっこうどう のサービス"
          widths={[800, 1200, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
        />
      </div>

      <!-- 右側のダークグリーンオーバーレイ -->
      <div class="hero-overlay"></div>

      <!-- テキストコンテンツ(右側に配置) -->
      <div class="hero-content">
        <p class="hero-label">SERVICE — 葬儀後の供養</p>
        <h1 class="hero-title">
          葬儀後の供養、<br>
          <em>まるごとお任せ</em>ください
        </h1>
        <p class="hero-desc">
          故人を想う気持ちを大切にしながら、<br>
          遺品整理・お墓・仏壇・散骨まで<br>
          専門の窓口がワンストップでサポートいたします。
        </p>
        <div class="hero-btns">
          <a href="#estimate" class="btn-p">まず仮見積りしてみる</a>
          <a href="tel:0120XXXXXX" class="btn-o"><Icon name="phone" size={16} /> 電話で相談する</a>
        </div>
      </div>

      <!-- スクロール促進矢印 -->
      <a href="#services" class="hero-scroll" aria-label="サービス一覧へスクロール">
        <span>SCROLL</span>
        <span class="hero-scroll-arrow"></span>
      </a>
    </section>

    <div class="wave"><svg viewBox="0 0 1440 52" preserveAspectRatio="none" height="52"><path d="M0,26 C360,52 1080,0 1440,26 L1440,52 L0,52 Z" fill="#2d5a3d"/></svg></div>

    <!-- POINTS -->
    <section class="points">
      <div class="pts">
        <div class="pt"><p class="pt-num">POINT 01</p><h3 class="pt-title">ワンストップ対応</h3><p class="pt-desc">遺品整理・お墓・仏壇・散骨まで、複数の業者に連絡する必要はありません。一か所でまとめてご相談いただけます。</p></div>
        <div class="pt"><p class="pt-num">POINT 02</p><h3 class="pt-title">事前に料金の目安が分かる</h3><p class="pt-desc">仮見積りシステムで費用の目安をご確認いただけます。いきなり高額な請求が来ないよう、透明な料金体系を徹底しています。</p></div>
        <div class="pt"><p class="pt-num">POINT 03</p><h3 class="pt-title">何でも気軽に相談できる</h3><p class="pt-desc">「こんなこと聞いていいのかな？」という小さな疑問も大歓迎。どんなことでも丁寧にお答えするスタッフが対応いたします。</p></div>
      </div>
    </section>

    <div class="wave"><svg viewBox="0 0 1440 52" preserveAspectRatio="none" height="52"><path d="M0,26 C360,0 1080,52 1440,26 L1440,0 L0,0 Z" fill="#2d5a3d"/></svg></div>

    <!-- SERVICES -->
    <section class="sec bg-cream" id="services">
      <div class="sec-head fi">
        <p class="sec-label">SERVICES</p>
        <h2 class="sec-title">サービス一覧</h2>
        <p class="sec-desc">葬儀後のさまざまなお悩みに対応する12のサービスをご用意しています。<br>まずはお気軽にご相談ください。</p>
      </div>
      <div class="svc-grid fi">
        {services.map(s => (
          s.link
            ? <a href={s.link} class="svc-card svc-card--link">
                <div class="svc-hd"><span class="svc-num">{s.num}</span><div><p class="svc-title">{s.ja}</p><p class="svc-en">{s.en}</p></div></div>
                <p class="svc-desc">{s.desc}</p>
                <div class="svc-foot">
                  {s.tags.map(t=><span class:list={['tag', t==='人気サービス'?'tag-hot':'tag-new']}>{t}</span>)}
                  <span class="svc-link">詳細・仮見積りへ ›</span>
                </div>
              </a>
            : <div class="svc-card">
                <div class="svc-hd"><span class="svc-num">{s.num}</span><div><p class="svc-title">{s.ja}</p><p class="svc-en">{s.en}</p></div></div>
                <p class="svc-desc">{s.desc}</p>
                <div class="svc-foot">
                  {s.tags.map(t=><span class:list={['tag', t==='人気サービス'?'tag-hot':'tag-new']}>{t}</span>)}
                  <span class="svc-soon">準備中</span>
                </div>
              </div>
        ))}
      </div>
    </section>

    <!-- ESTIMATE -->
    <section class="sec sec-estimate" id="estimate">
      <!-- 背景画像レイヤー -->
      <div class="est-bg">
        <Image
          src={estimateImage}
          alt=""
          widths={[800, 1200, 1600, 2000]}
          sizes="100vw"
          loading="lazy"
          class="est-bg-img"
        />
      </div>
      <!-- ダークグリーン+細かい白ドットのオーバーレイ -->
      <div class="est-overlay"></div>

      <div class="est-inner fi">
        <div>
          <p class="sec-label est-label">QUICK ESTIMATE</p>
          <h2 class="est-head">料金の目安を、今すぐ確認できます</h2>
          <p class="est-desc">いきなり業者に連絡するのは不安…という方でも大丈夫。まずは仮見積りシステムで費用の目安を確認してみてください。</p>
          <p class="est-note">※仮見積りはあくまでも概算です。正式なお見積りは現地確認後に確定いたします。</p>
        </div>
        <div>
          <a href="/estimate/?service=estate"  class="est-item"><span>遺品整理の仮見積り</span><span class="est-arr">›</span></a>
          <a href="/estimate/?service=junk"   class="est-item"><span>不用品回収の仮見積り</span><span class="est-arr">›</span></a>
          <a href="/estimate/?service=grave-closure"   class="est-item"><span>墓じまいの仮見積り</span><span class="est-arr">›</span></a>
          <a href="/estimate/?service=ocean"   class="est-item"><span>海洋散骨の仮見積り</span><span class="est-arr">›</span></a>
          <a href="/estimate/?service=grave-keeping" class="est-item"><span>墓守代行の仮見積り</span><span class="est-arr">›</span></a>
        </div>
      </div>
    </section>

    <!-- BLOG -->
    <section class="sec bg-gl" id="blog">
      <div class="sec-head fi">
        <p class="sec-label">BLOG &amp; NEWS</p>
        <h2 class="sec-title">ブログ・お知らせ</h2>
        <p class="sec-desc">現場の様子やお客様の声、知って得する供養の豆知識をお届けします。</p>
      </div>
      <div class="fi">
        <BlogCards />
        <div class="more-wrap"><a href="/blog" class="btn-more">記事をもっと見る</a></div>
      </div>
    </section>

    <!-- VOICES -->
    <section class="sec" id="voices">
      <div class="sec-head fi">
        <p class="sec-label">CUSTOMER VOICE</p>
        <h2 class="sec-title">お客様の声</h2>
      </div>
      <div class="voices-grid fi">
        {[
          { text:'母が亡くなった後、何をどうすればいいか分からず途方に暮れていました。ぶっこうどうさんに相談したら、遺品整理から仏壇の選定まで全部まとめて対応してくれて本当に助かりました。', name:'K.S様（60代・女性）', service:'遺品整理・仏壇購入' },
          { text:'父の遺志で海洋散骨を選びました。当日のスタッフの方々がとても温かく、家族みんなで穏やかに見送ることができました。事前の説明も丁寧で安心でした。', name:'T.M様（50代・男性）', service:'海洋散骨' },
          { text:'実家の墓じまいを急に依頼したにも関わらず、行政手続きから石材の撤去まで迅速に対応していただきました。費用の目安を最初に提示してくれたのが特に助かりました。', name:'A.F様（40代・女性）', service:'墓じまい' },
        ].map(v => (
          <div class="voice-card">
            <span class="voice-q">"</span>
            <p class="voice-text">{v.text}</p>
            <div class="voice-line"><p class="voice-name">{v.name}</p><p class="voice-svc">{v.service}</p></div>
          </div>
        ))}
      </div>
      <div class="more-wrap" style="text-align:center;margin-top:2rem">
        <a href="/voices/" class="btn-more">すべての声を見る</a>
      </div>
    </section>

    <!-- FLOW -->
    <section class="sec bg-cream" id="flow">
      <div class="sec-head fi">
        <p class="sec-label">HOW TO START</p>
        <h2 class="sec-title">ご相談の流れ</h2>
        <p class="sec-desc">はじめての方でも安心してご利用いただけるよう、丁寧にサポートします。</p>
      </div>
      <div class="flow-steps fi">
        {[
          { n:'1', title:'お電話またはWebでご連絡', desc:'お電話・Webフォームでお気軽にご相談ください。仮見積りシステムで費用の目安もご確認いただけます。どんな小さな疑問でも歓迎です。' },
          { n:'2', title:'ヒアリング・現地確認', desc:'ご要望を詳しくお聞きし、必要に応じて現地調査を行います。個人情報は厳重に管理いたします。' },
          { n:'3', title:'正式お見積り・ご提案', desc:'詳細なお見積りと最適なプランをご提案します。ご納得いただくまで何度でもご相談いただけます。' },
          { n:'4', title:'ご契約・サービス実施', desc:'ご納得いただきましたらご契約。丁寧・迅速にサービスを実施いたします。終了後のアフターフォローもおまかせください。' },
        ].map((f,i) => <>
          <div class="flow-step">
            <div class="step-num"><span>STEP</span><strong>{f.n}</strong></div>
            <div class="step-body"><h3>{f.title}</h3><p>{f.desc}</p></div>
          </div>
          {i<3 && <div class="step-arr">↓</div>}
        </>)}
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact" id="contact">
      <h2 class="contact-title">お問合せ・無料相談</h2>
      <p class="contact-sub">どんな小さなことでも、まずはお気軽にご連絡ください。</p>
      <div class="contact-cards fi">
        <div class="contact-card">
          <h3>お電話でのご相談</h3>
          <p>スタッフが直接ご対応します。<br>お急ぎの場合はお電話が便利です。</p>
          <a href="tel:0120XXXXXX" class="contact-tel">0120-XXX-XXX</a>
          <p class="contact-hours">受付時間 9:00〜18:00（年中無休）</p>
        </div>
        <div class="contact-card">
          <h3>Webからのご相談</h3>
          <p>24時間受付中。内容を確認後、<br>1営業日以内にご連絡いたします。</p>
          <div style="margin-top:1.5rem"><a href="/contact" class="btn-cta-contact">無料相談フォームへ</a></div>
        </div>
      </div>
    </section>

  </main>
  <Footer />

  <!-- モバイル固定CTAバー -->
  <div class="fixed-cta">
    <a href="tel:0120XXXXXX" class="tel-f"><Icon name="phone" size={18} /> 電話で相談</a>
    <a href="#contact" class="web-f"><Icon name="mail" size={18} /> Webで相談</a>
  </div>
</BaseLayout>

<style>
.wave{line-height:0}.wave svg{display:block;width:100%}

/* ─────────────────────────────────────────
   HERO(背景画像+右側ダークグリーンオーバーレイ)
   ───────────────────────────────────────── */
.hero{
  position:relative;
  height:calc(100vh - 60px);  /* ヘッダー高さを除いた残り全て */
  min-height:560px; 
  overflow:hidden;
  background:var(--clight);
}

/* 背景画像レイヤー */
.hero-bg{
  position:absolute;
  inset:0;
  z-index:1;
}
.hero-bg :global(.hero-img){
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center 30%;
  filter:saturate(0.85) sepia(0.08) brightness(1.02);
}

/* 右側ダークグリーングラデーションオーバーレイ
   左:透明 → 右:ダークグリーン濃いめ
   テキストエリアの視認性を確保 */
.hero-overlay{
  position:absolute;
  inset:0;
  z-index:2;
  background:linear-gradient(
    100deg,
    rgba(45,90,61,0)    0%,
    rgba(45,90,61,0)    35%,
    rgba(45,90,61,0.65) 55%,
    rgba(45,90,61,0.92) 80%,
    rgba(45,90,61,0.96) 100%
  );
}

/* テキストコンテンツ(右側に配置) */
.hero-content{
  position:relative;
  z-index:3;
  height:100%;
  max-width:1280px;
  margin:0 auto;
  padding:0 4rem;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:flex-end;
}
.hero-content > *{
  max-width:520px; 
  width:100%;
  color:#fff;
  text-align:left;
}

.hero-label{
  font-family:var(--roman);
  font-size:.78rem;
  letter-spacing:.28em;
  color:rgba(255,255,255,.72);
  margin-bottom:1.5rem;
  text-transform:none;
}

.hero-title{
  font-family:var(--serif);
  font-size:clamp(1.75rem, 3.5vw, 2.8rem);
  font-weight:400;
  line-height:1.65;
  letter-spacing:.08em;
  margin-bottom:1.5rem;
  color:#fff;
}
.hero-title em{
  font-style:normal;
  color:#f5c842; 
  font-weight:500;
}

.hero-desc{
  font-size:clamp(.875rem, 1vw, .95rem);
  line-height:2.1;
  color:rgba(255,255,255,.85);
  margin-bottom:2.5rem;
  letter-spacing:.04em;
}

.hero-btns{
  display:flex;
  gap:1rem;
  flex-wrap:wrap;
  }

/* メインCTA(仮見積り) */
.hero-btns .btn-p{
  background:#f5c842;
  color:var(--gd);
  padding:1rem 1.85rem;
  font-size:.9rem;
  letter-spacing:.08em;
  font-weight:500;
  transition:.2s;
  border:1px solid #f5c842;
  border-radius:50px;
}

/* サブCTA(電話) */
.hero-btns .btn-o{
  display:inline-flex;
  align-items:center;
  gap:.5rem;
  border:1px solid rgba(255,255,255,.55);
  color:#fff;
  background:transparent;
  padding:1rem 1.85rem;
  font-size:.9rem;
  letter-spacing:.08em;
  transition:.2s;
  border-radius:50px;
}
.hero-btns .btn-p:hover,
.hero-btns .btn-o:hover{
  background:rgba(255,255,255,1);
  color:var(--gm);
}

/* スクロール促進矢印(画面下中央) */
.hero-scroll{
  position:absolute;
  bottom:2.75rem;
  left:50%;
  transform:translateX(-50%);
  z-index:4;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:.9rem;
  color:rgba(255,255,255,1);
  font-family:var(--sans);
  font-size:1rem;
  letter-spacing:0.2em;
  text-decoration:none;
  transition:.2s;
}
.hero-scroll:hover{color:#fff}
.hero-scroll-arrow{
  width:0px;
  height:0px;
  background:rgba(255,255,255,1);
  position:relative;
  animation:scrollIndicator 2s ease-in-out infinite;
}
.hero-scroll-arrow::after{
  content:'';
  position:absolute;
  bottom:-1px;
  left:50%;
  transform:translateX(-50%) rotate(45deg);
  width:20px;
  height:20px;
  border-right:1.5px solid rgba(255,255,255,1);
  border-bottom:1.5px solid rgba(255,255,255,1);
}
@keyframes scrollIndicator{
  0%, 100%{opacity:.4; transform:translateY(0)}
  50%     {opacity:1;  transform:translateY(4px)}
}

/* タブレット */
@media(max-width:1024px){
  .hero-content{padding:0 2.5rem}
  .hero-overlay{
    background:linear-gradient(
      100deg,
      rgba(45,90,61,0)    0%,
      rgba(45,90,61,0.3)  30%,
      rgba(45,90,61,0.8)  55%,
      rgba(45,90,61,0.94) 100%
    );
  }
}

/* スマホ */
@media(max-width:768px){
  .hero{
    height:auto;
    min-height:calc(100vh - 60px);
  }
  .hero-bg :global(.hero-img){
    object-position:center 25%;
  }
  /* スマホでは画像全体に薄めの黒、下半分にダーク背景を被せて
     テキストエリアを下部に配置 */
  .hero-overlay{
    background:linear-gradient(
      180deg,
      rgba(45,90,61,0.1)  0%,
      rgba(45,90,61,0.25) 35%,
      rgba(45,90,61,0.85) 65%,
      rgba(45,90,61,0.96) 100%
    );
  }
  .hero-content{
    padding:3rem 1.5rem 5rem;
    align-items:flex-start;
    justify-content:flex-end;  /* 下寄せ */
  }
  .hero-content > *{
    max-width:none;
  }
  .hero-title{line-height:1.55; letter-spacing:.06em}
  .hero-desc br{display:none}
  .hero-btns{flex-direction:column; width:100%;}
  .hero-btns a{text-align:center; width:100%;}
  .hero-scroll{display:none}
}
/* POINTS */
.points{background:var(--gd);padding:3.5rem 1.5rem}
.pts{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;max-width:1100px;margin:0 auto}
.pt{border:1px solid rgba(255,255,255,.2);padding:2rem 1.5rem;text-align:center;color:#fff}
.pt-num{font-family:var(--roman);font-size:.78rem;letter-spacing:.22em;opacity:.55;margin-bottom:.6rem}
.pt-title{font-family:var(--serif);font-size:1rem;font-weight:400;margin-bottom:.8rem}
.pt-desc{font-size:.9rem;line-height:1.95;opacity:.85}
/* SECTION */
.sec{padding:5rem 1.5rem}
.sec.bg-cream{background:var(--clight)}
.sec.bg-gl{background:var(--gl)}
.sec-head{text-align:center;margin-bottom:2.75rem}
.sec-label{font-family:var(--roman);font-size:.78rem;letter-spacing:.26em;color:var(--gd);margin-bottom:.55rem}
.sec-title{font-family:var(--serif);font-size:clamp(1.4rem,3vw,1.85rem);font-weight:400;letter-spacing:.1em;margin-bottom:.8rem}
.sec-desc{font-size:.9rem;color:var(--mid);line-height:2}
/* SERVICES */
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.1rem;max-width:1100px;margin:0 auto}
.svc-card{background:var(--white);border:1px solid var(--border);padding:1.5rem 1.35rem;transition:.2s;display:flex;flex-direction:column}
.svc-card--link:hover{transform:translateY(-2px);border:1px solid var(--gd);border-radius:var(--corner);background:var(--gl);}
.svc-card--link{position:relative}
.svc-hd{display:flex;gap:.85rem;align-items:flex-start;margin-bottom:.85rem}
.svc-num{font-family:var(--num);font-size:3.1rem;color:var(--gl);font-weight:300;line-height:1;min-width:2rem}
.svc-card--link:hover .svc-num{color:var(--gm); transition:.5s ease;}
.svc-title{font-family:var(--serif);font-size:1.3rem;font-weight:400;}
.svc-en{font-family:var(--roman);font-size:.78rem;color:var(--light);letter-spacing:.03em;}
.svc-desc{font-size:.9rem;line-height:1.95;color:var(--mid);margin-bottom:.85rem;flex:1}
.svc-foot{display:flex;align-items:center;flex-wrap:wrap;gap:.4rem;margin-top:auto}
.svc-link{font-size:.875rem;color:var(--gm);margin-left:auto;font-weight:500;padding:0 5px;border-bottom:1px solid var(--gd);}
.svc-soon{font-size:.78rem;color:var(--light);border:1px solid var(--border);padding:.18rem .6rem;margin-left:auto;border-radius:var(--corner);}
.tag{font-size:.78rem;padding:.2rem .6rem;border-radius:var(--corner);}
.svc-card--link:hover .tag{background:#fff;border:1px solid transparent;}
.tag-hot{border:1px solid #c0392b;color:#c0392b;}
.tag-new{border:1px solid var(--gd);color:var(--gd);}
/* ─────────────────────────────────────────
   ESTIMATE(背景画像+ダークグリーン+細かい白ドット)
   ───────────────────────────────────────── */
.sec-estimate{
  position:relative;
  overflow:hidden;
  padding:5rem 1.5rem;
  /* テキストが乗るので、デフォルトの白背景は削除 */
}

/* 背景画像レイヤー(最下層) */
.est-bg{
  position:absolute;
  inset:0;
  z-index:0;
  pointer-events:none;
}
.est-bg :global(.est-bg-img){
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center center;
}

/* ダークグリーン + 細かい白ドット のオーバーレイ
   - 細かい白ドット(上品なテクスチャ)
   - ダークグリーン濃いめのカラー(画像を引き締めつつブランド統一)
   背景の重ね順: 上から書いた順に重なる(最初がいちばん上) */
.est-overlay{
  position:absolute;
  inset:0;
  z-index:1;
  pointer-events:none;
  background:
    /* 一番上: 細かい白ドットのテクスチャ */
    radial-gradient(rgba(255,255,255,0.08) 1px, transparent 1.2px),
    /* 真ん中: ダークグリーンの不透明グラデーション(画像を引き締める) */
    linear-gradient(135deg, rgba(45,90,61,0.92) 0%, rgba(45,90,61,0.88) 50%, rgba(30,61,42,0.94) 100%);
  background-size: 10px 10px, cover;
}

/* コンテンツは最前面 */
.est-inner{
  position:relative;
  z-index:2;
  max-width:1050px;
  margin:0 auto;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:4.5rem;
  align-items:center;
}

/* ─ テキスト周りの色を白系に上書き ─ */

/* ラベル「QUICK ESTIMATE」を金色に */
.est-label{
  color:#f5c842 !important;
  opacity:.9;
}

/* 見出し「料金の目安を、今すぐ確認できます」を白に */
.est-head{
  font-family:var(--serif);
  font-size:clamp(1.15rem, 2.5vw, 1.5rem);
  font-weight:400;
  letter-spacing:.07em;
  margin:.55rem 0 .9rem;
  color:#fff;
  line-height:1.7;
}

/* 説明文を半透明白に */
.est-desc{
  font-size:.9rem;
  line-height:2.05;
  color:rgba(255,255,255,.85);
  margin-bottom:.8rem;
}

/* 注釈を薄めの白に */
.est-note{
  font-size:.875rem;
  color:rgba(255,255,255,.55);
  line-height:1.85;
}

/* ─ リンクボックス: ガラスモーフィズム(半透明・ぼかし) ─ */
.est-item{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:.95rem 1.25rem;
  font-size:.92rem;
  margin-bottom:.7rem;
  color:#fff;
  /* ガラスのような半透明背景 */
  background:rgba(255,255,255,0.08);
  border:1px solid rgba(255,255,255,0.18);
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  transition:.2s ease;
  border-radius:var(--corner);
}
.est-item:hover{
  background:rgba(255,255,255,1);
  border-color:var(--gm);
  transform:translateX(4px);
  color:var(--gm);
}

/* 矢印*/
.est-arr{
  color:var(--cream);
  font-size:1.1rem;
  transition:transform .2s ease;
  border-radius:var(--corner);
}
.est-item:hover .est-arr{
  transform:translateX(3px);
  color:var(--gm);
}
/* BLOG */
.more-wrap{text-align:center;margin-top:2rem}
.btn-more{display:inline-block;border:1px solid var(--gd);color:var(--gd);padding:.78rem 2.65rem;font-size:.875rem;letter-spacing:.08em;transition:.2s;border-radius:var(--corner);}
.btn-more:hover{background:var(--gd);color:#fff;border-radius:var(--corner);}
/* VOICES */
.voices-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.35rem;max-width:1100px;margin:0 auto}
.voice-card{border:1px solid var(--border);padding:1.65rem 1.5rem;position:relative;background:var(--white);border-radius:var(--corner);}
.voice-q{font-family:var(--roman);font-size:2.75rem;color:var(--gd);opacity:.2;position:absolute;top:.3rem;left:1.1rem;line-height:1}
.voice-text{font-size:.9rem;line-height:2.05;color:var(--mid);padding-top:.95rem;margin-bottom:1.1rem}
.voice-line{border-top:1px solid #eee;padding-top:.7rem}
.voice-name{font-size:.875rem;color:var(--gd);font-weight:500;margin-bottom:.2rem}
.voice-svc{font-size:.78rem;color:var(--light)}
/* FLOW */
.flow-steps{max-width:620px;margin:0 auto;}
.flow-step{display:grid;grid-template-columns:72px 1fr;gap:5px;align-items:center;border-radius:var(--corner);padding:18px 20px;background:var(--white);}
.step-num{display:flex;flex-direction:column;align-items:center;justify-content:center;width:62px;height:62px;border-radius:50%;background:var(--gd);color:#fff;text-align:center;flex-shrink:0}
.step-num span{font-family:var(--roman);font-size:.7rem;letter-spacing:.1em;opacity:.75}
.step-num strong{font-family:var(--num);font-size:1.5rem;font-weight:400;line-height:1}
.step-body{padding:.3rem 0 1.85rem;}
.step-body h3{font-family:var(--serif);font-size:1.05rem;font-weight:400;margin-bottom:.48rem;border-bottom:1px solid var(--gm);}
.step-body p{font-size:.9rem;line-height:2;color:var(--mid)}
.step-arr{grid-column:1;text-align:center;font-size:1.15rem;color:var(--gd);opacity:.45;margin:.7rem auto;}
/* CONTACT */
.contact{background:var(--white);padding:5rem 1.5rem;text-align:center}
.contact-title{font-family:var(--serif);font-size:clamp(1.4rem,3vw,1.85rem);font-weight:400;letter-spacing:.1em;margin-bottom:.6rem}
.contact-sub{font-size:.92rem;color:var(--mid);margin-bottom:2.75rem}
.contact-cards{display:grid;grid-template-columns:1fr 1fr;gap:1.35rem;max-width:840px;margin:0 auto}
.contact-card{border:1px solid var(--border);padding:2.4rem 1.85rem}
.contact-card h3{font-family:var(--serif);font-size:1.05rem;font-weight:400;margin-bottom:.9rem}
.contact-card p{font-size:.9rem;line-height:1.95;color:var(--mid)}
.contact-tel{display:block;font-family:var(--num);font-size:2.2rem;color:var(--gd);letter-spacing:.09em;margin:1.1rem 0 .38rem}
.contact-hours{font-size:.78rem;color:var(--light)}
.btn-cta-contact{display:inline-block;background:var(--gd);color:#fff;padding:.9rem 2rem;font-size:.9rem;letter-spacing:.08em;transition:.2s;border-radius:var(--corner);}
.btn-cta-contact:hover{background:var(--gm)}
/* MOBILE FIXED */
.fixed-cta{display:none}
@media(max-width:768px){
  .fixed-cta{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:150}
  .fixed-cta a{flex:1;display:flex;align-items:center;justify-content:center;padding:1rem;font-size:.92rem;gap:.4rem;font-weight:500}
  .tel-f{background:var(--gd);color:#fff}
  .web-f{background:#333;color:#fff}
  body{padding-bottom:52px}
}
/* RESPONSIVE */
@media(max-width:1024px){
  .svc-grid{grid-template-columns:repeat(2,1fr)}
  .voices-grid{grid-template-columns:repeat(2,1fr);}
  .est-inner{gap:2.75rem}
}
@media(max-width:768px){
  .hero{grid-template-columns:1fr;min-height:auto}
  .hero-visual{order:-1;min-height:220px;padding:1.5rem}
  .hero-content{padding:2rem 1.25rem 2.5rem}
  .hero-title{font-size:1.5rem}
  .hero-btns{flex-direction:column;gap:.65rem;}
  .btn-p,.btn-o{width:100%;text-align:center;padding:.8rem 1rem}
  .wave svg{height:32px}
  .points{padding:2.5rem 1rem}
  .pts{grid-template-columns:1fr}
  .sec{padding:3.5rem 1rem}
  .sec-estimate{padding:3.5rem 1rem}
  .svc-grid{grid-template-columns:1fr}
  .svc-card--link::after{display:none}
  .est-inner{grid-template-columns:1fr;gap:2rem}
  .est-item{padding:.85rem 1rem}
  .voices-grid{grid-template-columns:1fr}
  .contact{padding:3.5rem 1rem}
  .contact-cards{grid-template-columns:1fr}
  .contact-card{padding:1.75rem 1.35rem}
  .contact-tel{font-size:1.6rem}
}
@media(max-width:480px){
  .hero-title{font-size:1.35rem}
}
</style>

<script>
const obs = new IntersectionObserver(e => {
  e.forEach(x => { if(x.isIntersecting){ x.target.classList.add('fade-in'); obs.unobserve(x.target); }});
}, { threshold: 0.1 });
document.querySelectorAll('.fi').forEach(el => { el.classList.add('fade-init'); obs.observe(el); });
</script>
