---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import { pricing, formatYen, formatYenWithTax } from '../../data/pricing';
import { SITE } from '../../data/site';
import ktraImg from '../../_assets/img/estimate/ktra.png';
const estatePricing = pricing.find(s => s.serviceKey === 'estate');
const estatePlans = estatePricing?.plans ?? []; // 見つからない場合は空配列

// シミュレーターに出す「選べるサービス」= estate 以外。
const simulatorServices = pricing
  .map((s, i) => ({ ...s, no: i + 1 })) // no: 1,2,3,4
  .filter(s => s.serviceKey !== 'estate');
---

<BaseLayout
  title={`仮見積りシミュレーション | ${SITE.fullName}`}
  description="遺品整理・不用品回収・墓じまい・海洋散骨の概算料金をその場でシミュレーションできます。複数サービスの合計金額も確認できます。"
>
  <Header />
  <main>

    <div class="breadcrumb">
      <a href="/">ホーム</a><span>›</span>
      <span>仮見積りシミュレーション</span>
    </div>

    <!-- PAGE HEAD -->
    <section class="page-head">
      <div class="page-head-inner fi">
        <p class="page-label">QUICK ESTIMATE</p>
        <h1 class="page-title">仮見積りシミュレーション</h1>
        <p class="page-desc">
          ご希望のサービスにチェックを入れ、プランをお選びください。<br>
          複数のサービスを組み合わせて、合計金額の概算をその場で確認できます。
        </p>
        
      </div>
      
    </section>

    <!-- SIMULATOR -->
    <section class="sim-sec">
      <div class="sim-layout">

        <!-- 左側:質問エリア -->
        <div class="sim-questions">

{simulatorServices.map((service) => (
          <>
            <div class="q-block" data-service={service.serviceKey}>
        
              <!-- サービス選択チェックボックス -->
              <label class="q-head">
                <input
                  type="checkbox"
                  class="q-check"
                  data-service-check={service.serviceKey}
                />
                <span class="q-check-box" aria-hidden="true"></span>
                <span class="q-head-text">
                  <span class="q-num">SERVICE 0{service.no}</span>
                  <span class="q-title">{service.serviceLabel}</span>
                </span>
                <a href={service.serviceUrl} class="q-detail-link" target="_blank" rel="noopener">サービス詳細</a>
              </label>
        
              <!-- プラン選択(チェックボックスがONの時のみ表示) -->
              <div class="q-body" data-body={service.serviceKey} hidden>
              <span class="ref-table-title">参考料金</span>
                {/* サービス2(不用品回収)のときだけ、プラン一覧の上に遺品整理の参考ブロックを出す */}
                {service.serviceKey === 'junk' && (
                  <div class="ref-block">
                    {/* 参考写真 */}
                    <figure class="ref-photo">
                      <Image
                        src={ktraImg}
                        alt="遺品整理の作業風景（参考）"
                        widths={[400, 800]}
                        sizes="(max-width:768px) 100vw, 340px"
                        class="ref-photo-img"
                      />
                    </figure>

                    {/* 遺品整理の参考料金表（estatePlans から生成） */}
                    <div class="ref-table-wrap">
                      <table class="ref-table">
                        <thead>
                          <tr>
                            <th>間取り</th>
                            <th>広さ</th>
                            <th>料金（税込）</th>
                          </tr>
                        </thead>
                        <tbody>
                          {estatePlans.map(plan => (
                            <tr>
                              <td>{plan.label}</td>
                              <td class="ref-td-sub">{plan.size}</td>
                              <td class="ref-td-price">{formatYen(plan.price)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                      <p class="ref-table-note">※遺品整理は内容により変動します。詳しくはお問い合わせください。</p>
                    </div>
                  </div>
                )}
                <p class="q-label">{service.questionLabel}</p>
                <div class="plan-list">
                  {service.plans.map(plan => (
                    plan.qty ? (
                      // 数量入力式プラン（エンゼル号）：単価 × 台数
                      <div class="plan-item plan-item-qty" data-qty-plan={plan.id}>
                        <span class="plan-content">
                          <span class="plan-label-row">
                            <span class="plan-label">{plan.label}</span>
                            {plan.popular && <span class="plan-popular">人気</span>}
                          </span>
                          {plan.size && <span class="plan-size">{plan.size}</span>}
                          <span class="plan-unit-price">1台あたり {formatYenWithTax(plan.price)}</span>
                          <span class="plan-subtotal" data-qty-subtotal></span>
                        </span>
                        <span class="qty-control">
                          <button type="button" class="qty-btn" data-qty-minus aria-label="1台減らす">−</button>
                          <input
                            type="number"
                            class="qty-input"
                            value="1"
                            min="0"
                            inputmode="numeric"
                            data-price={plan.price}
                            data-plan={plan.id}
                            data-service-key={service.serviceKey}
                            aria-label="台数"
                          />
                          <button type="button" class="qty-btn" data-qty-plus aria-label="1台増やす">＋</button>
                          <span class="qty-suffix">台</span>
                        </span>
                      </div>
                    ) : (
                      // 通常プラン：チェックボックス（複数選択で合算）
                      <label class="plan-item">
                        <input
                          type="checkbox"
                          name={`plan-${service.serviceKey}`}
                          value={plan.id}
                          data-price={plan.price}
                          data-plan={plan.id}
                          data-service-key={service.serviceKey}
                        />
                        <span class="plan-check" aria-hidden="true"></span>
                        <span class="plan-content">
                          <span class="plan-label-row">
                            <span class="plan-label">{plan.label}</span>
                            {plan.popular && <span class="plan-popular">人気</span>}
                          </span>
                          {plan.size && <span class="plan-size">{plan.size}</span>}
                          {plan.time && <span class="plan-time">{plan.time}</span>}
                        </span>
                        <span class="plan-price">{formatYenWithTax(plan.price)}</span>
                      </label>
                    )
                  ))}
                      </div>
                  
                      {/* このサービスに notes があるときだけ、料金表下の注意書きを ※ 付きで表示する */}
                      {service.notes && service.notes.length > 0 && (
                        <ul class="plan-notes">
                          {service.notes.map(note => (
                            <li>{note}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </div>
                  </>
                  ))}                
                  </div>
                  
                  <!-- 右側:結果サマリー(sticky) -->
                  <aside class="sim-result">
          <div class="result-card">
            <p class="result-label">YOUR ESTIMATE</p>
            <h2 class="result-title">お見積り概算</h2>
            <div class="result-items" id="resultItems">
              <p class="result-empty">サービスを選択してください</p>
            </div>
            <div class="result-summary" id="resultSummary" hidden>
              <div class="result-total" id="resultTotal">
                <p class="total-label">合計（税込）</p>
                <p class="total-price">
                  <span class="total-num js-total" id="totalNum">0</span><span class="total-unit">円〜</span>
                </p>
                <p class="total-note">※あくまで概算金額です</p>
              </div>

              
              <div class="result-cta" id="resultCta">
                <a href="/contact/#contact-form" class="cta-primary">
                  <Icon name="mail" size={16} />
                  この内容で問い合わせる
                </a>
                <a href="tel:0958654400" class="cta-secondary">
                          <Icon name="phone" size={16} />
                          電話で相談する
                        </a>
                      </div>
                    </div>
                
                    <!-- 未選択でも常に表示 -->
                    <div class="sim-notice">
                      <h3 class="notice-title">シミュレーションについてのご注意</h3>
                      <ul class="sim-notice-list">
                        <li><p class="bold">表示金額は概算</p>であり、<p class="under">実際の料金は現地確認後の正式お見積りにて確定</p>いたします</li>
                        <li>お部屋の状況・搬出経路・お墓の立地などにより、追加費用が発生する場合があります</li>
                        <li>停車場所から御当家まで距離がある場合、人件費をいただく場合があります。</li>
                        <li>リサイクル料金・人件費等の別途料金が発生する場合があります。詳細についてはおたずねください。</li>
                        <li>少量の回収品においては、金額等ご相談に応じます。</li>
                        <li>なお、<p class="under">生ゴミ等</p>についてはご遠慮ください。</li>
                        <li>「不要品」については【当日処分】となりますのでご了承ください。</li>
                      </ul>
                    </div>
                  </div>
                </aside>
      </div>
      <!-- 注意事項 -->
    </section>

    <!-- CONTACT FORM ANCHOR(将来お問合せフォームを設置する場所) -->
    <section class="cta-sec" id="contact-form">
      <h2 class="cta-title">この内容でお問合せ・正式見積りをご依頼ください</h2>
      <p class="cta-desc">シミュレーション結果をもとに、現地確認のうえ正式なお見積りをご提示いたします。<br>「シミュレーション結果を見ました」とお伝えいただければスムーズです。</p>
      <p class="cta-hours">受付時間 10:00〜17:00（店休日無し）</p>
      <div class="cta-btns">
        <a href="tel:0958654400" class="cta-tel-btn"><Icon name="phone" size={18} />今すぐ電話する</a>
        <a href="/#contact" class="cta-web-btn"><Icon name="mail" size={18} />Webで相談する</a>
      </div>
    </section>

    <!-- SP専用：問い合わせ前に注意事項を確認するモーダル。本文はJSでパネルの注意書きを複製して入れる -->
    <div class="estimate-modal" data-estimate-modal aria-hidden="true">
      <div class="estimate-modal-panel" role="dialog" aria-modal="true" aria-labelledby="estimateModalTitle">
        <button type="button" class="estimate-modal-close" data-estimate-modal-close aria-label="閉じる">×</button>
        <h2 class="estimate-modal-title" id="estimateModalTitle">お問い合わせ前にご確認ください</h2>
        <div class="estimate-modal-body"><!-- ここにJSで注意書きが入ります --></div>
        <a href="/contact/#contact-form" class="estimate-modal-cta">この内容で問い合わせる</a>
      </div>
    </div>

  </main>
  <Footer />

</BaseLayout>

<style>
  .breadcrumb{background:var(--clight);padding:.65rem 1.5rem;font-size:.78rem;color:var(--light);display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
  .breadcrumb a{color:var(--mid)}
  .breadcrumb a:hover{color:var(--gd)}

  /* PAGE HEAD */
  .page-head{padding:4rem 1.5rem 3rem;text-align:center;background:var(--white)}
  .page-head-inner{max-width:780px;margin:0 auto}
  .page-label{font-family:var(--roman);font-size:.78rem;letter-spacing:0;color:var(--gd);margin-bottom:.6rem}
  .page-title{font-family:var(--serif);font-size:clamp(1.6rem,3.5vw,2.1rem);font-weight:400;letter-spacing:.1em;margin-bottom:1.1rem}
  .page-desc{font-size:.9rem;color:var(--mid);line-height:2.05;}
  .page-notice{display:inline-flex;align-items:center;gap:.5rem;background:#fffbf0;border:1px solid var(--gold,#c8a84b);color:var(--mid);font-size:.8rem;padding:.55rem 1.1rem;margin-top:1.5rem;border-radius:var(--corner);line-height:1.65}

  /* SIMULATOR LAYOUT(2カラム) */
  .sim-sec{padding:3rem 1.5rem 5rem;background:var(--clight)}
  .sim-layout{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 360px;gap:2rem;align-items:flex-start}

  /* 左:質問エリア */
  .sim-questions{display:flex;flex-direction:column;gap:1rem}

  .q-block{background:var(--white);border:1px solid var(--border);border-radius:var(--corner);overflow:hidden;transition:.2s}
  .q-block:has(.q-check:checked){border-color:var(--gd)}

  /* チェックボックスヘッダ */
  .q-head{display:flex;align-items:center;gap:.9rem;padding:1.15rem 1.35rem;cursor:pointer;transition:.2s;flex-wrap:wrap}
  .q-head:hover{background:var(--gl)}
  .q-check{position:absolute;opacity:0;pointer-events:none}
  .q-check-box{width:22px;height:22px;border:2px solid var(--border);border-radius:var(--corner);position:relative;flex-shrink:0;transition:.2s;background:var(--white)}
  .q-check:checked + .q-check-box{background:var(--gd);border-color:var(--gd)}
  .q-check:checked + .q-check-box::after{content:'';position:absolute;left:6px;top:2px;width:6px;height:11px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}
  .q-head-text{display:flex;flex-direction:column;gap:.18rem;flex:1;min-width:0}
  .q-num{font-family:var(--roman);font-size:.7rem;letter-spacing:0;color:var(--light)}
  .q-title{font-family:var(--serif);font-size:1.05rem;font-weight:400;color:var(--text);letter-spacing:.04em}
  .q-detail-link{font-size:.75rem;color:var(--mid);text-decoration:underline;text-underline-offset:3px;transition:.2s;flex-shrink:0}
  .q-detail-link:hover{color:var(--gd)}

  /* プラン選択エリア */
  .q-body{border-top:1px solid var(--border);padding:1.25rem 1.35rem;background:var(--clight)}
  .q-label{font-size:.85rem;color:var(--mid);margin-bottom:.85rem;font-weight:500}
  .plan-list{display:flex;flex-direction:column;gap:.5rem}

  .plan-item{display:grid;grid-template-columns:auto 1fr auto;gap:.9rem;align-items:center;padding:.85rem 1rem;background:var(--white);border:1px solid var(--border);border-radius:var(--corner);cursor:pointer;transition:.15s}
.plan-item:not(.plan-item-qty):hover {
    border-color: var(--gd);
    background: var(--gl);
  }
  .plan-item input{position:absolute;opacity:0;pointer-events:none}
  .plan-radio{width:18px;height:18px;border:2px solid var(--border);border-radius:50%;flex-shrink:0;position:relative;transition:.2s;background:var(--white)}
  .plan-item input:checked + .plan-radio{border-color:var(--gd)}
  .plan-item input:checked + .plan-radio::after{content:'';position:absolute;inset:3px;background:var(--gd);border-radius:50%}

  .plan-check{width:18px;height:18px;border:2px solid var(--border);border-radius:var(--corner);flex-shrink:0;position:relative;transition:.2s;background:var(--white)}
  .plan-item input:checked + .plan-check{border-color:var(--gd);background:var(--gd)}
  .plan-item input:checked + .plan-check::after{content:'';position:absolute;left:5px;top:1px;width:5px;height:9px;border:solid var(--white);border-width:0 2px 2px 0;transform:rotate(45deg)}

  .plan-item:has(input:checked),
  .plan-item.is-selected{border-color:var(--gd);background:var(--gl)}

  .plan-content{display:flex;flex-direction:column;gap:.15rem;min-width:0}
  .plan-label-row{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
  .plan-label{font-family:var(--serif);font-size:.95rem;color:var(--text);letter-spacing:.02em}
  .plan-popular{display:inline-block;border:1px solid var(--gold,#c8a84b);color:var(--gold,#c8a84b);font-size:.65rem;padding:.05rem .4rem;border-radius:var(--corner);letter-spacing:0}
  .plan-size{font-size:.75rem;color:var(--light)}
  .plan-time{font-size:.7rem;color:var(--light)}
  .plan-price{font-family:var(--num);font-size:.95rem;color:var(--gd);font-weight:500;white-space:nowrap}

  .plan-item-qty{grid-template-columns:1fr auto;cursor:default}
  .plan-item-qty:not(.is-selected),
  .plan-item-qty:not(.is-selected):hover{border-color:var(--border);background:var(--white)}
  .plan-unit-price{font-family:var(--num);font-size:.8rem;color:var(--gd)}
  .plan-subtotal{font-family:var(--num);font-size:.85rem;color:var(--gd);font-weight:500}
  .qty-control{display:flex;align-items:center;gap:.4rem}
  .qty-btn{width:32px;height:32px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.1rem;line-height:1;color:var(--gd);background:var(--white);border:1px solid var(--border);border-radius:var(--corner);cursor:pointer;transition:.15s}
  .qty-btn:hover{border-color:var(--gd);background:var(--gl)}
  .qty-input{width:48px;height:32px;text-align:center;font-family:var(--num);font-size:.95rem;color:var(--text);border:1px solid var(--border);border-radius:var(--corner);background:var(--white)}
  .qty-suffix{font-size:.8rem;color:var(--mid)}
  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  .qty-input[type=number]{-moz-appearance:textfield}

  /* 右:結果サマリー(sticky) */
  :global(.sim-result){position:sticky;top:1.5rem}
  :global(.result-card){background:linear-gradient(135deg,#2d5a3d,#1e3d2a);color:#fff;padding:1.85rem 1.5rem;border-radius:var(--corner)}
  :global(.result-label){font-family:var(--roman);font-size:.72rem;letter-spacing:0;opacity:.6;margin-bottom:.45rem}
  :global(.result-title){font-family:var(--serif);font-size:1.2rem;font-weight:400;letter-spacing:.06em;margin-bottom:1.2rem;padding-bottom:1.1rem;border-bottom:1px solid rgba(255,255,255,.18)}

  :global(.result-empty){font-size:.85rem;opacity:.6;line-height:1.85;text-align:center;padding:1.5rem 0}

  :global(.result-items){margin-bottom:1.1rem;display:flex;flex-direction:column;gap:.65rem}
  :global(.result-item){display:flex;flex-direction:column;gap:.15rem;padding:.7rem .85rem;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:var(--corner);font-size:.82rem}
  :global(.result-item-service){font-size:.7rem;opacity:.6;letter-spacing:.04em}
  :global(.result-item-row){display:flex;justify-content:space-between;align-items:center;gap:.5rem;margin-top:.18rem}
 :global( .result-item-plan){font-family:var(--serif);font-size:.85rem;letter-spacing:.02em}
  :global(.result-item-price){font-family:var(--num);font-size:.92rem;color:var(--yellow,#f5c842);white-space:nowrap}

 :global(.result-total){border-top:1px solid rgba(255,255,255,.18);padding-top:1.1rem;text-align:center}
 :global(.total-label){font-family:var(--roman);font-size:.72rem;opacity:.7;letter-spacing:0;margin-bottom:.3rem}
 :global(.total-price){margin-bottom:.55rem}
 :global(.total-num){font-family:var(--num);font-size:2.4rem;color:var(--yellow,#f5c842);font-weight:300;letter-spacing:.02em;line-height:1}
:global(.total-unit){font-size:.85rem;opacity:.85;margin-left:.18rem}
:global(.total-note){font-size:.7rem;opacity:.55}

  :global(.result-cta){margin-top:1.5rem;display:flex;flex-direction:column;gap:.55rem}
  :global(.result-summary[hidden]){display:none}
  :global(.cta-primary){display:inline-flex;align-items:center;justify-content:center;gap:.5rem;background:var(--yellow,#f5c842);color:var(--gd);padding:.85rem 1.25rem;font-size:.88rem;font-weight:500;letter-spacing:0;transition:.2s;border-radius:var(--corner)}
  :global(.cta-primary:hover){background:#e8b835}
  :global(.cta-secondary){display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border:1px solid rgba(255,255,255,.5);color:#fff;padding:.85rem 1.25rem;font-size:.85rem;letter-spacing:0;transition:.2s;border-radius:var(--corner)}
  :global(.cta-secondary:hover){background:rgba(255,255,255,.1)}

  /* NOTICE */
  .notice-inner{background:#fffbf0;border-left:3px solid var(--gold,#c8a84b);padding:1.5rem 1.75rem;border-radius:var(--corner)}
  .notice-title{font-family:var(--serif);font-size:1rem;color:var(--gd);font-weight:400;margin-bottom:.75rem}
  .notice-inner ul{list-style:none;padding:0 0 0 5rem;}
  .notice-inner li{font-size:.82rem;color:var(--mid);line-height:1.95;padding:.15rem 0 .15rem 1em;position:relative;text-align:left;}
  .notice-inner li::before{content:'·';position:absolute;left:.25em;color:var(--gd);font-weight:700}

  /* CTA SEC */
  .cta-sec{background:var(--gd);color:#fff;padding:5rem 1.5rem;text-align:center}
  .cta-title{font-family:var(--serif);font-size:clamp(1.3rem,2.8vw,1.7rem);font-weight:400;letter-spacing:.08em;margin-bottom:1.25rem;line-height:1.65}
  .cta-desc{font-size:.9rem;opacity:.85;margin-bottom:.75rem;line-height:2}
  .cta-hours{font-size:.78rem;opacity:.7;margin-bottom:2.25rem}
  .cta-btns{display:flex;justify-content:center;gap:1rem;flex-wrap:wrap}
  .cta-tel-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;background:#fff;color:var(--gd);padding:.95rem 2.5rem;font-size:.95rem;font-family:var(--roman);letter-spacing:0;transition:.2s;border-radius:var(--corner)}
  .cta-tel-btn:hover{background:var(--gl)}
  .cta-web-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;border:1px solid rgba(255,255,255,.5);color:#fff;padding:.95rem 2.5rem;font-size:.9rem;letter-spacing:0;transition:.2s;border-radius:var(--corner)}
  .cta-web-btn:hover{background:rgba(255,255,255,.1)}
  .ref-block{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;align-items:start;margin-bottom:1.5rem;padding:1.35rem;background:var(--white);border:1px solid var(--border);border-radius:var(--corner)}
  
  .ref-photo{margin:0}
  .ref-photo :global(.ref-photo-img){width:100%;height:100%;aspect-ratio:3/2;object-fit:cover;border-radius:var(--corner);display:block}
  .ref-table-wrap{min-width:0}
  .ref-table-head{display:flex;flex-direction:column;gap:.15rem;margin-bottom:.7rem}
  .ref-table-num{font-family:var(--roman);font-size:.7rem;letter-spacing:0;color:var(--light)}
  .ref-table-title{font-family:var(--serif);font-size:1.05rem;font-weight:400;color:var(--text);letter-spacing:.04em}
  .ref-table{width:100%;border-collapse:collapse;font-size:.82rem;background:var(--white);border:1px solid var(--border);border-radius:var(--corner);overflow:hidden}
  .ref-table th{background:var(--gd);color:#fff;padding:.5rem .7rem;text-align:left;font-weight:400;font-size:.78rem;letter-spacing:0}
  .ref-table td{padding:.5rem .7rem;border-bottom:1px solid var(--border)}
  .ref-table tbody tr:last-child td{border-bottom:none}
  .ref-td-sub{font-size:.72rem;color:var(--light)}
  .ref-td-price{font-family:var(--num);color:var(--gd);white-space:nowrap}
  .ref-table-note{font-size:.72rem;color:var(--light);margin-top:.6rem;line-height:1.7}
  
  /* サービスごとの注意書き（pricing.ts の notes を表示） */
  .plan-notes {
    margin: 0.85rem 0 0;
    padding: 1rem;
    list-style: none;
    width:100%;
    background:var(--white); 
    birder-radius:4px;
    border:1px solid var(--yellow); 
  }
  .plan-notes li {
    position: relative;
    font-size: .88rem;
    line-height: 1.85;
    color: var(--gm); 
    padding-left: 1rem;
    
    
  }
  .plan-notes li::before {
    content: "※";
    position: absolute;
    left: 0rem;
  }
  .sim-notice{margin-top:1rem;background:#fffbf0;border-left:3px solid var(--gold,#c8a84b);border-radius:var(--corner);padding:1.1rem 1.25rem}
  .sim-notice .notice-title{font-size:.9rem;margin-bottom:.55rem}
  .sim-notice-list{list-style:none;padding:0;margin:0}
  .sim-notice-list li{position:relative;padding-left:1em;font-size:.78rem;color:var(--mid);line-height:1.8}
  .sim-notice-list li::before{content:'・';position:absolute;left:0;color:var(--gd);font-weight:700}
  .result-card .sim-notice{margin-top:1.2rem;background:rgba(255,255,255,.08);border-left-color:var(--yellow,#f5c842)}
  .result-card .sim-notice .notice-title{color:#fff}
  .result-card .sim-notice-list li{color:rgba(255,255,255,.85)}
  .result-card .sim-notice-list li::before{color:var(--yellow,#f5c842)}
  
  .bold{font-weight:bold;text-decoration:underline;display:inline;}
  .under{text-decoration:underline;display:inline;}
  
  .estimate-modal{position:fixed;inset:0;z-index:200;display:flex;align-items:flex-end;justify-content:center;background:rgba(0,0,0,.5);opacity:0;visibility:hidden;transition:opacity .2s ease,visibility .2s ease}
  .estimate-modal.is-open{opacity:1;visibility:visible}
  .estimate-modal-panel{position:relative;width:100%;max-width:520px;max-height:85vh;overflow-y:auto;background:var(--white);border-radius:var(--corner) var(--corner) 0 0;padding:1.85rem 1.35rem 1.5rem}
  .estimate-modal-close{position:absolute;top:.5rem;right:.7rem;width:34px;height:34px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;line-height:1;color:var(--mid);background:none;border:none;cursor:pointer}
  .estimate-modal-title{font-family:var(--serif);font-size:1.1rem;font-weight:400;color:var(--gd);margin-bottom:1rem;padding-right:2rem}
  .estimate-modal-body{margin-bottom:1.35rem}
  .estimate-modal-cta{display:flex;align-items:center;justify-content:center;background:var(--gd);color:#fff;padding:.95rem 1.25rem;font-size:.95rem;font-weight:500;border-radius:var(--corner);width:100%}
  .estimate-modal-cta:hover{background:var(--gm)}
  @media (prefers-reduced-motion: reduce){.estimate-modal{transition:none}}
  @media(max-width:1024px){
    .sim-layout{grid-template-columns:1fr;gap:1.5rem}
    .sim-result{position:relative;top:auto;order:-1}
  }
  @media(max-width:768px){
    .sim-notice{display:none}
    .sim-result { display: block; position: static; order: 0; }
    .result-summary {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
      display: flex; align-items: center; gap: 12px;
      padding: 10px 14px;
      background: var(--white); border-top: 2px solid var(--gm);
      color:var(--gm);
    }
    .result-total { border-top: none; padding-top: 0; margin: 0; text-align: left; }
    .total-label { margin-bottom: 0; font-size: .9rem;font-weight:bold; }
    .total-price { margin-bottom: 0; }
    .total-num { font-size: 2rem;color:var(--gm);font-weight:bold; }
    .total-note { display: none; }
    .result-cta { margin: 0 0 0 auto; flex-direction: row;}
    .cta-secondary { display: none; }
    .cta-primary { padding: .7rem 1.1rem; white-space: nowrap;background:var(--yellow); color:var(--gm);}
    .sim-layout { padding-bottom: 96px; }
    .page-head{padding:2.75rem 1rem 2.25rem}
    .sim-sec{padding:2rem 1rem 3.5rem;--sp-notice-top:0px}
    .sim-notice{display:none}
    .sim-notice-head{padding:.7rem 1rem;cursor:pointer}
    .sim-notice-arrow{display:block;width:0;height:0;flex-shrink:0;border-left:5px solid transparent;border-right:5px solid transparent;border-top:6px solid var(--gd);transition:transform .2s ease}
    .sim-notice.is-open .sim-notice-arrow{transform:rotate(180deg)}
    .sim-notice-body{margin:0;max-height:0;overflow:hidden;transition:max-height .25s ease}
    .sim-notice.is-open .sim-notice-body{max-height:60vh;overflow-y:auto}
    .sim-notice-list{padding:.2rem 1rem .9rem}
    .sim-form {
      padding-bottom: 92px;
    }
    .q-block{scroll-margin-top:calc(var(--sp-notice-top) + 60px)}
    .q-head{padding:1rem 1.15rem;gap:.7rem}
    .q-body{padding:1rem 1.15rem}
    .plan-item{padding:.7rem .85rem;gap:.7rem}
    .plan-label{font-size:.88rem}
    .plan-price{font-size:.85rem}
    .result-card{padding:1.5rem 1.25rem}
    .notice-inner{padding:1.25rem 1.35rem}
    .notice-inner ul{padding:0rem;}
    .cta-sec{padding:3.5rem 1rem}
    .cta-btns{flex-direction:column;align-items:stretch;max-width:320px;margin:0 auto}
    
    .ref-block{grid-template-columns:1fr}
  }
</style>

<script>
  type SelectedPlan = {
    planId: string;
    serviceKey: string;
    serviceLabel: string;
    planLabel: string;
    price: number;
  };

  const state = new Map<string, SelectedPlan>(); 
  const serviceChecks = document.querySelectorAll<HTMLInputElement>('.q-check');
  serviceChecks.forEach(check => {
    check.addEventListener('change', () => {
      const key = check.dataset.serviceCheck;
      if (!key) return;
      const body = document.querySelector<HTMLElement>(`[data-body="${key}"]`);

      if (check.checked) {
        body?.removeAttribute('hidden');
        body?.querySelectorAll<HTMLInputElement>('.qty-input').forEach(syncQtyPlan);
      } else {
        body?.setAttribute('hidden', '');
        clearService(key, body);
      }
      updateResult();
    });
  });


  function clearService(key: string, body: HTMLElement | null) {
    const inputs = body
      ? body.querySelectorAll<HTMLInputElement>('input[data-plan]')
      : document.querySelectorAll<HTMLInputElement>(`input[data-service-key="${key}"][data-plan]`);
    inputs.forEach(input => {
      const planId = input.dataset.plan;
      if (planId) state.delete(planId);
      if (input.type === 'checkbox') input.checked = false;
    });
  }

  // ── 通常プラン（チェックボックス）: 複数選択して合算 ──
  const planChecks = document.querySelectorAll<HTMLInputElement>('.plan-item input[type="checkbox"]');
  planChecks.forEach(box => {
    box.addEventListener('change', () => {
      const planId = box.dataset.plan ?? '';
      if (!planId) return;
      if (box.checked) {
        state.set(planId, buildPlan(box));
      } else {
        state.delete(planId);
      }
      updateResult();
    });
  });

  // チェックボックスのプラン入力から、明細1件分のデータを作る
  function buildPlan(input: HTMLInputElement): SelectedPlan {
    const planId = input.dataset.plan ?? '';
    const serviceKey = input.dataset.serviceKey ?? '';
    const price = Number(input.dataset.price ?? '0');
    const planLabel = input.closest('.plan-item')?.querySelector('.plan-label')?.textContent?.trim() ?? '';
    const serviceLabel = input.closest('.q-block')?.querySelector('.q-title')?.textContent?.trim() ?? '';
    return { planId, serviceKey, serviceLabel, planLabel, price };
  }

  // ── 台数入力プラン（エンゼル号）: 単価 × 台数 ──

  const qtyInputs = document.querySelectorAll<HTMLInputElement>('.qty-input');
  qtyInputs.forEach(input => {
    input.addEventListener('input', () => { syncQtyPlan(input); updateResult(); });
  });

  // ＋ / − ボタン
  const qtyButtons = document.querySelectorAll<HTMLButtonElement>('[data-qty-plus], [data-qty-minus]');
  qtyButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const input = btn.closest('.qty-control')?.querySelector<HTMLInputElement>('.qty-input');
      if (!input) return;
      const current = Number(input.value || '0');
      const min = Number(input.min || '0');
      
      const next = btn.hasAttribute('data-qty-plus') ? current + 1 : Math.max(min, current - 1);
      input.value = String(next);
      
      syncQtyPlan(input);
      updateResult();
    });
  });

  
  function syncQtyPlan(input: HTMLInputElement) {
    const planId = input.dataset.plan ?? '';
    if (!planId) return;
    const serviceKey = input.dataset.serviceKey ?? '';
    const unitPrice = Number(input.dataset.price ?? '0');
    const min = Number(input.min || '0');
    let qty = Number(input.value || '0');
    if (isNaN(qty) || qty < min) qty = min;   // 不正入力・下限割れを補正

    if (qty <= 0) {
    state.delete(planId);
    
    const item = input.closest('.plan-item');
    item?.classList.remove('is-selected'); 
      const labelEl = item?.querySelector<HTMLElement>('.plan-label');
      if (labelEl && labelEl.dataset.baseLabel) labelEl.textContent = labelEl.dataset.baseLabel;
      const subtotalEl = item?.querySelector<HTMLElement>('[data-qty-subtotal]');
      if (subtotalEl) subtotalEl.textContent = '';
      return;
    }
    const item = input.closest('.plan-item');
    const labelEl = item?.querySelector<HTMLElement>('.plan-label');
    if (labelEl && !labelEl.dataset.baseLabel) {
      labelEl.dataset.baseLabel = labelEl.textContent?.trim() ?? '';
    }
    const baseLabel = labelEl?.dataset.baseLabel ?? '';
    const serviceLabel = input.closest('.q-block')?.querySelector('.q-title')?.textContent?.trim() ?? '';
    const subtotal = unitPrice * qty;          // 小計 = 単価 × 台数

    // --- カード側の表示を更新（明細だけでなく選択肢カードにも台数を映す）---
    item?.classList.add('is-selected');
    if (labelEl) labelEl.textContent = `${baseLabel}（${qty}台）`;
    const subtotalEl = item?.querySelector<HTMLElement>('[data-qty-subtotal]');
    if (subtotalEl) subtotalEl.textContent = `小計 ${subtotal.toLocaleString('ja-JP')}円`;

    state.set(planId, {
      planId,
      serviceKey,
      serviceLabel,
      planLabel: `${baseLabel} ${qty}台`,
      price: subtotal,
    });
  }

  // 結果表示を更新
  function updateResult() {
    const itemsEl = document.getElementById('resultItems');
    const totalNumEl = document.getElementById('totalNum');
    // 合計とCTAをまとめた入れ物。SPではこの塊ごと固定するので、表示/非表示もまとめて切り替える
    const summaryEl = document.getElementById('resultSummary');
    if (!itemsEl || !totalNumEl || !summaryEl) return;

    const items = Array.from(state.values());

    if (items.length === 0) {
      itemsEl.innerHTML = '<p class="result-empty">サービスを選択してください</p>';
      summaryEl.setAttribute('hidden', '');
      return;
    }

    // 内訳のHTML生成
    itemsEl.innerHTML = items.map(item => `
      <div class="result-item">
        <span class="result-item-service">${escapeHtml(item.serviceLabel)}</span>
        <div class="result-item-row">
          <span class="result-item-plan">${escapeHtml(item.planLabel)}</span>
          <span class="result-item-price">${item.price.toLocaleString('ja-JP')}円</span>
        </div>
      </div>
    `).join('');

    // 合計
    const total = items.reduce((sum, i) => sum + i.price, 0);
   totalNumEl.textContent = total.toLocaleString('ja-JP');
   summaryEl.removeAttribute('hidden');
  }

  // HTMLエスケープ(XSS対策・プラン名にHTML特殊文字が混じった場合の保険)
  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // URLクエリパラメータでの初期選択
  // 例:/estimate/?service=estate
  const params = new URLSearchParams(window.location.search);
  const initService = params.get('service');
  if (initService) {
    const check = document.querySelector<HTMLInputElement>(`[data-service-check="${initService}"]`);
    if (check) {
      check.checked = true;
      check.dispatchEvent(new Event('change', { bubbles: true }));
      
      check.closest('.q-block')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  
  // ── SP: 「この内容で問い合わせる」→ 確認モーダル ──
  const estimateModal = document.querySelector<HTMLElement>('[data-estimate-modal]');
  // いまSP幅かどうかを判定（CSSのブレークポイントと同じ768pxに揃える）
  const isSP = () => window.matchMedia('(max-width:768px)').matches;
  
  // モーダル本文に、パネルの注意書きリストを複製して入れる（文言を2か所で管理しないため）
  const panelNoticeList = document.querySelector('.result-card .sim-notice-list');
  const modalBody = estimateModal?.querySelector('.estimate-modal-body');
  if (panelNoticeList && modalBody) {
    modalBody.innerHTML = `<ul class="sim-notice-list">${panelNoticeList.innerHTML}</ul>`;
  }
  
  // アロー関数で書くのは、estimateModal の null 絞り込みを効かせて ts(18047) を避けるため（資料11章17番）
  const openEstimateModal = () => {
    estimateModal?.classList.add('is-open');
    estimateModal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';   // 背景のスクロールを止める
  };
  const closeEstimateModal = () => {
    estimateModal?.classList.remove('is-open');
    estimateModal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };
  
  if (estimateModal) {
    // × ボタン、または背景（パネルの外側）クリックで閉じる
    estimateModal.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === estimateModal || target.closest('[data-estimate-modal-close]')) {
        closeEstimateModal();
      }
    });
    // Escキーで閉じる
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && estimateModal.classList.contains('is-open')) {
        closeEstimateModal();
      }
    });
  }
  
  const ctaPrimary = document.querySelector('#resultCta .cta-primary');
  
  if (ctaPrimary) {
    ctaPrimary.addEventListener('click', (e) => {
     
      const items = Array.from(state.values());
  
      
      if (items.length === 0) return;
  
      // 合計（税込）を計算
      const total = items.reduce((sum, i) => sum + i.price, 0);
  
      
      const lines = items.map(
        (i) => `・${i.serviceLabel}（${i.planLabel}）：${i.price.toLocaleString('ja-JP')}円`
      );
      const text =
        '【概算お見積り】\n' +
        lines.join('\n') + '\n' +
        `合計（税込）：${total.toLocaleString('ja-JP')}円〜\n` +
        '※本シミュレーションの概算です。';
  
      
      const payload = {
        text,
        total,
        items: items.map((i) => ({  
          serviceKey: i.serviceKey,
          serviceLabel: i.serviceLabel,
          planLabel: i.planLabel,
          price: i.price,
        })),
      };
  
      sessionStorage.setItem('estimateData', JSON.stringify(payload));

      // SPのときだけ、直接遷移せず確認モーダルを開く（PC/TBはそのまま /contact/ へ遷移）
      if (isSP()) {
        e.preventDefault();
        openEstimateModal();
      }
    });
  }

  // フェードイン
  const obs = new IntersectionObserver(e => {
    e.forEach(x => { if(x.isIntersecting){ x.target.classList.add('fade-in'); obs.unobserve(x.target); }});
  }, { threshold: 0.1 });
  document.querySelectorAll('.fi').forEach(el => { el.classList.add('fade-init'); obs.observe(el); });
</script>
