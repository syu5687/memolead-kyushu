---
---
<header class="hd" id="hd">
  <div class="hd-top">
    <span>受付時間 9:00〜18:00（年中無休）</span>
    <a href="tel:0120XXXXXX" class="hd-tel">0120-XXX-XXX</a>
  </div>
  <div class="hd-main">
    <a href="/" class="logo">
      <span class="logo-en">Angel Center</span>
      <span class="logo-ja">ぶっこうどう</span>
    </a>
    <nav class="pc-nav">
      <a href="#services">サービス</a>
      <a href="#estimate">仮見積り</a>
      <a href="#blog">ブログ</a>
      <a href="#voices">お客様の声</a>
      <a href="#flow">ご相談の流れ</a>
      <a href="#contact">お問合せ</a>
    </nav>
    <a href="#contact" class="btn-cta">無料相談はこちら</a>
    <button class="hamburger" id="hamburger" aria-label="メニュー">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="drawer" id="drawer">
  <button class="drawer-close" id="drawerClose">✕</button>
  <nav class="drawer-nav">
    <a href="#services">サービス</a>
    <a href="#estimate">仮見積り</a>
    <a href="#blog">ブログ</a>
    <a href="#voices">お客様の声</a>
    <a href="#flow">ご相談の流れ</a>
    <a href="#contact">お問合せ</a>
  </nav>
  <a href="#contact" class="drawer-cta">無料相談はこちら</a>
</div>
<div class="overlay-bg" id="overlayBg"></div>

<style>
.hd{background:var(--white);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:200;box-shadow:0 1px 12px rgba(0,0,0,.05)}
.hd-top{background:var(--gd);color:rgba(255,255,255,.85);display:flex;justify-content:flex-end;align-items:center;gap:1.5rem;padding:.32rem 1.5rem;font-size:11px}
.hd-tel{font-family:var(--roman);font-size:1.1rem;color:#fff}
.hd-main{display:flex;align-items:center;padding:.65rem 1.5rem;gap:1.25rem}
.logo{display:flex;flex-direction:column;margin-right:auto;line-height:1.25}
.logo-en{font-family:var(--roman);font-size:.62rem;letter-spacing:.16em;color:var(--gd);font-style:italic}
.logo-ja{font-family:var(--serif);font-size:1.1rem;letter-spacing:.13em;color:var(--gd)}
.pc-nav{display:flex;gap:1.25rem;font-size:.76rem;color:var(--mid)}
.pc-nav a:hover{color:var(--gd)}
.btn-cta{background:var(--gd);color:#fff;padding:.5rem 1.2rem;font-size:.73rem;letter-spacing:.08em;white-space:nowrap;transition:.2s;flex-shrink:0}
.btn-cta:hover{background:var(--gm)}
.hamburger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px}
.hamburger span{display:block;width:22px;height:2px;background:var(--gd);transition:.3s}
.drawer{position:fixed;top:0;right:-100%;width:260px;height:100vh;background:var(--white);z-index:300;padding:3.5rem 1.75rem 2rem;transition:right .3s;box-shadow:-4px 0 24px rgba(0,0,0,.12)}
.drawer.open{right:0}
.drawer-close{position:absolute;top:.85rem;right:1.2rem;background:none;border:none;font-size:1.3rem;cursor:pointer;color:var(--mid)}
.drawer-nav{display:flex;flex-direction:column}
.drawer-nav a{display:block;padding:.7rem 0;border-bottom:1px solid #f0f0ea;font-size:.9rem;color:var(--mid)}
.drawer-nav a:hover{color:var(--gd)}
.drawer-cta{display:block;background:var(--gd);color:#fff;text-align:center;padding:.75rem;font-size:.82rem;margin-top:1.25rem}
.overlay-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:250}
.overlay-bg.open{display:block}
@media(max-width:768px){
  .pc-nav,.btn-cta{display:none}
  .hamburger{display:flex}
  .hd-main{padding:.6rem 1rem}
}
@media(max-width:480px){.hd-top .hd-tel{display:none}}
</style>

<script>
const ham=document.getElementById('hamburger'),drawer=document.getElementById('drawer'),bg=document.getElementById('overlayBg'),closeBtn=document.getElementById('drawerClose');
const open=()=>{drawer?.classList.add('open');bg?.classList.add('open')};
const close=()=>{drawer?.classList.remove('open');bg?.classList.remove('open')};
ham?.addEventListener('click',open);
closeBtn?.addEventListener('click',close);
bg?.addEventListener('click',close);
drawer?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));
</script>
