---
// 葬儀後サービス向けSVGアイコンセット
// 使い方: <Icon name="phone" size={20} />
// stroke は currentColor で親のcolorに追従
interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}
const { name, size = 24, strokeWidth = 1.5, class: className = '' } = Astro.props;

// 各アイコンのpath定義
// 葬儀後サービスで使うアイコンセット
const icons: Record<string, string> = {
  // 電話 ─ お問合せ・CTA用
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',

  // メール ─ Web相談用
  mail: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',

  // ホーム ─ トップ・家屋用
  home: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',

  // 書類・チェックリスト ─ 証明書・パッケージ用
  document: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="14" x2="15" y2="14"/><line x1="9" y1="18" x2="13" y2="18"/>',

  // 箱・パッケージ ─ 不用品・梱包用
  package: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>',

  // 合掌・祈り ─ 供養用
  prayer: '<path d="M12 2c-1 4-1 7 0 11"/><path d="M12 2c1 4 1 7 0 11"/><path d="M8 13c-2 2-3 5-3 8h14c0-3-1-6-3-8"/><line x1="12" y1="13" x2="12" y2="21"/>',

  // 蓮の花 ─ 供養・葬儀のシンボル
  lotus: '<path d="M12 4c-1.5 2-2 4-2 6 0 1 .5 2 2 2s2-1 2-2c0-2-.5-4-2-6z"/><path d="M12 12c-3-1.5-5-1.5-7-1 .5 2 2 4 4 5 1.5.5 2.5 0 3-2"/><path d="M12 12c3-1.5 5-1.5 7-1-.5 2-2 4-4 5-1.5.5-2.5 0-3-2"/><path d="M12 12c-2 1-3 2.5-4 5 1.5 1 3 1.5 4 1.5s2.5-.5 4-1.5c-1-2.5-2-4-4-5z"/>',

  // 仏壇・神棚 ─ 屋根型(伝統建築のシルエット)
  altar: '<path d="M3 10l9-7 9 7"/><path d="M5 10v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V10"/><line x1="9" y1="21" x2="9" y2="14"/><line x1="15" y1="21" x2="15" y2="14"/><path d="M9 14h6"/>',

  // タグ・値札 ─ 料金・価格用
  tag: '<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>',

  // バッグ・荷物 ─ 衣類・着物用
  bag: '<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>',

  // 人形 ─ 人形供養用(シルエット)
  doll: '<circle cx="12" cy="6" r="3"/><path d="M8 21v-2a4 4 0 0 1 4-4 4 4 0 0 1 4 4v2"/><line x1="10" y1="13" x2="6" y2="17"/><line x1="14" y1="13" x2="18" y2="17"/>',

  // 家具(椅子・タンス) ─ 家具回収用
  furniture: '<rect x="5" y="3" width="14" height="18" rx="1"/><line x1="5" y1="9" x2="19" y2="9"/><line x1="5" y1="15" x2="19" y2="15"/><circle cx="9" cy="6" r=".5" fill="currentColor"/><circle cx="9" cy="12" r=".5" fill="currentColor"/><circle cx="9" cy="18" r=".5" fill="currentColor"/>',

  // 写真 ─ 写真・思い出の品用
  photo: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>',

  // 建物・都市 ─ エリア・店舗用
  building: '<path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><line x1="9" y1="9" x2="9" y2="9.01"/><line x1="9" y1="13" x2="9" y2="13.01"/><line x1="9" y1="17" x2="9" y2="17.01"/>',

  // 駐車場(P) ─ 駐車場アイコン
  parking: '<rect x="3" y="3" width="18" height="18" rx="1"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/>',

  // 葉・自然 ─ 唐木仏壇・木材用
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19.2 2.96a1 1 0 0 1 1.8.4c1 4 1 8-1 12.5C18.3 19 14.5 21 11 20z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/>',

  // 木 ─ 唐木仏壇用(より仏壇に合うシルエット)
  tree: '<path d="M12 22V8"/><path d="M12 8c-3-2-5-5-5-7 3 0 5 2 5 5"/><path d="M12 8c3-2 5-5 5-7-3 0-5 2-5 5"/><path d="M12 14c-2-2-4-3-7-3 1 3 3 5 7 5"/><path d="M12 14c2-2 4-3 7-3-1 3-3 5-7 5"/>',

  // 箱・現代的フォルム ─ 近代仏壇用
  box: '<rect x="4" y="6" width="16" height="14" rx="1"/><line x1="4" y1="10" x2="20" y2="10"/><line x1="12" y1="6" x2="12" y2="20"/><line x1="8" y1="3" x2="16" y2="3"/>',

  // 矢印 ─ 右矢印(リンク表示用)
  arrow_right: '<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>',

  // チェック ─ 確認・完了用
  check: '<polyline points="20 6 9 17 4 12"/>',

  // メニュー ─ ハンバーガーメニュー
  menu: '<line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>',
};

const iconPath = icons[name] || '';
---
{iconPath && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
    set:html={iconPath}
  />
)}
