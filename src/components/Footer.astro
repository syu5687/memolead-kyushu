---
// 各リンクの定義
// available: true なら通常リンク / false なら「準備中」のグレーアウト表示
// 新しいページを公開したら、該当行の available を true に変更するだけでOK
const services = [
  { href: '/services/estate/',         label: '遺品整理',           available: true },
  { href: '/services/junk/',           label: '不用品回収',         available: true  },
  { href: '/services/antique/',        label: '古物買取(4月〜)',   available: false },
  { href: '/services/butsudan/',       label: '仏壇・仏具販売',     available: true  },
  { href: '/services/cemetery/',       label: '墓地・霊園紹介',     available: false },
];

const moreServices = [
  { href: '/services/altar-remake/',   label: '仏壇リメイク',       available: false },
  { href: '/services/grave-closure/',  label: '墓じまい',           available: false },
  { href: '/services/grave-keeping/',  label: '墓守代行',           available: false },
  { href: '/services/ocean/',          label: '海洋散骨',           available: false },
  { href: '/services/memento/',        label: '手元供養品販売',     available: false },
];

const company = [
  { href: '/about/',                   label: '会社概要',           available: false },
  { href: '/staff/',                   label: 'スタッフ紹介',       available: false },
  { href: '/blog/',                    label: 'ブログ',             available: false },
  { href: '/voices/',                  label: 'お客様の声',         available: false },
  { href: '/contact/',                 label: 'お問合せ',           available: false },
];
---
<footer class="footer">
  <div class="footer-inner">
    <div class="f-brand">
      <p class="f-logo-en">Angel Center</p>
      <p class="f-logo-ja">ぶっこうどう</p>
      <p class="f-tag">葬儀後の供養事をトータルでサポートする<br>専門の窓口サービスです。</p>
      <address class="f-addr">
        〒XXX-XXXX ○○県○○市○○町X-X-X<br>
        TEL: <a href="tel:0120XXXXXX">0120-XXX-XXX</a><br>
        受付時間 9:00〜18:00(年中無休)
      </address>
    </div>
    <div class="f-links">
      <div class="f-col">
        <h3>SERVICES</h3>
        {services.map(s => s.available
          ? <a href={s.href}>{s.label}</a>
          : <span class="f-disabled">{s.label}<em>準備中</em></span>
        )}
      </div>
      <div class="f-col">
        <h3>MORE SERVICES</h3>
        {moreServices.map(s => s.available
          ? <a href={s.href}>{s.label}</a>
          : <span class="f-disabled">{s.label}<em>準備中</em></span>
        )}
      </div>
      <div class="f-col">
        <h3>COMPANY</h3>
        {company.map(s => s.available
          ? <a href={s.href}>{s.label}</a>
          : <span class="f-disabled">{s.label}<em>準備中</em></span>
        )}
      </div>
    </div>
  </div>
  <div class="f-btm">© 2026 エンジェルセンター ぶっこうどう All Rights Reserved.</div>
</footer>

<style>
.footer{background:var(--gd);color:rgba(255,255,255,.82);padding:4rem 1.5rem 1.5rem}
.footer-inner{display:grid;grid-template-columns:1fr 2fr;gap:3.5rem;max-width:1100px;margin:0 auto 2.75rem}
.f-logo-en{font-family:var(--roman);font-size:.78rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.55)}
.f-logo-ja{font-family:var(--serif);font-size:1.25rem;letter-spacing:.13em;color:#fff;margin-bottom:.95rem}
.f-tag{font-size:.875rem;line-height:1.95;color:rgba(255,255,255,.62);margin-bottom:1.15rem}
.f-addr{font-style:normal;font-size:.875rem;line-height:2.1;color:rgba(255,255,255,.52)}
.f-addr a{color:rgba(255,255,255,.65)}
.f-links{display:grid;grid-template-columns:repeat(3,1fr);gap:1.75rem}
.f-col h3{font-family:var(--roman);font-size:.78rem;letter-spacing:.2em;color:rgba(255,255,255,.42);margin-bottom:.85rem;padding-bottom:.42rem;border-bottom:1px solid rgba(255,255,255,.12)}
.f-col a{display:block;font-size:.875rem;color:rgba(255,255,255,.65);padding:.35rem 0;transition:.15s}
.f-col a:hover{color:#fff}

/* 準備中(未公開ページ)のスタイル
   グレーアウト + クリック不可 + 「準備中」バッジ表示
   ページ公開後は available: true に変更すれば通常リンクに戻る */
.f-col .f-disabled{
  display:flex;align-items:center;gap:.5rem;
  font-size:.875rem;color:rgba(255,255,255,.32);
  padding:.35rem 0;cursor:not-allowed;
}
.f-col .f-disabled em{
  font-style:normal;font-size:.72rem;
  background:rgba(255,255,255,.08);
  color:rgba(255,255,255,.5);
  padding:.12rem .5rem;
  letter-spacing:.05em;
  border-radius:1px;
}

.f-btm{border-top:1px solid rgba(255,255,255,.12);text-align:center;padding-top:1.25rem;font-size:.875rem;color:rgba(255,255,255,.45);max-width:1100px;margin:0 auto}
@media(max-width:1024px){.footer-inner{grid-template-columns:1fr}}
@media(max-width:768px){
  .footer{padding:3rem 1rem 1.25rem}
  .footer-inner{gap:2.25rem;margin-bottom:2rem}
  .f-links{grid-template-columns:1fr 1fr;gap:1.5rem}
  .f-col:last-child{grid-column:span 2}
}
@media(max-width:480px){
  .f-links{grid-template-columns:1fr}
  .f-col:last-child{grid-column:auto}
}
</style>
