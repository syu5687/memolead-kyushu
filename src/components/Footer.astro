---
import {SITE, ESTATE_PERMITS } from '../data/site.ts';
// true→通常リンク / false→準備中のグレーアウト表示
const services = [
  { href: '/services/estate/',         label: '遺品整理・不用品回収',           available: true },
  { href: '/services/antique/',        label: '古物買取',   available: true },
  { href: '/services/butsudan/',       label: '仏壇・仏具販売',     available: true  },
  { href: '/services/cemetery/',       label: '墓地・霊園紹介',     available: true },
];

const moreServices = [
  { href: '/services/altar-closing/',  label: '仏壇（神棚）じまい', available: true },
  { href: '/services/altar-remake/',   label: '仏壇リメイク',       available: true },
  { href: '/services/grave-closure/',  label: '墓じまい',           available: true },
  { href: '/services/ocean/',          label: '海洋散骨',           available: true },
  { href: '/services/memento/',        label: '手元供養品販売',     available: true },
  { href: '/services/inheritance/',    label: '相続（不動産）相談', available: true },
  { href: '/blog/',                    label: 'ブログ',             available: true },
  { href: '/voices/',                  label: 'お客様の声',         available: true },
];

const company = [
  { href: '/about/',                   label: '会社概要',           available: true },
  { href: '/staff/',                   label: 'スタッフ紹介',       available: true },
  { href: '/contact/',                 label: 'お問合せ',           available: true },
];
---
<footer class="footer">
  <div class="footer-inner">
    <div class="f-brand">
      <p class="f-logo-en">{SITE.name.sub}</p>
      <p class="f-logo-ja">{SITE.name.main}</p>
      <p class="f-tag">葬儀後の供養事をトータルでサポートする<br>専門の窓口サービスです。</p>
      <!-- 遺品整理・不用品回収の許可番号（site.ts の ESTATE_PERMITS を参照＝estateページと一元管理） -->
      <div class="f-permits">
        
        {ESTATE_PERMITS.map(p => (
          <span class="f-permit-item">{p.permit}</span>
        ))}
      </div>
      <address class="f-addr" style="display:none;">
        〒850-0046<br>
        長崎県長崎市幸町4-13<br>
        TEL: <a href="tel:0958654400">095-865-4400</a><br>
        営業時間 10:00〜17:00（店休日無し）
      </address>
    </div>
    <div class="f-links">
      <div class="f-col">
        <h3>SERVICES</h3>
        {services.map(s => s.available
          ? <a href={s.href}>{s.label}</a>
          : <span class="f-disabled">{s.label}<em>準備中</em></span>
        )}
      </div>
      <div class="f-col">
        <h3>MORE SERVICES</h3>
        {moreServices.map(s => s.available
          ? <a href={s.href}>{s.label}</a>
          : <span class="f-disabled">{s.label}<em>準備中</em></span>
        )}
      </div>
      <div class="f-col">
        <h3>COMPANY</h3>
        {company.map(s => s.available
          ? <a href={s.href}>{s.label}</a>
          : <span class="f-disabled">{s.label}<em>準備中</em></span>
        )}
      </div>
    </div>
  </div>
  
  
  <div class="f-btm">&#169;{` 2026 ${SITE.fullName} All Rights Reserved.`}</div>
</footer>

<style>
.footer{background:var(--gd);color:rgba(255,255,255,.82);padding:4rem 1.5rem 1.5rem}
.footer-inner{display:grid;grid-template-columns:1fr 2fr;gap:3.5rem;max-width:1100px;margin:0 auto 2.75rem}
.f-logo-en{font-family:var(--roman);font-size:.78rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.55)}
.f-logo-ja{font-family:var(--serif);font-size:1.25rem;letter-spacing:.13em;color:#fff;margin-bottom:.95rem}
.f-tag{font-size:.875rem;line-height:1.95;color:rgba(255,255,255,.62);margin-bottom:1.15rem}
.f-addr{font-style:normal;font-size:.875rem;line-height:2.1;color:rgba(255,255,255,.52)}
.f-addr a{color:rgba(255,255,255,.65)}
.f-links{display:grid;grid-template-columns:repeat(3,1fr);gap:1.75rem}
.f-col h3{font-family:var(--roman);font-size:.78rem;letter-spacing:.2em;color:rgba(255,255,255,.42);margin-bottom:.85rem;padding-bottom:.42rem;border-bottom:1px solid rgba(255,255,255,.12)}
.f-col a{display:block;font-size:.875rem;color:rgba(255,255,255,.65);padding:.35rem 0;transition:.15s}
.f-col a:hover{color:#fff}

/* 準備中 */
.f-col .f-disabled{
  display:flex;align-items:center;gap:.5rem;
  font-size:.875rem;color:rgba(255,255,255,.32);
  padding:.35rem 0;cursor:not-allowed;
}
.f-col .f-disabled em{
  font-style:normal;font-size:.72rem;
  background:rgba(255,255,255,.08);
  color:rgba(255,255,255,.5);
  padding:.12rem .5rem;
  letter-spacing:.05em;
  border-radius:1px;
}

.f-btm{border-top:1px solid rgba(255,255,255,.12);text-align:center;padding-top:1.25rem;font-size:.875rem;color:rgba(255,255,255,.45);max-width:1100px;margin:0 auto}

.f-permits{
border-top:1px solid rgba(255,255,255,.45);
 padding:.5rem 0rem;margin:0 auto 1.25rem;
  display:flex;flex-direction:row;justify-content:flex-start;align-items:center;gap:.4rem .5rem;
  font-size:.72rem;color:rgba(255,255,255,.45);line-height:1.7;
}
.f-permit-item{white-space:nowrap}
.f-permit-item:not(:first-of-type){border-left:1px solid rgba(255,255,255,.45);padding-left:.5rem;}
@media(max-width:1024px){.footer-inner{grid-template-columns:1fr}}
@media(max-width:768px){
  .footer{padding:3rem 1rem 1.25rem}
  .footer-inner{gap:2.25rem;margin-bottom:2rem}
  .f-links{grid-template-columns:1fr 1fr;gap:1.5rem}
  .f-col:last-child{grid-column:span 2}
}
@media(max-width:480px){
  .f-links{grid-template-columns:1fr}
  .f-col:last-child{grid-column:auto}
}
</style>
