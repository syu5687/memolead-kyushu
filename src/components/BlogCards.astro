---
import { Image } from 'astro:assets';
import { posts } from '../data/posts';

// すべての画像をimport(Astroの静的解析のため、動的importできない)
import imgOcean from '../_assets/img/blog/blog-ocean-sky.jpg';
import imgEstate from '../_assets/img/blog/blog-estate-water.jpg';
import imgGrave from '../_assets/img/blog/blog-grave-leaves.jpg';

// 画像ファイル名と実際のimportを紐づけ
const imageMap: Record<string, ImageMetadata> = {
  'blog-ocean-sky.jpg': imgOcean,
  'blog-estate-water.jpg': imgEstate,
  'blog-grave-leaves.jpg': imgGrave,
};

// 最新3件を取得(現状は3件しかないが、将来増えても対応)
const latestPosts = posts.slice(0, 3);
---

<div class="blog-cards">
  {latestPosts.map(post => (
    <a href={`/blog/${post.slug}/`} class="blog-card">
      <div class="blog-img">
        <Image
          src={imageMap[post.image]}
          alt={post.imageAlt}
          widths={[400, 600, 800]}
          sizes="(max-width:768px) 100vw, 33vw"
          loading="lazy"
        />
      </div>
      <div class="blog-body">
        <span class="blog-tag">{post.category}</span>
        <p class="blog-date">{post.date}</p>
        <h3 class="blog-title">{post.title}</h3>
      </div>
    </a>
  ))}
</div>

<style>
.blog-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1.35rem}
.blog-card{background:var(--white);border:1px solid var(--border);border-radius:var(--corner);overflow:hidden;display:flex;flex-direction:column;transition:.2s}
.blog-card:hover{border-color:var(--gd);transform:translateY(-2px)}
.blog-img{width:100%;aspect-ratio:4/3;overflow:hidden;background:var(--gl)}
.blog-img :global(img){width:100%;height:100%;object-fit:cover;display:block}
.blog-body{padding:1.1rem 1.3rem 1.35rem;flex:1;display:flex;flex-direction:column}
.blog-tag{display:inline-block;align-self:flex-start;border:1px solid var(--gd);color:var(--gd);font-size:.72rem;padding:.2rem .6rem;margin-bottom:.5rem;border-radius:var(--corner);letter-spacing:0}
.blog-date{font-size:.78rem;color:var(--light);margin-bottom:.4rem;font-family:var(--roman);letter-spacing:0}
.blog-title{font-family:var(--serif);font-size:.95rem;line-height:1.75;font-weight:400;color:var(--text)}
@media(max-width:768px){.blog-cards{grid-template-columns:1fr;gap:1rem}}
</style>
